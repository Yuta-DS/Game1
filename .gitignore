artea/addons/terrain_3d/bin/~libterrain.windows.debug.x86_64.dll

# Operating-system and editor files
.DS_Store
._*
__MACOSX/
*~
~*
*.tmp
*.log
*.old
*.old.*

# Godot-generated caches and local editor state
.godot/
.dual/
*.import

# Generated builds, captures, and downloaded reference packages
artea/builds/
artea/artifacts/
ViewFinder-main/
ViewFinder-main.zip
Gemini_Generated_Image_*.png
*.translation

# Python and local server state
__pycache__/
*.pyc
server/venv/
server/database.db
server/uploads/
server/logs/
server/ai_cache/
server/.env
API-Key.txt

# Web export output (regenerable)
build/

# Cloudflare Wrangler local state
.wrangler/

# Blender autosave backups
*.blend1

# GLB colour-edit backups, regenerable via tools/recolour_tree_fibers.py --restore
*.precolour

# Textures Godot extracts out of embedded glTF images (gltf/embedded_image_handling=1).
# Regenerated on import from the .glb, which is the tracked source. Their .import
# sidecars are already covered by the *.import rule above.
artea/meshy ai/*_texture_Image_*.jpg

# Godot also extracts these from the original (non-Blender) GLB naming.
artea/meshy ai/*_texture_[0-9].jpg

# Textures Godot extracts from GLBs that embed their own images
# (gltf/embedded_image_handling=1). Regenerated on import from the .glb,
# which is the tracked source. Listed explicitly rather than by wildcard:
# crown_line_runtime_textured_* and a few others sit in the same folders but
# are real external dependencies and must stay tracked.
