# Detailed castle-only treatment for the imported Art Castle.
#
# The original mesh owns gameplay collision, the gallery doorway and the exact
# silhouette from the supplied screenshot. This layer changes only appearance:
# it dresses the castle in a Sleeping Beauty palette (rose masonry, cobalt
# roofs, gold finials and stained glass), removes unrelated astral machinery,
# and adds grounded castle detail around the authored player route.
extends Node3D

# The village atlas with the castle's grey masonry turned rose and its red roofs
# turned blue (tools/recolor_castle_atlas.gd). Only the castle uses it; the
# village houses keep the original.
const VILLAGE_ATLAS_PATH := "res://assets3D/houses/red/hexagons_castle.png"
const ROSE_ATLAS := preload("res://assets3D/houses/red/hexagons_castle_rose.png")
const STAINED_GLASS := preload("res://shaders/stained_glass.gdshader")
# The imported castle's 23 arched windows: the centre of each recess's back
# wall relative to the castle's origin, and the way it faces. Read off the
# model (the faces textured with the atlas's dark window swatch), since the
# texture itself is not readable at runtime once the Web export re-encodes it.
const CASTLE_WINDOW_SIZE := Vector2(0.74, 1.66)
const CASTLE_WINDOWS := [
	[Vector3(2.04, 22.31, -3.54), Vector3(0.500, 0.0, -0.866)],
	[Vector3(1.97, 28.64, 3.41), Vector3(0.500, 0.0, 0.866)],
	[Vector3(-1.97, 28.64, -3.41), Vector3(-0.500, 0.0, -0.866)],
	[Vector3(1.97, 28.64, -3.41), Vector3(0.500, 0.0, -0.866)],
	[Vector3(-1.97, 28.64, 3.41), Vector3(-0.500, 0.0, 0.866)],
	[Vector3(-3.94, 28.64, 0.00), Vector3(-1.000, 0.0, 0.000)],
	[Vector3(3.94, 28.64, 0.00), Vector3(1.000, 0.0, 0.000)],
	[Vector3(2.04, 22.31, 3.54), Vector3(0.500, 0.0, 0.866)],
	[Vector3(-2.04, 22.31, -3.54), Vector3(-0.500, 0.0, -0.866)],
	[Vector3(-2.04, 22.31, 3.54), Vector3(-0.500, 0.0, 0.866)],
	[Vector3(3.82, 6.31, -9.30), Vector3(0.000, 0.0, -1.000)],
	[Vector3(6.15, 6.31, -7.95), Vector3(0.866, 0.0, -0.500)],
	[Vector3(-3.81, 6.31, 9.32), Vector3(0.000, 0.0, 1.000)],
	[Vector3(-3.81, 10.31, -9.32), Vector3(0.000, 0.0, -1.000)],
	[Vector3(3.82, 10.31, 9.32), Vector3(0.000, 0.0, 1.000)],
	[Vector3(-9.51, 4.31, -2.04), Vector3(-0.866, 0.0, -0.500)],
	[Vector3(-9.51, 9.31, -2.04), Vector3(-0.866, 0.0, -0.500)],
	[Vector3(-9.51, 4.31, 2.04), Vector3(-0.866, 0.0, 0.500)],
	[Vector3(-9.51, 9.31, 2.04), Vector3(-0.866, 0.0, 0.500)],
	[Vector3(5.97, 13.91, -2.69), Vector3(0.000, 0.0, -1.000)],
	[Vector3(8.30, 13.91, 1.35), Vector3(0.866, 0.0, 0.500)],
	[Vector3(-8.30, 18.31, -1.35), Vector3(-0.866, 0.0, -0.500)],
	[Vector3(-8.30, 18.31, 1.34), Vector3(-0.866, 0.0, 0.500)],
]

const CASTLE_NAME := "building_castle_red2"
var _stone: StandardMaterial3D
var _stone_light: StandardMaterial3D
var _stone_course: StandardMaterial3D
var _slate: StandardMaterial3D
var _timber: StandardMaterial3D
var _timber_light: StandardMaterial3D
var _timber_dark: StandardMaterial3D
var _iron: StandardMaterial3D
var _gold: StandardMaterial3D

const CASTLE_DOOR_WORLD := Vector3(-39.8, 78.33, 27.41)
const BRIDGE_START_WORLD := Vector3(-7.4, 67.73, 27.41)
const BRIDGE_END_WORLD := Vector3(-19.3, 67.73, 27.41)


func _ready() -> void:
	# The castle, stairs and entrance are generated by sibling runtime builders.
	# Let them finish before replacing their technology-only presentation.
	for _frame in 8:
		await get_tree().process_frame
	await get_tree().physics_frame

	var castle := get_parent().get_node_or_null(CASTLE_NAME) as Node3D
	if castle == null:
		push_warning("Castle Castle: imported castle not found")
		return

	_create_materials()
	_apply_simple_village_palette(castle)
	_remove_reference_technology()
	_restyle_castle_approach()
	_build_castle_architecture(castle)
	_glaze_stair_tower()
	_glaze_castle_windows(castle)
	_position_castle_commander()
	_gild_cone_roofs()


func _create_materials() -> void:
	# Sleeping Beauty palette for everything built around the castle: the front,
	# stairs, bridges and gatehouse share these with the castle body, so the
	# whole approach matches the rose atlas (tools/recolor_castle_atlas.gd).
	# Rose walls, warm ivory walkways and treads (warm enough to stay ivory under
	# the blue sky light on wide decks), and a deeper rose for courses and
	# buttresses, keeping the old light/mid/dark stone hierarchy.
	_stone = _material(Color.from_hsv(350.0 / 360.0, 0.29, 0.79), 0.9)
	_stone_light = _material(Color("e3b8a2"), 0.9)
	_stone_course = _material(Color.from_hsv(348.0 / 360.0, 0.33, 0.66), 0.91)
	# Cobalt, like Sleeping Beauty Castle's spires, matching the recoloured atlas.
	_slate = _material(Color("3f6fc6"), 0.82)
	_timber = _material(Color("7f4628"), 0.91)
	_timber_light = _material(Color("a96032"), 0.90)
	_timber_dark = _material(Color("4d2d20"), 0.94)
	_iron = _material(Color("526671"), 0.82, 0.18)
	_gold = _material(Color("e2b448"), 0.38, 0.65)
	_stone.set_meta("castle_role", "weathered_masonry")
	_stone.set_meta("original_palette_role", "sleeping_beauty_rose_masonry")
	_stone_light.set_meta("original_palette_role", "sleeping_beauty_ivory_walk")
	_slate.set_meta("original_palette_role", "sleeping_beauty_blue_roof")
	_gold.set_meta("castle_role", "gilded_finial")
	_timber.set_meta("castle_role", "oak_structure")
	_iron.set_meta("castle_role", "wrought_iron")
	for shared_material in [_stone, _stone_light, _stone_course, _slate, _timber,
			_timber_light, _timber_dark, _iron, _gold]:
		shared_material.set_meta("render_family", "red_village_hexagons_castle")


func _stained_glass(shape: int, size: Vector2, seed: int) -> ShaderMaterial:
	var glass := ShaderMaterial.new()
	glass.shader = STAINED_GLASS
	glass.set_shader_parameter("shape", shape)
	glass.set_shader_parameter("panel_size", size)
	glass.set_shader_parameter("seed", float(seed) * 17.0)
	glass.set_meta("castle_role", "stained_glass")
	return glass


func _material(colour: Color, roughness: float, metallic := 0.0) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = colour
	material.roughness = roughness
	material.metallic = metallic
	return material


func _apply_simple_village_palette(node: Node) -> void:
	for child in node.get_children():
		if child is MeshInstance3D:
			var mesh_node := child as MeshInstance3D
			if mesh_node.mesh != null:
				for surface in mesh_node.mesh.get_surface_count():
					var source := mesh_node.get_active_material(surface)
					if source is StandardMaterial3D:
						var standard := source as StandardMaterial3D
						if standard.albedo_texture != null:
							var simple := StandardMaterial3D.new()
							simple.albedo_texture = ROSE_ATLAS 								if standard.albedo_texture.resource_path == VILLAGE_ATLAS_PATH 								else standard.albedo_texture
							simple.albedo_color = Color.WHITE
							simple.roughness = 0.92
							simple.metallic = 0.0
							simple.emission_enabled = false
							simple.set_meta("castle_palette", "sleeping_beauty_rose_atlas")
							mesh_node.set_surface_override_material(surface, simple)
		_apply_simple_village_palette(child)


func _remove_reference_technology() -> void:
	var foundation := get_parent().get_node_or_null("CastleFoundation") as Node3D
	if foundation == null:
		push_warning("Castle Castle: castle foundation not ready")
		return

	for path in ["ReferenceAstralMachine", "HighAetherFacade",
			"AstralObservatoryCrown", "AetherCalibrationBand"]:
		var technology := foundation.get_node_or_null(path) as Node3D
		if technology != null:
			_remove_piece(technology)

	# This round gallery plinth is the broad grey ring visible under the front
	# door in the supplied screenshot. The gate and real ramp no longer need it.
	var gallery_ring := foundation.get_node_or_null("GalleryFoundationPlaza") \
		as MeshInstance3D
	if gallery_ring != null:
		_remove_piece(gallery_ring)


func _restyle_castle_approach() -> void:
	for path in ["CastleStairs/CastleStair", "CastleEntrance/CastleEntrance"]:
		var approach := get_parent().get_node_or_null(path) as Node3D
		if approach != null:
			_restyle_approach_tree(approach)


func _restyle_approach_tree(node: Node) -> void:
	# Authored organic dressing already carries its low-poly bark/leaf palette.
	# Repainting this subtree as generic castle stone turns fibres into blue trim.
	if node.name == "LowPolyStairGrowth":
		return
	for child in node.get_children():
		var child_name := String(child.name).to_lower()
		# The simplified castle deliberately keeps this one warm, non-technical
		# light source. Do not recurse into it and hide its emissive fire or lamp.
		if child is Node3D and (child_name == "castlecourtyardfire"
				or child_name.begins_with("castlestairtorch")):
			continue
		if child is Node3D and _name_has_any(child_name,
				["resonanceframe", "aetherlensgate", "aethergear"]):
			_remove_piece(child)
			continue
		if child is MeshInstance3D:
			var mesh := child as MeshInstance3D
			var lower_name := child_name
			var material := mesh.material_override
			var emitted := material is ShaderMaterial \
					or (material is StandardMaterial3D \
					and (material as StandardMaterial3D).emission_enabled)
			var thin_technology_strip := false
			if mesh.mesh is BoxMesh:
				var box_size := (mesh.mesh as BoxMesh).size
				thin_technology_strip = box_size.y <= 0.12 \
					and (box_size.x <= 0.8 or box_size.z <= 0.8)
			if emitted or _name_has_any(lower_name, ["aetherlevitation", "conductor",
					"rune", "lens", "crystal", "orb", "inlay", "halo", "gear",
					"astrolabe", "tracery", "underbrace", "tensionrib", "tensioncollar",
					"aetherbridgekeel", "lumenbridgesurfaceplank", "safetypost",
					"safetyplinth", "terracelevitationring", "handrail", "castleascentramp",
					"castledoortread", "castledoornosing"]) or thin_technology_strip:
				if _remove_piece(mesh):
					continue
			elif "aetherwindowframe" in lower_name:
				mesh.material_override = _stone_light
			elif "aetherwindow" in lower_name:
				mesh.material_override = _iron
			elif _name_has_any(lower_name, ["stonecourse", "foundationbuttress",
					"buttresspier", "cornice", "masonryblock"]):
				mesh.material_override = _stone_course
			elif _name_has_any(lower_name, ["roof", "banner", "shield", "pennant"]):
				mesh.material_override = _slate
			elif _name_has_any(lower_name, ["guardcap", "continuouscap", "nosing",
					"handrail", "rail"]):
				# Roof red belongs on roofs and heraldry in the reference village,
				# not as a long racetrack stripe around the stair tower.
				mesh.material_override = _timber_dark
				mesh.set_meta("castle_palette_role", "dark_oak_stair_edge")
			elif _name_has_any(lower_name, ["plank", "door", "bench", "timber"]):
				mesh.material_override = _timber
			elif _name_has_any(lower_name, ["keel", "collar", "hinge", "bracket"]):
				mesh.material_override = _iron
			elif _name_has_any(lower_name, ["tread", "step", "paving", "court",
					"deck", "landing", "roadbed", "walksurface", "walksurface"]):
				mesh.material_override = _stone_light
			else:
				mesh.material_override = _stone
		elif child is OmniLight3D:
			# Remove the cyan/violet bulbs and lines around the approach. Castle
			# daylight and the existing village lighting remain unchanged.
			_remove_piece(child)
			continue
		_restyle_approach_tree(child)


# Every blue cone roof on the front, stairs and bridges gets the turret spires'
# gold tip. Small cones (buttress weatherings) are left plain; the turret spires
# already carry theirs.
func _gild_cone_roofs() -> void:
	var orb := SphereMesh.new()
	orb.radius = 0.14
	orb.height = 0.28
	for path in ["CastleArchitecture", "CastleStairs/CastleStair", "CastleEntrance/CastleEntrance"]:
		var root := get_parent().get_node_or_null(path)
		if root == null:
			continue
		for candidate in root.find_children("*", "MeshInstance3D", true, false):
			var roof := candidate as MeshInstance3D
			var cone := roof.mesh as CylinderMesh
			if roof.material_override != _slate or cone == null or cone.top_radius > 0.0 					or cone.height < 1.5 or String(roof.name).ends_with("TurretRoof"):
				continue
			var tip := Vector3.UP * (cone.height * 0.5)
			var spike := _add_mesh(roof, _cylinder(0.02, 0.08, 0.9, 6), _gold,
				tip + Vector3.UP * 0.4)
			spike.name = "GoldFinial"
			_add_mesh(roof, orb, _gold, tip + Vector3.UP * 0.04).name = "GoldFinialOrb"


# Removed pieces are freed, not just hidden, so they cost no memory or draw
# setup. A piece that still carries collision (an invisible ramp or tread the
# player walks on) is only hidden, so the route underfoot stays. Returns true
# when the piece was freed.
func _remove_piece(piece: Node3D) -> bool:
	if piece is CollisionObject3D 			or not piece.find_children("*", "CollisionObject3D", true, false).is_empty():
		piece.visible = false
		piece.set_meta("removed_for_castle_redesign", true)
		return false
	piece.queue_free()
	return true


func _name_has_any(value: String, fragments: Array[String]) -> bool:
	for fragment in fragments:
		if fragment in value:
			return true
	return false


# Knight2 is the active animated commander; the similarly named Knight node is
# an invisible legacy model. He stands on the raised doorway court, outside the
# 4.8 m central walking lane, so players can reach his dialogue without using
# an NPC body as a stair obstacle.
func _position_castle_commander() -> void:
	var commander := get_parent().get_node_or_null("Knight2") as Node3D
	if commander == null:
		push_warning("Castle Castle: animated commander not found")
		return
	commander.visible = true
	commander.global_position = CASTLE_DOOR_WORLD + Vector3(1.9, 0.18, 3.55)
	commander.rotation.y = -PI * 0.5
	commander.set_meta("castle_role", "upper_court_commander")
	commander.set_meta("route_policy", "outside_central_stair_lane")


func _build_castle_architecture(castle: Node3D) -> void:
	var architecture := Node3D.new()
	architecture.name = "CastleArchitecture"
	architecture.set_meta("reference", "user_supplied_castle_screenshot")
	architecture.set_meta("style", "shared_red_village_castle_kit")
	architecture.set_meta("render_family", "red_village_hexagons_castle")
	architecture.set_meta("collision_policy", "visual_only_preserve_imported_collision")
	get_parent().add_child(architecture)
	architecture.global_position = castle.global_position + Vector3(0.0, -4.2, 0.0)

	_build_turret_roofs(architecture)
	_build_gothic_keep_details(architecture)
	_build_castle_bridge(architecture)
	_build_bridge_barbican(architecture)
	_build_front_gatehouse(architecture)
	_build_full_castle_ascent(architecture)


# Every arched window in the castle gets a pane of stained glass, set into the
# recess just in front of its dark back wall.
func _glaze_castle_windows(castle: Node3D) -> void:
	var glazing := Node3D.new()
	glazing.name = "CastleWindowGlass"
	get_parent().add_child(glazing)
	for index in CASTLE_WINDOWS.size():
		var outward: Vector3 = CASTLE_WINDOWS[index][1]
		var glass := MeshInstance3D.new()
		glass.name = "StainedGlass_%02d" % index
		glass.mesh = QuadMesh.new()
		(glass.mesh as QuadMesh).size = CASTLE_WINDOW_SIZE
		var material := _stained_glass(0, CASTLE_WINDOW_SIZE, 20 + index)
		material.set_shader_parameter("round_head", true)
		material.set_shader_parameter("shoulder",
			CASTLE_WINDOW_SIZE.y - CASTLE_WINDOW_SIZE.x * 0.5)
		material.set_shader_parameter("quarry", 0.24)
		material.set_shader_parameter("lead_width", 0.02)
		glass.material_override = material
		glass.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		glazing.add_child(glass)
		glass.global_basis = Basis.looking_at(-outward, Vector3.UP)
		glass.global_position = castle.global_position + CASTLE_WINDOWS[index][0] 			+ outward * 0.03


# The spiral stair tower's core is glazed top to bottom in stained glass. The
# square aether panels that dotted it (and their ring frames) are gone; its
# stone rings stay, as tracery dividing the glass into tiers. The shaft keeps
# its own collision: only the look changes.
func _glaze_stair_tower() -> void:
	var stair := get_parent().get_node_or_null("CastleStairs/CastleStair") as Node3D
	if stair == null:
		return
	for part in stair.get_children():
		if part is Node3D and String(part.name).begins_with("AetherWindow"):
			_remove_piece(part)
	var shaft := stair.get_node_or_null("MasonryTower") as MeshInstance3D
	var mesh := shaft.mesh as CylinderMesh if shaft != null else null
	if mesh == null:
		return
	# Perimeter of the octagonal shaft at mid-height, split into a whole number
	# of quarries so the pattern closes seamlessly round the column.
	var sides := mesh.radial_segments
	var radius := (mesh.top_radius + mesh.bottom_radius) * 0.5
	var perimeter := float(sides) * 2.0 * radius * sin(PI / float(sides))
	var quarries := maxi(1, roundi(perimeter / 0.9))
	var glass := _stained_glass(2, Vector2(perimeter, mesh.height), 11)
	glass.set_shader_parameter("quarry", perimeter / float(quarries))
	glass.set_shader_parameter("wrap_cells", quarries)
	glass.set_shader_parameter("lead_width", 0.06)
	shaft.material_override = glass


func _build_turret_roofs(parent: Node3D) -> void:
	var roofs := [
		["NorthWestTurretRoof", Vector3(-6.2, 19.4, -6.4), 3.05, 4.4],
		["NorthEastTurretRoof", Vector3(-5.8, 20.3, 6.5), 2.75, 4.1],
		["SouthWestTurretRoof", Vector3(6.8, 17.4, -6.1), 2.65, 3.9],
		["SouthEastTurretRoof", Vector3(7.2, 18.2, 6.0), 2.85, 4.2],
	]
	for roof_spec in roofs:
		# Sleeping Beauty spires: narrower and half as tall again as the village
		# cones, raised so each still sits on its turret at the same eave height.
		var radius := float(roof_spec[2]) * 0.82
		var height := float(roof_spec[3]) * 1.55
		var centre := (roof_spec[1] as Vector3) \
			+ Vector3.UP * ((height - float(roof_spec[3])) * 0.5)
		var roof := _add_mesh(parent, _cone(radius, height, 12), _slate, centre)
		roof.name = roof_spec[0]
		var tip := centre + Vector3.UP * (height * 0.5)
		var finial := _add_mesh(parent, _cylinder(0.03, 0.12, 1.4, 8), _gold,
			tip + Vector3.UP * 0.55)
		finial.name = "%sFinial" % roof_spec[0]
		var orb := SphereMesh.new()
		orb.radius = 0.2
		orb.height = 0.4
		_add_mesh(parent, orb, _gold, tip + Vector3.UP * 0.05).name = "%sFinialOrb" % roof_spec[0]


func _build_gothic_keep_details(parent: Node3D) -> void:
	# Four tapered corner buttresses give the narrow imported tower a legible
	# castle load path while leaving its real doorway and collision untouched.
	var buttress_positions := [Vector3(-4.45, 0.0, -4.15),
		Vector3(4.45, 0.0, -4.15), Vector3(-4.45, 0.0, 4.15),
		Vector3(4.45, 0.0, 4.15)]
	for buttress_index in buttress_positions.size():
		var buttress := Node3D.new()
		buttress.name = "GothicButtress_%02d" % (buttress_index + 1)
		buttress.position = buttress_positions[buttress_index]
		parent.add_child(buttress)
		for tier_index in 3:
			var width := 1.34 - float(tier_index) * 0.24
			var height: float = [8.4, 7.2, 5.8][tier_index]
			var y: float = [10.8, 18.6, 25.1][tier_index]
			var pier := _add_mesh(buttress,
				_box(Vector3(width, height, width)), _stone, Vector3(0.0, y, 0.0))
			pier.name = "ButtressPier_%02d" % (tier_index + 1)
			var weathering := _add_mesh(buttress,
				_cone(width * 0.76, 0.72, 4), _slate,
				Vector3(0.0, y + height * 0.5 + 0.34, 0.0))
			weathering.name = "ButtressWeathering_%02d" % (tier_index + 1)

	# Pointed lancet frames sit proud of each face. They do not replace the
	# imported arched windows; they make those openings read as Gothic masonry
	# from the same low upward angle as the supplied screenshot.
	var faces := [
		[Vector3(0.0, 22.2, -4.76), Vector3.RIGHT],
		[Vector3(0.0, 22.2, 4.76), Vector3.RIGHT],
		[Vector3(-4.92, 22.2, 0.0), Vector3.FORWARD],
		[Vector3(4.92, 22.2, 0.0), Vector3.FORWARD],
	]
	for face_index in faces.size():
		var lancet := Node3D.new()
		lancet.name = "GothicLancet_%02d" % (face_index + 1)
		parent.add_child(lancet)
		var centre := faces[face_index][0] as Vector3
		var tangent := faces[face_index][1] as Vector3
		var left_base := centre - tangent * 1.32 + Vector3.DOWN * 2.7
		var right_base := centre + tangent * 1.32 + Vector3.DOWN * 2.7
		var left_shoulder := centre - tangent * 1.32 + Vector3.UP * 0.35
		var right_shoulder := centre + tangent * 1.32 + Vector3.UP * 0.35
		var apex := centre + Vector3.UP * 3.25
		for segment in [[left_base, left_shoulder], [right_base, right_shoulder],
				[left_shoulder, apex], [right_shoulder, apex]]:
			_add_beam_between(lancet, segment[0], segment[1], 0.30, _stone)
		# Stained glass fills the frame: same width, sill, springing line and
		# point as the beams above, set just behind them so they read as tracery.
		var outward := Vector3(centre.x, 0.0, centre.z).normalized()
		var size := Vector2(2.64, 5.95)
		var glass := MeshInstance3D.new()
		glass.name = "StainedGlass"
		glass.mesh = QuadMesh.new()
		(glass.mesh as QuadMesh).size = size
		glass.material_override = _stained_glass(0, size, face_index)
		glass.basis = Basis.looking_at(-outward, Vector3.UP)
		glass.position = left_base.lerp(right_base, 0.5) + Vector3.UP * (size.y * 0.5) \
			- outward * 0.1
		glass.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		lancet.add_child(glass)

	# A rose window on the keep's entrance face, the castle's hero view: the
	# plain wall between the lancet's point and the upper tower's ledge.
	var rose := Node3D.new()
	rose.name = "RoseWindow"
	parent.add_child(rose)
	var rose_centre := Vector3(4.24, 28.0, 0.0)
	var rose_radius := 1.45
	var rose_glass := MeshInstance3D.new()
	rose_glass.name = "StainedGlass"
	rose_glass.mesh = QuadMesh.new()
	(rose_glass.mesh as QuadMesh).size = Vector2.ONE * rose_radius * 2.0
	rose_glass.material_override = _stained_glass(1, Vector2.ONE * rose_radius * 2.0, 7)
	rose_glass.basis = Basis.looking_at(Vector3.LEFT, Vector3.UP)
	rose_glass.position = rose_centre
	rose_glass.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	rose.add_child(rose_glass)
	var surround := MeshInstance3D.new()
	surround.name = "RoseWindowSurround"
	surround.mesh = _torus(rose_radius - 0.04, rose_radius + 0.22)
	surround.material_override = _stone
	surround.basis = Basis(Vector3.FORWARD, PI * 0.5)
	surround.position = rose_centre + Vector3.RIGHT * 0.04
	rose.add_child(surround)


func _build_timber_hoarding(parent: Node3D, hoarding_name: String,
		y: float, footprint: Vector2) -> void:
	var hoarding := Node3D.new()
	hoarding.name = hoarding_name
	hoarding.position.y = y
	parent.add_child(hoarding)

	var half_x := footprint.x * 0.5
	var half_z := footprint.y * 0.5
	var rail_specs := [
		[Vector3(0.0, 0.0, -half_z), Vector3(footprint.x, 0.38, 0.38)],
		[Vector3(0.0, 0.0, half_z), Vector3(footprint.x, 0.38, 0.38)],
		[Vector3(-half_x, 0.0, 0.0), Vector3(0.38, 0.38, footprint.y)],
		[Vector3(half_x, 0.0, 0.0), Vector3(0.38, 0.38, footprint.y)],
	]
	for rail_index in rail_specs.size():
		var rail := _add_mesh(hoarding, _box(rail_specs[rail_index][1]), _timber,
			rail_specs[rail_index][0])
		rail.name = "HoardingRail_%02d" % (rail_index + 1)

	var corners := [Vector3(-half_x, 0.0, -half_z), Vector3(half_x, 0.0, -half_z),
		Vector3(-half_x, 0.0, half_z), Vector3(half_x, 0.0, half_z)]
	for corner_index in corners.size():
		var post := _add_mesh(hoarding, _box(Vector3(0.48, 3.2, 0.48)), _timber,
			corners[corner_index] + Vector3.UP * 0.9)
		post.name = "HoardingPost_%02d" % (corner_index + 1)
		var brace_target := Vector3(corners[corner_index].x * 0.68, -1.1,
			corners[corner_index].z * 0.68)
		var brace := _add_beam_between(hoarding,
			corners[corner_index] + Vector3.UP * 1.65, brace_target, 0.30, _timber)
		brace.name = "HoardingBrace_%02d" % (corner_index + 1)

	# A restrained crenellation rhythm makes each projecting tier read as a
	# defensive castle gallery without turning the silhouette into a new keep.
	for merlon_index in 12:
		var side := merlon_index / 3
		var along := float(merlon_index % 3 - 1) * 0.33
		var merlon_position: Vector3
		if side < 2:
			merlon_position = Vector3(along * footprint.x, 0.72,
				-half_z if side == 0 else half_z)
		else:
			merlon_position = Vector3(-half_x if side == 2 else half_x, 0.72,
				along * footprint.y)
		var merlon := _add_mesh(hoarding, _box(Vector3(0.72, 1.0, 0.62)), _stone,
			merlon_position)
		merlon.name = "HoardingMerlon_%02d" % (merlon_index + 1)


func _build_castle_bridge(parent: Node3D) -> void:
	var bridge := Node3D.new()
	bridge.name = "CastleTimberCauseway"
	parent.add_child(bridge)
	var start := parent.to_local(BRIDGE_START_WORLD)
	var finish := parent.to_local(BRIDGE_END_WORLD)
	var direction := (finish - start).normalized()
	var side := direction.cross(Vector3.UP).normalized()
	for plank_index in 14:
		var t := (float(plank_index) + 0.5) / 14.0
		var plank := _add_mesh(bridge, _box(Vector3(4.65, 0.18, 0.76)),
			_timber_light if plank_index % 3 == 1 else _timber,
			start.lerp(finish, t) + Vector3.UP * 0.33)
		plank.name = "OakDrawbridgePlank_%02d" % (plank_index + 1)
		plank.basis = Basis.looking_at(direction, Vector3.UP)
		for nail_side in [-1.0, 1.0]:
			var nail := _add_mesh(bridge, _cylinder(0.07, 0.07, 0.05, 8), _iron,
				plank.position + side * nail_side * 1.72 + Vector3.UP * 0.11)
			nail.name = "WroughtNail"
	for beam_index in 6:
		var beam_t := float(beam_index) / 5.0
		var crossbeam := _add_mesh(bridge, _box(Vector3(5.45, 0.34, 0.38)),
			_timber_dark, start.lerp(finish, beam_t) + Vector3.DOWN * 0.42)
		crossbeam.name = "DrawbridgeCrossbeam_%02d" % (beam_index + 1)
		crossbeam.basis = Basis.looking_at(direction, Vector3.UP)
	for side_value in [-1.0, 1.0]:
		var lateral: float = side_value
		var side_offset := side * lateral * 2.15
		_add_beam_between(bridge, start + side_offset + Vector3.DOWN * 0.79,
			finish + side_offset + Vector3.DOWN * 0.79, 0.34, _timber_dark).name = \
			"OakSideStringer"
		var previous_low := Vector3.ZERO
		var previous_high := Vector3.ZERO
		for post_index in 6:
			var post_t := float(post_index) / 5.0
			var foot := start.lerp(finish, post_t) + side_offset + Vector3.UP * 0.48
			var post_top := foot + Vector3.UP * 1.72
			var rail_post := _add_beam_between(bridge, foot, post_top, 0.24, _timber_dark)
			rail_post.name = "CarvedRailPost"
			# Rail posts mark the causeway edge, so solid collision here is the
			# normal expected behaviour of a railing (it should stop a player
			# from walking through it, not just decorate the drop-off).
			_add_box_body(rail_post, Vector3(0.24, 0.24, 1.72), "SolidCarvedRailPost")
			var cap := _add_mesh(bridge, _cone(0.28, 0.46, 4), _slate,
				post_top + Vector3.UP * 0.22)
			cap.name = "RailPostCap"
			if post_index > 0:
				_add_beam_between(bridge, previous_high, post_top, 0.22,
					_timber).name = "OakTopRail"
				var current_low := foot + Vector3.UP * 0.50
				_add_beam_between(bridge,
					previous_low if post_index % 2 == 0 else previous_high,
					post_top if post_index % 2 == 0 else current_low,
					0.17, _timber_light).name = "DrawbridgeDiagonalBrace"
			previous_low = foot + Vector3.UP * 0.50
			previous_high = post_top
	for chain_side_value in [-1.0, 1.0]:
		var chain_side: float = chain_side_value
		var chain_anchor := finish + side * chain_side * 2.25 + Vector3.UP * 5.25
		var chain_deck := finish - direction * 3.15 + side * chain_side * 2.05 \
			+ Vector3.UP * 0.88
		_add_beam_between(bridge, chain_anchor, chain_deck, 0.13, _iron).name = \
			"WroughtDrawbridgeChain"


func _build_bridge_barbican(parent: Node3D) -> void:
	var barbican := Node3D.new()
	barbican.name = "CastleBridgeBarbican"
	barbican.position = parent.to_local(BRIDGE_END_WORLD)
	barbican.set_meta("route_policy", "solid_towers_clear_central_court_lane")
	parent.add_child(barbican)
	for side_value in [-1.0, 1.0]:
		var lateral: float = side_value
		# The former +/-3.25 m placement left less than one capsule width between
		# a tower and the central fire. Because the towers were also visual-only,
		# the fox appeared to solve that impossible gap by walking through stone.
		# Moving them to the terrace shoulders creates a broad real route while
		# keeping the bridge framed by the same two-tower silhouette.
		var tower_size := Vector3(2.2, 5.2, 2.2)
		var tower_lateral := lateral * 4.2
		var pier := _add_mesh(barbican, _box(tower_size), _stone,
			Vector3(0.0, 2.6, tower_lateral))
		pier.name = "BarbicanTower"
		pier.set_meta("collision_policy", "solid_simple_box_no_mesh_tunnelling")
		_add_box_body(pier, tower_size, "SolidBarbicanTower")
		var roof := _add_mesh(barbican, _cone(1.75, 2.4, 8), _slate,
			Vector3(0.0, 6.35, tower_lateral))
		roof.name = "BarbicanSlateRoof"
	var left_shoulder := Vector3(0.0, 4.6, -2.3)
	var right_shoulder := Vector3(0.0, 4.6, 2.3)
	var apex := Vector3(0.0, 7.4, 0.0)
	_add_beam_between(barbican, left_shoulder, apex, 0.52, _stone).name = "BarbicanPointedArch"
	_add_beam_between(barbican, right_shoulder, apex, 0.52, _stone).name = "BarbicanPointedArch"


func _build_full_castle_ascent(parent: Node3D) -> void:
	var ascent := Node3D.new()
	ascent.name = "CastleGrandCastleAscent"
	parent.add_child(ascent)
	var top := parent.to_local(CASTLE_DOOR_WORLD)
	var bottom := parent.to_local(CASTLE_DOOR_WORLD + Vector3(8.4, -9.0, 0.0))
	const STEP_COUNT := 18
	var run := absf(top.x - bottom.x) / float(STEP_COUNT)
	var rise := (top.y - bottom.y) / float(STEP_COUNT)

	# Eighteen overlapping masonry blocks replace the single steep grey slab.
	# Their 0.5 m visual rise matches the controller's safe step language while
	# the original hidden ramp remains the authoritative collision surface.
	for step_index in STEP_COUNT:
		var t := (float(step_index) + 0.5) / float(STEP_COUNT)
		var surface_y := bottom.y + rise * float(step_index + 1)
		var centre := Vector3(lerpf(bottom.x, top.x, t), surface_y - 0.27, top.z)
		var tread := _add_mesh(ascent,
			_box(Vector3(run + 0.20, 0.54, 5.25)),
			_stone_light if step_index % 3 == 1 else _stone, centre)
		tread.name = "GrandAscentTread_%02d" % (step_index + 1)

		# Stepped cheek walls turn the climb into a defensible castle stair and
		# visually connect each tread to the gatehouse foundations above.
		for side_value in [-1.0, 1.0]:
			var lateral: float = side_value
			var cheek := _add_mesh(ascent,
				_box(Vector3(run + 0.22, 1.12, 0.68)), _stone,
				Vector3(centre.x, surface_y + 0.28, top.z + lateral * 2.92))
			cheek.name = "GrandAscentCheek"
			# Inner face (2.58 m) is outside the 2.4 m hidden ramp, so this never
			# narrows the route. 3 m tall so the player can't hop the 0.84 m wall.
			_add_box_body(cheek, Vector3(run + 0.22, 3.0, 0.68), "SolidAscentCheek")
			if step_index % 3 == 0:
				var merlon := _add_mesh(ascent, _box(Vector3(0.52, 0.72, 0.78)),
					_stone_light,
					Vector3(centre.x, surface_y + 1.18, top.z + lateral * 2.92))
				merlon.name = "GrandAscentMerlon"

	# Broad landings and square newels mark both ends, making the whole climb
	# read as one route from the lower court to the upper oak gate.
	for landing_index in 2:
		var at_top := landing_index == 1
		var anchor := top if at_top else bottom
		var landing := _add_mesh(ascent, _box(Vector3(2.1, 0.46, 6.2)),
			_stone_light, anchor + Vector3(0.0, -0.23, 0.0))
		landing.name = "UpperGateLanding" if at_top else "LowerCourtLanding"
		for side_value in [-1.0, 1.0]:
			var lateral: float = side_value
			var newel := _add_mesh(ascent, _box(Vector3(1.05, 2.0, 1.05)), _stone,
				anchor + Vector3(0.0, 0.76, lateral * 3.05))
			newel.name = "AscentNewelTower"
			var cap := _add_mesh(ascent, _cone(0.78, 1.15, 4), _slate,
				anchor + Vector3(0.0, 2.28, lateral * 3.05))
			cap.name = "AscentNewelRedCap"

	# Four red heraldic shields repeat the original castle's red accents down
	# the climb, tying the new stair visually to the restored roof colour.
	for shield_index in 4:
		var shield_t := (float(shield_index) + 0.5) / 4.0
		var shield_y := lerpf(bottom.y, top.y, shield_t) + 1.12
		var shield_x := lerpf(bottom.x, top.x, shield_t)
		for side_value in [-1.0, 1.0]:
			var shield := _add_mesh(ascent, _box(Vector3(0.10, 0.92, 0.62)), _slate,
				Vector3(shield_x, shield_y, top.z + float(side_value) * 3.29))
			shield.name = "AscentHeraldicShield"


func _build_front_gatehouse(parent: Node3D) -> void:
	var gatehouse := Node3D.new()
	gatehouse.name = "CastleFrontGatehouse"
	gatehouse.position = parent.to_local(CASTLE_DOOR_WORLD)
	parent.add_child(gatehouse)

	# A battered plinth and shallow stepped sill carry the doorway down into the
	# castle threshold. These replace the removed floating circular platform.
	for side_value in [-1.0, 1.0]:
		var foundation_side: float = side_value
		var foundation := _add_mesh(gatehouse, _box(Vector3(3.8, 2.6, 3.8)),
			_stone, Vector3(-0.45, -1.3, foundation_side * 4.0))
		foundation.name = "GatehouseGroundFoundation"
		var footing := _add_mesh(gatehouse, _box(Vector3(4.35, 0.42, 4.35)),
			_stone, Vector3(-0.45, -2.78, foundation_side * 4.0))
		footing.name = "GatehouseSpreadFooting"
	for step_index in 3:
		var step_width := 5.45 + float(step_index) * 0.34
		var step := _add_mesh(gatehouse,
			_box(Vector3(0.78, 0.28, step_width)), _stone,
			Vector3(0.25 + float(step_index) * 0.58,
				-0.14 - float(step_index) * 0.20, 0.0))
		step.name = "GateThresholdStep_%02d" % (step_index + 1)
	var retaining_wall := _add_mesh(gatehouse, _box(Vector3(1.35, 1.7, 5.8)),
		_stone, Vector3(-0.35, -0.85, 0.0))
	retaining_wall.name = "GateThresholdRetainingWall"
	for corbel_side_value in [-1.0, 1.0]:
		var corbel_side: float = corbel_side_value
		var corbel := _add_mesh(gatehouse, _box(Vector3(1.75, 0.62, 0.72)),
			_stone, Vector3(0.18, -0.38, corbel_side * 2.45))
		corbel.name = "GateThresholdCorbel"
	for side_value in [-1.0, 1.0]:
		var lateral: float = side_value
		var tower := _add_mesh(gatehouse, _box(Vector3(3.1, 8.0, 3.1)), _stone,
			Vector3(-0.35, 4.0, lateral * 4.0))
		tower.name = "GatehouseTower"
		var roof := _add_mesh(gatehouse, _cone(2.35, 3.4, 10), _slate,
			Vector3(-0.35, 9.7, lateral * 4.0))
		roof.name = "GatehouseSlateRoof"
		for merlon_index in 3:
			var merlon := _add_mesh(gatehouse, _box(Vector3(0.72, 0.9, 0.72)), _stone,
				Vector3(-0.35, 8.38, lateral * (2.9 + float(merlon_index) * 1.1)))
			merlon.name = "GatehouseMerlon"

	var left_shoulder := Vector3(-0.15, 5.2, -2.65)
	var right_shoulder := Vector3(-0.15, 5.2, 2.65)
	var apex := Vector3(-0.15, 9.0, 0.0)
	_add_beam_between(gatehouse, Vector3(-0.15, 0.0, -2.65), left_shoulder,
		0.64, _stone).name = "GatePierLeft"
	_add_beam_between(gatehouse, Vector3(-0.15, 0.0, 2.65), right_shoulder,
		0.64, _stone).name = "GatePierRight"
	_add_beam_between(gatehouse, left_shoulder, apex, 0.64, _stone).name = "PointedGateArch"
	_add_beam_between(gatehouse, right_shoulder, apex, 0.64, _stone).name = "PointedGateArch"
	for leaf_index in 2:
		var side_sign := -1.0 if leaf_index == 0 else 1.0
		var door := _add_mesh(gatehouse, _box(Vector3(0.28, 4.8, 2.35)), _timber,
			Vector3(0.08, 2.4, side_sign * 1.2))
		door.name = "OakGateLeaf_%02d" % (leaf_index + 1)
		for board_index in 3:
			var board := _add_mesh(gatehouse, _box(Vector3(0.08, 4.46, 0.62)),
				_timber_light, door.position + Vector3(0.18, 0.0,
					-0.68 + float(board_index) * 0.68))
			board.name = "OakGateBoard"
		for band_index in 3:
			var band := _add_mesh(gatehouse, _box(Vector3(0.34, 0.18, 2.28)), _iron,
				door.position + Vector3(-0.02, -1.45 + float(band_index) * 1.45, 0.0))
			band.name = "WroughtIronDoorBand"
	var handle := _add_mesh(gatehouse, _torus(0.23, 0.32), _iron,
		Vector3(0.29, 2.35, 0.0))
	handle.name = "WroughtIronGateHandle"
	handle.rotation.z = PI * 0.5


func _add_mesh(parent: Node3D, mesh: Mesh, material: Material,
		position: Vector3) -> MeshInstance3D:
	var part := MeshInstance3D.new()
	part.mesh = mesh
	part.material_override = material
	part.position = position
	parent.add_child(part)
	return part


func _add_box_body(host: MeshInstance3D, size: Vector3,
		body_name: String) -> StaticBody3D:
	var body := StaticBody3D.new()
	body.name = body_name
	body.set_meta("collision_policy", "simple_solid_architecture")
	host.add_child(body)
	var shape := CollisionShape3D.new()
	shape.name = "SolidShape"
	var box := BoxShape3D.new()
	box.size = size
	shape.shape = box
	body.add_child(shape)
	return body


func _add_beam_between(parent: Node3D, from: Vector3, to: Vector3,
		thickness: float, material: Material) -> MeshInstance3D:
	var delta := to - from
	var beam := _add_mesh(parent, _box(Vector3(thickness, thickness, delta.length())),
		material, from.lerp(to, 0.5))
	var direction := delta.normalized()
	var up := Vector3.FORWARD if absf(direction.dot(Vector3.UP)) > 0.98 else Vector3.UP
	beam.basis = Basis.looking_at(direction, up)
	return beam


func _box(size: Vector3) -> BoxMesh:
	var mesh := BoxMesh.new()
	mesh.size = size
	return mesh


func _cylinder(top_radius: float, bottom_radius: float, height: float,
		segments: int) -> CylinderMesh:
	var mesh := CylinderMesh.new()
	mesh.top_radius = top_radius
	mesh.bottom_radius = bottom_radius
	mesh.height = height
	mesh.radial_segments = segments
	return mesh


func _cone(radius: float, height: float, segments: int) -> CylinderMesh:
	return _cylinder(0.0, radius, height, segments)


func _torus(inner_radius: float, outer_radius: float) -> TorusMesh:
	var mesh := TorusMesh.new()
	mesh.inner_radius = inner_radius
	mesh.outer_radius = outer_radius
	mesh.rings = 24
	mesh.ring_segments = 8
	return mesh
