#!/usr/bin/env bash
# Artéa on the web, from the repo root.
#
#   ./web                 start local backend, export if needed, serve, open a browser
#   ./web rebuild         force a fresh export first
#   ./web serve           serve whatever is already built
#   ./web verify          check the local backend and Offline Guest gameplay,
#                         plus first-load bytes transferred and time-to-hub
#   ./web status          what is built, what is serving
#   ./web stop            stop the local server
#
# Options (any command):
#   --port N              default 8801, or PORT in .webrc
#   --no-open             do not launch a browser
#   --url URL             verify: check URL (e.g. a deployment) instead of
#                         serving the local build
#   --repeat              verify: load twice with the cache on and report what
#                         the second visit downloads (serves the local build
#                         with the deployed cache headers)
#   -h, --help            this text
#
# Settings live in .webrc next to this script if you want different defaults:
#
#   PORT=9000
#   GODOT_BIN=/Applications/Godot.app/Contents/MacOS/Godot
#
# Why a wrapper rather than calling artea/tools/web.sh directly: the export and
# the verification are two halves of the same job. A Godot web export can
# succeed while the build is unplayable - a missing export dependency makes
# change_scene_to_packed receive null, and the game simply stops responding with
# nothing on screen. `./web verify` is what catches that.
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
web_sh="${repo_dir}/artea/tools/web.sh"
smoke_js="${repo_dir}/artea/tools/web-smoke.js"
build_dir="${repo_dir}/artea/builds/web"
smoke_dir="${repo_dir}/artea/builds/smoke"

# Defaults, overridable by .webrc and then by flags.
port=8801
open_browser=1
# shellcheck source=/dev/null
[[ -f "${repo_dir}/.webrc" ]] && source "${repo_dir}/.webrc"
port="${PORT:-${port}}"
[[ -n "${GODOT_BIN:-}" ]] && export GODOT_BIN

command=run
target_url=""
repeat=0
[[ $# -gt 0 && "$1" != -* ]] && { command="$1"; shift; }

while [[ $# -gt 0 ]]; do
	case "$1" in
		--port)    port="${2:?--port needs a number}"; shift 2 ;;
		--no-open) open_browser=0; shift ;;
		--url)     target_url="${2:?--url needs a URL}"; shift 2 ;;
		--repeat)  repeat=1; shift ;;
		-h|--help) sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) echo "Unknown option: $1 (try --help)" >&2; exit 1 ;;
	esac
done

url="http://localhost:${port}/index.html"
pid_file="${repo_dir}/.web-server-${port}.pid"

serving_pid() {
	# No match is the normal "not serving" answer, not an error. Under
	# `set -euo pipefail` a grep/lsof that finds nothing would otherwise fail
	# the pipeline and silently kill `pid="$(serving_pid)"` callers.
	if command -v lsof >/dev/null 2>&1; then
		lsof -tiTCP:"${port}" -sTCP:LISTEN 2>/dev/null | head -1 || true
	elif command -v netstat >/dev/null 2>&1; then
		# Git Bash / Windows has no lsof; netstat -ano's last column is the PID.
		netstat -ano 2>/dev/null | grep -E "[:.]${port}[[:space:]].*LISTENING" | awk '{print $NF}' | head -1 || true
	fi
}

backend_up() {
	curl -fsS -m 3 http://127.0.0.1:8000/ 2>/dev/null | grep -q 'server running'
}

backend_browser_ready() {
	curl -fsS -m 3 -D - -o /dev/null -X OPTIONS \
		-H "Origin: http://localhost:${port}" \
		-H 'Access-Control-Request-Method: POST' \
		http://127.0.0.1:8000/login 2>/dev/null \
		| tr -d '\r' \
		| grep -Eiq "^Access-Control-Allow-Origin: (\\*|http://localhost:${port})$"
}

venv_python() {
	if [[ -x "${repo_dir}/server/venv/bin/python" ]]; then
		printf '%s' "${repo_dir}/server/venv/bin/python"
	elif [[ -x "${repo_dir}/server/venv/Scripts/python.exe" ]]; then
		printf '%s' "${repo_dir}/server/venv/Scripts/python.exe"
	fi
}

ensure_backend() {
	backend_up && { echo "Backend ready on 127.0.0.1:8000"; return 0; }
	local backend_python
	backend_python="$(venv_python)"
	if [[ ! -x "${backend_python}" ]]; then
		echo "Backend unavailable: run ./setup.sh to install its dependencies." >&2
		echo "Offline Guest remains available." >&2
		return 1
	fi
	if ! "${backend_python}" -c 'import flask, flask_cors, flask_sqlalchemy, flask_jwt_extended, bcrypt, requests' >/dev/null 2>&1; then
		echo "Backend dependencies are incomplete. Run ./setup.sh to install server/requirements.txt." >&2
		echo "Offline Guest remains available." >&2
		return 1
	fi
	echo "Starting local backend on 127.0.0.1:8000…"
	mkdir -p "${repo_dir}/server/logs"
	(
		cd "${repo_dir}/server"
		HOST=127.0.0.1 PORT=8000 "${backend_python}" server.py \
			>> logs/flaskapp.err.log 2>&1 < /dev/null &
	)
	for _ in $(seq 1 20); do
		backend_up && { echo "Backend ready"; return 0; }
		sleep 0.5
	done
	echo "Backend did not start; Offline Guest remains available. See server/logs/flaskapp.err.log." >&2
	return 1
}

open_url() {
	command -v open >/dev/null 2>&1 && { open "$1"; return; }
	command -v xdg-open >/dev/null 2>&1 && { xdg-open "$1"; return; }
	command -v start >/dev/null 2>&1 && { start "$1"; return; }
	echo "Open $1 in a browser" >&2
}

kill_server() {
	# netstat reports a Windows PID, which Git Bash's kill does not know about,
	# so fall back to taskkill there.
	kill "$1" 2>/dev/null || taskkill //PID "$1" //F >/dev/null 2>&1
}

serve_background() {
	# Serving is exec'd by web.sh, so the recorded pid is the server itself.
	# Arguments are web.sh flags, e.g. --serve-only --prod-cache.
	[[ -n "$(serving_pid)" ]] && { echo "Already serving on ${port} (pid $(serving_pid))"; return 0; }
	"${web_sh}" "$@" --port "${port}" --no-open >"${repo_dir}/.web-server-${port}.log" 2>&1 &
	echo $! > "${pid_file}"
	disown %% 2>/dev/null || true
	for _ in $(seq 60); do
		curl -sf -o /dev/null "${url}" && return 0
		sleep 1
	done
	echo "Server did not come up. Log: ${repo_dir}/.web-server-${port}.log" >&2
	return 1
}

case "${command}" in
	run|rebuild|serve)
		if [[ "${command}" != serve ]]; then
			"${repo_dir}/setup.sh" web
		fi
		ensure_backend || true
		flag=""
		[[ "${command}" == rebuild ]] && flag="--rebuild"
		[[ "${command}" == serve ]] && flag="--serve-only"
		if [[ -n "$(serving_pid)" ]]; then
			if [[ "${command}" == serve ]]; then
				echo "Already serving on ${url}"
			else
				args=(--export-only)
				[[ -n "${flag}" ]] && args=("${flag}" "${args[@]}")
				"${web_sh}" "${args[@]}"
				echo "Build refreshed; server already listening on ${url}"
			fi
			if [[ "${open_browser}" == 1 ]]; then
				open_url "${url}"
			fi
			exit 0
		fi
		args=(--port "${port}")
		[[ -n "${flag}" ]] && args=("${flag}" "${args[@]}")
		[[ "${open_browser}" == 0 ]] && args+=(--no-open)
		exec "${web_sh}" "${args[@]}"
		;;

	verify)
		# Verification needs a server but should not leave one behind, so start
		# one only when nothing is already listening on the port. A --url
		# target (a deployment) needs no local server at all.
		started_here=0
		smoke_args=(--out "${smoke_dir}")
		[[ "${repeat}" == 1 ]] && smoke_args+=(--repeat)
		if [[ -n "${target_url}" ]]; then
			url="${target_url}"
		else
			ensure_backend
			backend_browser_ready || {
				echo "Backend is running but the browser cannot call its login API (CORS preflight failed)." >&2
				exit 1
			}
		fi
		if [[ -z "${target_url}" && -z "$(serving_pid)" ]]; then
			echo "Starting a server on ${port} for the check…"
			if [[ "${repeat}" == 1 ]]; then
				# A repeat visit is only meaningful with the deployed cache rules.
				serve_background --serve-only --prod-cache
			else
				serve_background --serve-only
			fi
			started_here=1
		elif [[ -z "${target_url}" && "${repeat}" == 1 ]]; then
			echo "A server is already running on ${port} with its own cache headers;" >&2
			echo "stop it (./web stop) so --repeat can serve with the deployed ones." >&2
			exit 1
		fi
		set +e
		node "${smoke_js}" "${url}" "${smoke_args[@]}"
		result=$?
		set -e
		if [[ "${started_here}" == 1 ]]; then
			pid="$(serving_pid)"
			[[ -n "${pid}" ]] && { kill_server "${pid}" || true; }
			rm -f "${pid_file}"
		fi
		exit "${result}"
		;;

	status)
		backend_up && echo "backend http://127.0.0.1:8000/" || echo "backend not running on 8000"
		if [[ -f "${build_dir}/index.pck" ]]; then
			size=$(stat -c '%s' "${build_dir}/index.pck" 2>/dev/null || stat -f '%z' "${build_dir}/index.pck")
			when=$(stat -c '%y' "${build_dir}/index.pck" 2>/dev/null || stat -f '%Sm' -t '%Y-%m-%d %H:%M' "${build_dir}/index.pck")
			printf 'build   %s  (%.1f MB, %s)\n' "${build_dir}" "$((size / 1048576))" "${when}"
			if [[ -f "${build_dir}/index.pck.parts.json" ]]; then
				manifest=$(sed -E 's/.*"bytes":([0-9]+).*/\1/' "${build_dir}/index.pck.parts.json")
				if [[ "${manifest}" == "${size}" ]]; then
					echo "parts   in sync with the pack"
				else
					echo "parts   STALE - manifest says ${manifest}, pack is ${size}; next serve re-splits"
				fi
			else
				echo "parts   not split yet"
			fi
		else
			echo "build   none - run ./web rebuild"
		fi
		pid="$(serving_pid)"
		if [[ -n "${pid}" ]]; then
			echo "server  ${url} (pid ${pid})"
		else
			echo "server  not running on ${port}"
		fi
		;;

	stop)
		pid="$(serving_pid)"
		if [[ -n "${pid}" ]]; then
			kill_server "${pid}"
			rm -f "${pid_file}"
			echo "Stopped server on ${port} (pid ${pid})"
		else
			echo "Nothing serving on ${port}"
		fi
		;;

	*)
		echo "Unknown command: ${command} (try --help)" >&2
		exit 1
		;;
esac
