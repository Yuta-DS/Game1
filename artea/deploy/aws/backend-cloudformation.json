{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Artea production backend: Cognito, two private Fargate tasks, Multi-AZ PostgreSQL, private artwork S3.",
  "Conditions": {
    "HasMigrationImage": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "MigrationImageUri"
            },
            ""
          ]
        }
      ]
    },
    "HasAiSecret": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AiSecretArn"
            },
            ""
          ]
        }
      ]
    }
  },
  "Parameters": {
    "MigrationImageUri": {
      "Type": "String",
      "Default": "",
      "Description": "New image for schema preparation before runtime promotion"
    },
    "AiSecretArn": {
      "Type": "String",
      "Default": ""
    },
    "CloudFrontPrefixListId": {
      "Type": "String",
      "AllowedPattern": "pl-[a-f0-9]+"
    },
    "ImageUri": {
      "Type": "String",
      "AllowedPattern": "[0-9]+\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9_./-]+@sha256:[a-f0-9]{64}"
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 0,
      "AllowedValues": [
        0,
        2
      ]
    },
    "DbInstanceClass": {
      "Type": "String",
      "Default": "db.t4g.medium",
      "AllowedValues": [
        "db.t4g.medium",
        "db.t4g.large",
        "db.m7g.large"
      ]
    },
    "SesIdentityArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:ses:[a-z0-9-]+:[0-9]+:identity/.+"
    },
    "AccountEmailFrom": {
      "Type": "String",
      "Description": "Verified SES From email address"
    },
    "OperationsEmail": {
      "Type": "String",
      "Description": "Confirm the SNS email subscription after deployment"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.40.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "PublicA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.40.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicRoutesA": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PublicAssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicA"
        },
        "RouteTableId": {
          "Ref": "PublicRoutesA"
        }
      }
    },
    "PrivateA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.40.10.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PrivateRoutesA": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PrivateAssociationA": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateA"
        },
        "RouteTableId": {
          "Ref": "PrivateRoutesA"
        }
      }
    },
    "AddressA": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      },
      "DependsOn": "GatewayAttachment"
    },
    "NatA": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "AddressA",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "PublicA"
        }
      }
    },
    "PublicDefaultA": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutesA"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "PrivateDefaultA": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PrivateRoutesA"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NatA"
        }
      }
    },
    "PublicB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.40.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PublicRoutesB": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PublicAssociationB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PublicB"
        },
        "RouteTableId": {
          "Ref": "PublicRoutesB"
        }
      }
    },
    "PrivateB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.40.11.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      }
    },
    "PrivateRoutesB": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PrivateAssociationB": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "PrivateB"
        },
        "RouteTableId": {
          "Ref": "PrivateRoutesB"
        }
      }
    },
    "AddressB": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc"
      },
      "DependsOn": "GatewayAttachment"
    },
    "NatB": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": {
          "Fn::GetAtt": [
            "AddressB",
            "AllocationId"
          ]
        },
        "SubnetId": {
          "Ref": "PublicB"
        }
      }
    },
    "PublicDefaultB": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutesB"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "PrivateDefaultB": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "PrivateRoutesB"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": {
          "Ref": "NatB"
        }
      }
    },
    "S3Endpoint": {
      "Type": "AWS::EC2::VPCEndpoint",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "VpcEndpointType": "Gateway",
        "ServiceName": {
          "Fn::Sub": "com.amazonaws.${AWS::Region}.s3"
        },
        "RouteTableIds": [
          {
            "Ref": "PrivateRoutesA"
          },
          {
            "Ref": "PrivateRoutesB"
          }
        ]
      }
    },
    "AppSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Artea App",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "DatabaseSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Artea Database",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "LoadBalancerSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Artea LoadBalancer",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "DbIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseSecurity"
        },
        "SourceSecurityGroupId": {
          "Ref": "AppSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432
      }
    },
    "AppIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "AppSecurity"
        },
        "SourceSecurityGroupId": {
          "Ref": "LoadBalancerSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 8000,
        "ToPort": 8000
      }
    },
    "ArtworkBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "CleanupOldVersions",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 90
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ArtworkBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ArtworkBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ArtworkBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ArtworkBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "OriginSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "SecretStringTemplate": "{}",
          "GenerateStringKey": "token",
          "PasswordLength": 48,
          "ExcludePunctuation": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApplicationDbSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\": \"artea_app\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 48,
          "ExcludePunctuation": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Private two-AZ database",
        "SubnetIds": [
          {
            "Ref": "PrivateA"
          },
          {
            "Ref": "PrivateB"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "postgres",
        "DBInstanceClass": {
          "Ref": "DbInstanceClass"
        },
        "DBName": "artea",
        "MasterUsername": "artea_owner",
        "ManageMasterUserPassword": true,
        "AllocatedStorage": "30",
        "MaxAllocatedStorage": 200,
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "MultiAZ": true,
        "PubliclyAccessible": false,
        "BackupRetentionPeriod": 14,
        "DeletionProtection": true,
        "CopyTagsToSnapshot": true,
        "AutoMinorVersionUpgrade": true,
        "EnableCloudwatchLogsExports": [
          "postgresql",
          "upgrade"
        ],
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurity"
          }
        ],
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        }
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "${AWS::StackName}-players"
        },
        "DeletionProtection": "ACTIVE",
        "AutoVerifiedAttributes": [
          "email"
        ],
        "UsernameConfiguration": {
          "CaseSensitive": false
        },
        "AccountRecoverySetting": {
          "RecoveryMechanisms": [
            {
              "Name": "verified_email",
              "Priority": 1
            }
          ]
        },
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": 14,
            "RequireLowercase": true,
            "RequireUppercase": true,
            "RequireNumbers": true,
            "RequireSymbols": true,
            "TemporaryPasswordValidityDays": 1
          }
        },
        "Schema": [
          {
            "Name": "email",
            "AttributeDataType": "String",
            "Required": true,
            "Mutable": true
          }
        ],
        "EmailConfiguration": {
          "EmailSendingAccount": "DEVELOPER",
          "SourceArn": {
            "Ref": "SesIdentityArn"
          },
          "From": {
            "Ref": "AccountEmailFrom"
          }
        },
        "VerificationMessageTemplate": {
          "DefaultEmailOption": "CONFIRM_WITH_CODE"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "UserClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "GenerateSecret": true,
        "ExplicitAuthFlows": [
          "ALLOW_USER_PASSWORD_AUTH",
          "ALLOW_REFRESH_TOKEN_AUTH"
        ],
        "PreventUserExistenceErrors": "ENABLED",
        "EnableTokenRevocation": true,
        "AccessTokenValidity": 1,
        "IdTokenValidity": 1,
        "RefreshTokenValidity": 7,
        "TokenValidityUnits": {
          "AccessToken": "hours",
          "IdToken": "hours",
          "RefreshToken": "days"
        },
        "ReadAttributes": [
          "email",
          "email_verified"
        ],
        "WriteAttributes": [
          "email"
        ]
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "RetentionInDays": 30
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "ReadTaskSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "OriginSecret"
                    },
                    {
                      "Ref": "ApplicationDbSecret"
                    },
                    {
                      "Fn::If": [
                        "HasAiSecret",
                        {
                          "Ref": "AiSecretArn"
                        },
                        {
                          "Ref": "AWS::NoValue"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "MigrationExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
          }
        ],
        "Policies": [
          {
            "PolicyName": "ReadTaskSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "ApplicationDbSecret"
                    },
                    {
                      "Fn::GetAtt": [
                        "Database",
                        "MasterUserSecret.SecretArn"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "CognitoServerClient",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "cognito-idp:DescribeUserPoolClient"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "UserPool",
                        "Arn"
                      ]
                    }
                  ]
                }
              ]
            }
          },
          {
            "PolicyName": "PrivatePlayerArtwork",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "${ArtworkBucket.Arn}/users/*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "MigrationRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ]
      }
    },
    "ApiTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "api",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 8000
              }
            ],
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "DB_NAME",
                "Value": "artea"
              },
              {
                "Name": "DB_SSL_CA",
                "Value": "/app/rds-ca.pem"
              },
              {
                "Name": "AUTO_CREATE_SCHEMA",
                "Value": "false"
              },
              {
                "Name": "AI_ALLOW_LOOPBACK_GUESTS",
                "Value": "0"
              },
              {
                "Name": "MAX_UPLOAD_BYTES",
                "Value": "8000000"
              },
              {
                "Name": "AI_UPSTREAM_TIMEOUT_SECONDS",
                "Value": "35"
              },
              {
                "Name": "CORS_ALLOWED_ORIGINS",
                "Value": "https://invalid.invalid"
              },
              {
                "Name": "DB_USERNAME",
                "Value": "artea_app"
              },
              {
                "Name": "COGNITO_POOL_ID",
                "Value": {
                  "Ref": "UserPool"
                }
              },
              {
                "Name": "COGNITO_CLIENT_ID",
                "Value": {
                  "Ref": "UserClient"
                }
              },
              {
                "Name": "ARTWORK_BUCKET",
                "Value": {
                  "Ref": "ArtworkBucket"
                }
              },
              {
                "Name": "JWT_SECRET_KEY",
                "Value": "unused-production-cognito-RS256-only"
              }
            ],
            "Secrets": [
              {
                "Name": "DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${ApplicationDbSecret}:password::"
                }
              },
              {
                "Name": "ORIGIN_SECRET",
                "ValueFrom": {
                  "Fn::Sub": "${OriginSecret}:token::"
                }
              },
              {
                "Fn::If": [
                  "HasAiSecret",
                  {
                    "Name": "OMNIROUTE_BASE_URL",
                    "ValueFrom": {
                      "Fn::Sub": "${AiSecretArn}:OMNIROUTE_BASE_URL::"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              },
              {
                "Fn::If": [
                  "HasAiSecret",
                  {
                    "Name": "OMNIROUTE_CREATIVE_GUIDE_API_KEY",
                    "ValueFrom": {
                      "Fn::Sub": "${AiSecretArn}:OMNIROUTE_CREATIVE_GUIDE_API_KEY::"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              },
              {
                "Fn::If": [
                  "HasAiSecret",
                  {
                    "Name": "OMNIROUTE_WORLD_BUILDER_API_KEY",
                    "ValueFrom": {
                      "Fn::Sub": "${AiSecretArn}:OMNIROUTE_WORLD_BUILDER_API_KEY::"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              },
              {
                "Fn::If": [
                  "HasAiSecret",
                  {
                    "Name": "OMNIROUTE_BACKUP_API_KEY",
                    "ValueFrom": {
                      "Fn::Sub": "${AiSecretArn}:OMNIROUTE_BACKUP_API_KEY::"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              },
              {
                "Fn::If": [
                  "HasAiSecret",
                  {
                    "Name": "OPENROUTER_API_KEY",
                    "ValueFrom": {
                      "Fn::Sub": "${AiSecretArn}:OPENROUTER_API_KEY::"
                    }
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "api"
              }
            },
            "LinuxParameters": {
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              }
            }
          }
        ]
      }
    },
    "MigrationTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "MigrationExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "MigrationRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "migration",
            "Image": {
              "Fn::If": [
                "HasMigrationImage",
                {
                  "Ref": "MigrationImageUri"
                },
                {
                  "Ref": "ImageUri"
                }
              ]
            },
            "Essential": true,
            "Command": [
              "python",
              "manage_aws.py"
            ],
            "Environment": [
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              },
              {
                "Name": "DB_HOST",
                "Value": {
                  "Fn::GetAtt": [
                    "Database",
                    "Endpoint.Address"
                  ]
                }
              },
              {
                "Name": "DB_NAME",
                "Value": "artea"
              },
              {
                "Name": "DB_SSL_CA",
                "Value": "/app/rds-ca.pem"
              },
              {
                "Name": "AUTO_CREATE_SCHEMA",
                "Value": "false"
              },
              {
                "Name": "AI_ALLOW_LOOPBACK_GUESTS",
                "Value": "0"
              },
              {
                "Name": "MAX_UPLOAD_BYTES",
                "Value": "8000000"
              },
              {
                "Name": "AI_UPSTREAM_TIMEOUT_SECONDS",
                "Value": "35"
              },
              {
                "Name": "CORS_ALLOWED_ORIGINS",
                "Value": "https://invalid.invalid"
              },
              {
                "Name": "DB_USERNAME",
                "Value": "artea_owner"
              }
            ],
            "Secrets": [
              {
                "Name": "DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::GetAtt": [
                          "Database",
                          "MasterUserSecret.SecretArn"
                        ]
                      },
                      ":password::"
                    ]
                  ]
                }
              },
              {
                "Name": "APP_DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "${ApplicationDbSecret}:password::"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "api"
              }
            }
          }
        ]
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internal",
        "Type": "application",
        "Subnets": [
          {
            "Ref": "PrivateA"
          },
          {
            "Ref": "PrivateB"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "LoadBalancerSecurity"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          },
          {
            "Key": "idle_timeout.timeout_seconds",
            "Value": "110"
          }
        ]
      }
    },
    "Targets": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Port": 8000,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/healthz",
        "Matcher": {
          "HttpCode": "200"
        },
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Targets"
            }
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "Cluster": {
          "Ref": "Cluster"
        },
        "LaunchType": "FARGATE",
        "TaskDefinition": {
          "Ref": "ApiTask"
        },
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "AvailabilityZoneRebalancing": "ENABLED",
        "HealthCheckGracePeriodSeconds": 60,
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": [
              {
                "Ref": "PrivateA"
              },
              {
                "Ref": "PrivateB"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "AppSecurity"
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "api",
            "ContainerPort": 8000,
            "TargetGroupArn": {
              "Ref": "Targets"
            }
          }
        ]
      },
      "DependsOn": [
        "Listener",
        "PrivateDefaultA",
        "PrivateDefaultB"
      ]
    },
    "Scaling": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "Properties": {
        "MinCapacity": {
          "Ref": "DesiredCount"
        },
        "MaxCapacity": 6,
        "ResourceId": {
          "Fn::Sub": "service/${Cluster}/${Service.Name}"
        },
        "ScalableDimension": "ecs:service:DesiredCount",
        "ServiceNamespace": "ecs"
      }
    },
    "CpuScaling": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": "api-cpu",
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "Scaling"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 60,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          },
          "ScaleInCooldown": 120,
          "ScaleOutCooldown": 30
        }
      }
    },
    "AlbIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "LoadBalancerSecurity"
        },
        "SourcePrefixListId": {
          "Ref": "CloudFrontPrefixListId"
        },
        "IpProtocol": "tcp",
        "FromPort": 80,
        "ToPort": 80
      }
    },
    "VpcOrigin": {
      "Type": "AWS::CloudFront::VpcOrigin",
      "Properties": {
        "VpcOriginEndpointConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-private-api"
          },
          "Arn": {
            "Ref": "LoadBalancer"
          },
          "HTTPPort": 80,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "http-only"
        }
      },
      "DependsOn": [
        "Listener",
        "AlbIngress",
        "GatewayAttachment"
      ]
    },
    "AlarmTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "Subscription": [
          {
            "Endpoint": {
              "Ref": "OperationsEmail"
            },
            "Protocol": "email"
          }
        ]
      }
    },
    "DatabaseStorageAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/RDS",
        "MetricName": "FreeStorageSpace",
        "Dimensions": [
          {
            "Name": "DBInstanceIdentifier",
            "Value": {
              "Ref": "Database"
            }
          }
        ],
        "Statistic": "Minimum",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 5000000000,
        "ComparisonOperator": "LessThanThreshold",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ],
        "TreatMissingData": "notBreaching"
      }
    },
    "ApiErrorsAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "HTTPCode_Target_5XX_Count",
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": {
              "Fn::GetAtt": [
                "LoadBalancer",
                "LoadBalancerFullName"
              ]
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 2,
        "Threshold": 10,
        "ComparisonOperator": "GreaterThanThreshold",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ],
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "ApiDomain": {
      "Value": {
        "Fn::GetAtt": [
          "LoadBalancer",
          "DNSName"
        ]
      }
    },
    "VpcOriginId": {
      "Value": {
        "Ref": "VpcOrigin"
      }
    },
    "OriginSecretArn": {
      "Value": {
        "Ref": "OriginSecret"
      }
    },
    "UserPoolId": {
      "Value": {
        "Ref": "UserPool"
      }
    },
    "ClusterName": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "ServiceName": {
      "Value": {
        "Fn::GetAtt": [
          "Service",
          "Name"
        ]
      }
    },
    "MigrationTaskArn": {
      "Value": {
        "Ref": "MigrationTask"
      }
    },
    "PrivateSubnets": {
      "Value": {
        "Fn::Join": [
          ",",
          [
            {
              "Ref": "PrivateA"
            },
            {
              "Ref": "PrivateB"
            }
          ]
        ]
      }
    },
    "AppSecurityGroup": {
      "Value": {
        "Ref": "AppSecurity"
      }
    },
    "ArtworkBucketName": {
      "Value": {
        "Ref": "ArtworkBucket"
      }
    }
  }
}
