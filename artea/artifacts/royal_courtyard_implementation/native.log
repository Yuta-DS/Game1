1261: 	}
1262: 
1263: 	omni_attenuation *= shadow;
1264: 
1265: 	light_compute(normal, normalize(light_rel_vec), eye_vec, size_A, color, false, omni_attenuation, f0, roughness, metallic, omni_lights[idx].specular_amount, albedo, alpha, screen_uv,
1266: #ifdef LIGHT_BACKLIGHT_USED
1267: 			backlight,
1268: #endif
1269: #ifdef LIGHT_RIM_USED
1270: 			rim * omni_attenuation, rim_tint,
1271: #endif
1272: #ifdef LIGHT_CLEARCOAT_USED
1273: 			clearcoat, clearcoat_roughness, vertex_normal,
1274: #endif
1275: #ifdef LIGHT_ANISOTROPY_USED
1276: 			binormal, tangent, anisotropy,
1277: #endif
