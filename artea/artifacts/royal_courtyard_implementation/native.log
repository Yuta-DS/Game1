1673: #if !defined(DISABLE_LIGHT_SPOT) || defined(ADDITIVE_SPOT)
1674: void light_process_spot(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 f0, float roughness, float metallic, float shadow, vec3 albedo, inout float alpha, vec2 screen_uv,
1675: #ifdef LIGHT_BACKLIGHT_USED
1676: 		vec3 backlight,
1677: #endif
1678: #ifdef LIGHT_RIM_USED
1679: 		float rim, float rim_tint,
1680: #endif
1681: #ifdef LIGHT_CLEARCOAT_USED
1682: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1683: #endif
1684: #ifdef LIGHT_ANISOTROPY_USED
1685: 		vec3 binormal, vec3 tangent, float anisotropy,
1686: #endif
1687: 		inout vec3 diffuse_light,
1688: 		inout vec3 specular_light) {
1689: 
1690: 	vec3 light_rel_vec = spot_lights[idx].position - vertex;
1691: 	float light_length = length(light_rel_vec);
1692: 	float spot_attenuation = get_omni_spot_attenuation(light_length, spot_lights[idx].inv_radius, spot_lights[idx].attenuation);
1693: 	vec3 spot_dir = spot_lights[idx].direction;
1694: 	float scos = max(dot(-normalize(light_rel_vec), spot_dir), spot_lights[idx].cone_angle);
1695: 	float spot_rim = max(0.0001, (1.0 - scos) / (1.0 - spot_lights[idx].cone_angle));
1696: 
1697: 	mediump float cone_attenuation = spot_lights[idx].cone_attenuation;
1698: 	spot_attenuation *= 1.0 - pow(spot_rim, cone_attenuation);
1699: 
1700: 	vec3 color = spot_lights[idx].color;
1701: 
1702: 	float size_A = 0.0;
1703: 
1704: 	if (spot_lights[idx].size > 0.0) {
1705: 		float t = spot_lights[idx].size / max(0.001, light_length);
1706: 		size_A = max(0.0, 1.0 - 1.0 / sqrt(1.0 + t * t));
1707: 	}
1708: 
1709: 	spot_attenuation *= shadow;
1710: 
1711: 	light_compute(normal, normalize(light_rel_vec), eye_vec, size_A, color, false, spot_attenuation, f0, roughness, metallic, spot_lights[idx].specular_amount, albedo, alpha, screen_uv,
1712: #ifdef LIGHT_BACKLIGHT_USED
1713: 			backlight,
1714: #endif
1715: #ifdef LIGHT_RIM_USED
1716: 			rim * spot_attenuation, rim_tint,
1717: #endif
1718: #ifdef LIGHT_CLEARCOAT_USED
1719: 			clearcoat, clearcoat_roughness, vertex_normal,
1720: #endif
1721: #ifdef LIGHT_ANISOTROPY_USED
1722: 			binormal, tangent, anisotropy,
1723: #endif
1724: 			diffuse_light, specular_light);
1725: }
1726: #endif // !defined(DISABLE_LIGHT_SPOT) || defined(ADDITIVE_SPOT)
1727: 
1728: #endif // !defined(DISABLE_LIGHT_DIRECTIONAL) || !defined(DISABLE_LIGHT_OMNI) || !defined(DISABLE_LIGHT_SPOT)
1729: #endif // !USE_VERTEX_LIGHTING
