110: vec3 tonemap_filmic(vec3 color) {
111: 	// These constants must match the those in the C++ code that calculates the parameters.
112: 	// exposure_bias: Input scale (color *= bias, env->white *= bias) to make the brightness consistent with other tonemappers.
113: 	// Also useful to scale the input to the range that the tonemapper is designed for (some require very high input values).
114: 	// Has no effect on the curve's general shape or visual properties.
115: 	const float exposure_bias = 2.0f;
116: 	const float A = 0.22f * exposure_bias * exposure_bias; // bias baked into constants for performance
117: 	const float B = 0.30f * exposure_bias;
118: 	const float C = 0.10f;
119: 	const float D = 0.20f;
120: 	const float E = 0.01f;
121: 	const float F = 0.30f;
122: 
123: 	vec3 color_tonemapped = ((color * (A * color + C * B) + D * E) / (color * (A * color + B) + D * F)) - E / F;
124: 
125: 	return color_tonemapped / tonemapper_params.x;
126: }
