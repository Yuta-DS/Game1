1002: 				m_layer_index=((m_dus_region_map[((m_pos.y * m_dus_region_map_size) + m_pos.x)] * m_bounds) - 1);
1003: 			}
1004: ;
1005: 			}
1006: 		}
1007: ;
1008: 		}
1009: return ivec3(ivec2(mod(m_r_uv, m_dus_region_size)), m_layer_index);	}
