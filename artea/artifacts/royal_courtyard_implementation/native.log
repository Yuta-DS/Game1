1668: #if !defined(DISABLE_LIGHT_SPOT) || defined(ADDITIVE_SPOT)
1669: void light_process_spot(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 f0, float roughness, float metallic, float shadow, vec3 albedo, inout float alpha, vec2 screen_uv,
1670: #ifdef LIGHT_BACKLIGHT_USED
1671: 		vec3 backlight,
1672: #endif
1673: #ifdef LIGHT_RIM_USED
1674: 		float rim, float rim_tint,
1675: #endif
1676: #ifdef LIGHT_CLEARCOAT_USED
1677: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1678: #endif
1679: #ifdef LIGHT_ANISOTROPY_USED
1680: 		vec3 binormal, vec3 tangent, float anisotropy,
1681: #endif
1682: 		inout vec3 diffuse_light,
1683: 		inout vec3 specular_light) {
1684: 
1685: 	vec3 light_rel_vec = spot_lights[idx].position - vertex;
1686: 	float light_length = length(light_rel_vec);
1687: 	float spot_attenuation = get_omni_spot_attenuation(light_length, spot_lights[idx].inv_radius, spot_lights[idx].attenuation);
1688: 	vec3 spot_dir = spot_lights[idx].direction;
1689: 	float scos = max(dot(-normalize(light_rel_vec), spot_dir), spot_lights[idx].cone_angle);
1690: 	float spot_rim = max(0.0001, (1.0 - scos) / (1.0 - spot_lights[idx].cone_angle));
1691: 
1692: 	mediump float cone_attenuation = spot_lights[idx].cone_attenuation;
1693: 	spot_attenuation *= 1.0 - pow(spot_rim, cone_attenuation);
1694: 
1695: 	vec3 color = spot_lights[idx].color;
1696: 
1697: 	float size_A = 0.0;
1698: 
1699: 	if (spot_lights[idx].size > 0.0) {
1700: 		float t = spot_lights[idx].size / max(0.001, light_length);
1701: 		size_A = max(0.0, 1.0 - 1.0 / sqrt(1.0 + t * t));
1702: 	}
1703: 
1704: 	spot_attenuation *= shadow;
1705: 
1706: 	light_compute(normal, normalize(light_rel_vec), eye_vec, size_A, color, false, spot_attenuation, f0, roughness, metallic, spot_lights[idx].specular_amount, albedo, alpha, screen_uv,
1707: #ifdef LIGHT_BACKLIGHT_USED
1708: 			backlight,
1709: #endif
1710: #ifdef LIGHT_RIM_USED
1711: 			rim * spot_attenuation, rim_tint,
1712: #endif
1713: #ifdef LIGHT_CLEARCOAT_USED
1714: 			clearcoat, clearcoat_roughness, vertex_normal,
1715: #endif
1716: #ifdef LIGHT_ANISOTROPY_USED
1717: 			binormal, tangent, anisotropy,
1718: #endif
1719: 			diffuse_light, specular_light);
1720: }
1721: #endif // !defined(DISABLE_LIGHT_SPOT) || defined(ADDITIVE_SPOT)
