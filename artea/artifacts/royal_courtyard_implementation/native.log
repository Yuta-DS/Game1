1730: vec4 fog_process(vec3 vertex) {
1731: 	vec3 fog_color = scene_data_block.data.fog_light_color;
1732: 
1733: #ifdef USE_RADIANCE_MAP
1734: /*
1735: 		if (scene_data_block.data.fog_aerial_perspective > 0.0) {
1736: 		vec3 sky_fog_color = vec3(0.0);
1737: 		vec3 cube_view = scene_data_block.data.radiance_inverse_xform * vertex;
1738: 		// mip_level always reads from the second mipmap and higher so the fog is always slightly blurred
1739: 		float mip_level = mix(1.0 / MAX_ROUGHNESS_LOD, 1.0, 1.0 - (abs(vertex.z) - scene_data_block.data.z_near) / (scene_data_block.data.z_far - scene_data_block.data.z_near));
1740: 
1741: 		sky_fog_color = textureLod(radiance_map, cube_view, mip_level * RADIANCE_MAX_LOD).rgb;
1742: 
1743: 		fog_color = mix(fog_color, sky_fog_color, scene_data_block.data.fog_aerial_perspective);
1744: 	}
1745: 	*/
1746: #endif
1747: 
1748: #ifdef USE_SUN_SCATTER
1749: 	vec4 sun_scatter = vec4(0.0);
1750: 	float sun_total = 0.0;
1751: 	vec3 view = normalize(vertex);
1752: 	for (uint i = uint(0); i < scene_data_block.data.directional_light_count; i++) {
1753: 		vec3 light_color = directional_lights[i].color * directional_lights[i].energy;
1754: 		float light_amount = pow(max(dot(view, directional_lights[i].direction), 0.0), 8.0);
1755: 		fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
1756: 	}
1757: 	for (uint i = uint(MAX_DIRECTIONAL_LIGHT_DATA_STRUCTS) - uint(scene_data_block.data.directional_shadow_count); i < uint(MAX_DIRECTIONAL_LIGHT_DATA_STRUCTS); i++) {
1758: 		vec3 light_color = directional_lights[i].color * directional_lights[i].energy;
1759: 		float light_amount = pow(max(dot(view, directional_lights[i].direction), 0.0), 8.0);
1760: 		fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
1761: 	}
1762: #endif // USE_SUN_SCATTER
1763: 
1764: 	float fog_amount = 0.0;
1765: 
1766: #ifdef USE_DEPTH_FOG
1767: 	float fog_z = smoothstep(scene_data_block.data.fog_depth_begin, scene_data_block.data.fog_depth_end, length(vertex));
1768: 	fog_amount = pow(fog_z, scene_data_block.data.fog_depth_curve) * scene_data_block.data.fog_density;
1769: #else
1770: 	fog_amount = 1.0 - exp(min(0.0, -length(vertex) * scene_data_block.data.fog_density));
1771: #endif // USE_DEPTH_FOG
1772: 
1773: 	if (abs(scene_data_block.data.fog_height_density) >= 0.0001) {
1774: 		float y = (scene_data_block.data.inv_view_matrix * vec4(vertex, 1.0)).y;
1775: 
1776: 		float y_dist = y - scene_data_block.data.fog_height;
1777: 
1778: 		float vfog_amount = 1.0 - exp(min(0.0, y_dist * scene_data_block.data.fog_height_density));
1779: 
1780: 		fog_amount = max(vfog_amount, fog_amount);
1781: 	}
1782: 
1783: 	return vec4(fog_color, fog_amount);
1784: }
1785: 
1786: #ifndef DISABLE_REFLECTION_PROBE
1787: 
1788: #define REFLECTION_AMBIENT_DISABLED 0
1789: #define REFLECTION_AMBIENT_ENVIRONMENT 1
1790: #define REFLECTION_AMBIENT_COLOR 2
1791: 
1792: void reflection_process(samplerCube reflection_map,
1793: 		vec3 normal, vec3 vertex,
1794: 		mat4 local_matrix,
1795: 		bool use_box_project, vec3 box_extents, vec3 box_offset,
1796: 		bool exterior, float intensity, float blend_distance, int ref_ambient_mode, vec4 ref_ambient_color,
1797: 		float roughness, vec3 ambient, vec3 skybox,
1798: 		inout highp vec4 reflection_accum, inout highp vec4 ambient_accum) {
1799: 	vec4 reflection;
1800: 
1801: 	vec3 local_pos = (local_matrix * vec4(vertex, 1.0)).xyz;
1802: 
1803: 	if (any(greaterThan(abs(local_pos), box_extents))) { //out of the reflection box
1804: 		return;
1805: 	}
1806: 
1807: 	float blend = 1.0;
1808: 	if (blend_distance != 0.0) {
1809: 		vec3 axis_blend_distance = min(vec3(blend_distance), box_extents);
1810: 		vec3 blend_axes = abs(local_pos) - box_extents + axis_blend_distance;
1811: 		blend_axes /= axis_blend_distance;
1812: 		blend_axes = clamp(1.0 - blend_axes, vec3(0.0), vec3(1.0));
1813: 
1814: 		blend = pow(blend_axes.x * blend_axes.y * blend_axes.z, 2.0);
1815: 	}
1816: 
1817: 	//reflect and make local
1818: 	vec3 ref_normal = normalize(reflect(vertex, normal));
1819: 	ref_normal = (local_matrix * vec4(ref_normal, 0.0)).xyz;
1820: 
1821: 	if (use_box_project) { //box project
1822: 
1823: 		vec3 nrdir = normalize(ref_normal);
1824: 		vec3 rbmax = (box_extents - local_pos) / nrdir;
1825: 		vec3 rbmin = (-box_extents - local_pos) / nrdir;
1826: 
1827: 		vec3 rbminmax = mix(rbmin, rbmax, vec3(greaterThan(nrdir, vec3(0.0, 0.0, 0.0))));
1828: 
1829: 		float fa = min(min(rbminmax.x, rbminmax.y), rbminmax.z);
1830: 		vec3 posonbox = local_pos + nrdir * fa;
1831: 		ref_normal = posonbox - box_offset.xyz;
1832: 	}
1833: 
1834: 	reflection.rgb = srgb_to_linear(textureLod(reflection_map, ref_normal, roughness * MAX_ROUGHNESS_LOD).rgb);
1835: 
1836: 	if (exterior) {
1837: 		reflection.rgb = mix(skybox, reflection.rgb, blend);
1838: 	}
1839: 	reflection.rgb *= intensity;
1840: 	reflection.a = blend;
1841: 	reflection.rgb *= blend;
1842: 
1843: 	reflection_accum += reflection;
1844: 
1845: #ifndef USE_LIGHTMAP
1846: 	if (ref_ambient_mode == REFLECTION_AMBIENT_ENVIRONMENT) {
1847: 		vec4 ambient_out;
1848: 		vec3 amb_normal = (local_matrix * vec4(normal, 0.0)).xyz;
1849: 
1850: 		ambient_out.rgb = srgb_to_linear(textureLod(reflection_map, amb_normal, MAX_ROUGHNESS_LOD).rgb);
1851: 		if (exterior) {
1852: 			ambient_out.rgb = mix(ambient, ambient_out.rgb, blend);
