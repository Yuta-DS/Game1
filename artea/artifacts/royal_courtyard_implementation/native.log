1236: #if !defined(DISABLE_LIGHT_OMNI) || defined(ADDITIVE_OMNI)
1237: void light_process_omni(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 f0, float roughness, float metallic, float shadow, vec3 albedo, inout float alpha, vec2 screen_uv,
1238: #ifdef LIGHT_BACKLIGHT_USED
1239: 		vec3 backlight,
1240: #endif
1241: #ifdef LIGHT_RIM_USED
1242: 		float rim, float rim_tint,
1243: #endif
1244: #ifdef LIGHT_CLEARCOAT_USED
1245: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1246: #endif
1247: #ifdef LIGHT_ANISOTROPY_USED
1248: 		vec3 binormal, vec3 tangent, float anisotropy,
1249: #endif
1250: 		inout vec3 diffuse_light, inout vec3 specular_light) {
1251: 	vec3 light_rel_vec = omni_lights[idx].position - vertex;
1252: 	float light_length = length(light_rel_vec);
1253: 	float omni_attenuation = get_omni_spot_attenuation(light_length, omni_lights[idx].inv_radius, omni_lights[idx].attenuation);
1254: 	vec3 color = omni_lights[idx].color;
1255: 	float size_A = 0.0;
1256: 
1257: 	if (omni_lights[idx].size > 0.0) {
1258: 		float t = omni_lights[idx].size / max(0.001, light_length);
1259: 		size_A = max(0.0, 1.0 - 1.0 / sqrt(1.0 + t * t));
1260: 	}
1261: 
1262: 	omni_attenuation *= shadow;
1263: 
1264: 	light_compute(normal, normalize(light_rel_vec), eye_vec, size_A, color, false, omni_attenuation, f0, roughness, metallic, omni_lights[idx].specular_amount, albedo, alpha, screen_uv,
1265: #ifdef LIGHT_BACKLIGHT_USED
1266: 			backlight,
1267: #endif
1268: #ifdef LIGHT_RIM_USED
1269: 			rim * omni_attenuation, rim_tint,
1270: #endif
1271: #ifdef LIGHT_CLEARCOAT_USED
1272: 			clearcoat, clearcoat_roughness, vertex_normal,
1273: #endif
1274: #ifdef LIGHT_ANISOTROPY_USED
1275: 			binormal, tangent, anisotropy,
1276: #endif
1277: 			diffuse_light,
1278: 			specular_light);
1279: }
1280: #endif // !DISABLE_LIGHT_OMNI
