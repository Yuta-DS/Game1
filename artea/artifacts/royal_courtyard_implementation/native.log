1726: vec4 fog_process(vec3 vertex) {
1727: 	vec3 fog_color = scene_data_block.data.fog_light_color;
1728: 
1729: #ifdef USE_RADIANCE_MAP
1730: /*
1731: 		if (scene_data_block.data.fog_aerial_perspective > 0.0) {
1732: 		vec3 sky_fog_color = vec3(0.0);
1733: 		vec3 cube_view = scene_data_block.data.radiance_inverse_xform * vertex;
1734: 		// mip_level always reads from the second mipmap and higher so the fog is always slightly blurred
1735: 		float mip_level = mix(1.0 / MAX_ROUGHNESS_LOD, 1.0, 1.0 - (abs(vertex.z) - scene_data_block.data.z_near) / (scene_data_block.data.z_far - scene_data_block.data.z_near));
1736: 
1737: 		sky_fog_color = textureLod(radiance_map, cube_view, mip_level * RADIANCE_MAX_LOD).rgb;
1738: 
1739: 		fog_color = mix(fog_color, sky_fog_color, scene_data_block.data.fog_aerial_perspective);
1740: 	}
1741: 	*/
1742: #endif
1743: 
1744: #ifdef USE_SUN_SCATTER
1745: 	vec4 sun_scatter = vec4(0.0);
1746: 	float sun_total = 0.0;
1747: 	vec3 view = normalize(vertex);
1748: 	for (uint i = uint(0); i < scene_data_block.data.directional_light_count; i++) {
1749: 		vec3 light_color = directional_lights[i].color * directional_lights[i].energy;
1750: 		float light_amount = pow(max(dot(view, directional_lights[i].direction), 0.0), 8.0);
1751: 		fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
1752: 	}
1753: 	for (uint i = uint(MAX_DIRECTIONAL_LIGHT_DATA_STRUCTS) - uint(scene_data_block.data.directional_shadow_count); i < uint(MAX_DIRECTIONAL_LIGHT_DATA_STRUCTS); i++) {
1754: 		vec3 light_color = directional_lights[i].color * directional_lights[i].energy;
1755: 		float light_amount = pow(max(dot(view, directional_lights[i].direction), 0.0), 8.0);
1756: 		fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
1757: 	}
1758: #endif // USE_SUN_SCATTER
1759: 
1760: 	float fog_amount = 0.0;
1761: 
1762: #ifdef USE_DEPTH_FOG
1763: 	float fog_z = smoothstep(scene_data_block.data.fog_depth_begin, scene_data_block.data.fog_depth_end, length(vertex));
1764: 	fog_amount = pow(fog_z, scene_data_block.data.fog_depth_curve) * scene_data_block.data.fog_density;
1765: #else
1766: 	fog_amount = 1.0 - exp(min(0.0, -length(vertex) * scene_data_block.data.fog_density));
1767: #endif // USE_DEPTH_FOG
1768: 
1769: 	if (abs(scene_data_block.data.fog_height_density) >= 0.0001) {
1770: 		float y = (scene_data_block.data.inv_view_matrix * vec4(vertex, 1.0)).y;
1771: 
1772: 		float y_dist = y - scene_data_block.data.fog_height;
1773: 
1774: 		float vfog_amount = 1.0 - exp(min(0.0, y_dist * scene_data_block.data.fog_height_density));
1775: 
1776: 		fog_amount = max(vfog_amount, fog_amount);
1777: 	}
1778: 
1779: 	return vec4(fog_color, fog_amount);
1780: }
