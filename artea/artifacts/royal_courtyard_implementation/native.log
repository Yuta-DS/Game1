153: // allenwp tonemapping curve; developed for use in the Godot game engine.
154: // Source and details: https://allenwp.com/blog/2025/05/29/allenwp-tonemapping-curve/
155: // Input must be a non-negative linear scene value.
156: vec3 allenwp_curve(vec3 x) {
157: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
158: 
159: 	// These constants must match the those in the C++ code that calculates the parameters.
160: 	// 18% "middle gray" is perceptually 50% of the brightness of reference white.
161: 	const float awp_crossover_point = 0.18;
162: 	// When output_max_value and/or awp_crossover_point are no longer constant,
163: 	// awp_shoulder_max can be calculated on the CPU and passed in as tonemap_e.
164: 	const float awp_shoulder_max = output_max_value - awp_crossover_point;
165: 
166: 	float awp_contrast = tonemapper_params.x;
167: 	float awp_toe_a = tonemapper_params.y;
168: 	float awp_slope = tonemapper_params.z;
169: 	float awp_w = tonemapper_params.w;
170: 
171: 	// Reinhard-like shoulder:
172: 	vec3 s = x - awp_crossover_point;
173: 	vec3 slope_s = awp_slope * s;
174: 	s = slope_s * (1.0 + s / awp_w) / (1.0 + (slope_s / awp_shoulder_max));
175: 	s += awp_crossover_point;
176: 
177: 	// Sigmoid power function toe:
178: 	vec3 t = pow(x, vec3(awp_contrast));
179: 	t = t / (t + awp_toe_a);
180: 
181: 	return mix(s, t, lessThan(x, vec3(awp_crossover_point)));
182: }
