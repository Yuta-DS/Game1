752: float sample_shadow(highp sampler2DShadow shadow, float shadow_pixel_size, vec4 pos) {
753: 	// Use textureProjLod with LOD set to 0.0 over textureProj, as textureProj not working correctly on ANGLE with Metal backend.
754: 	// https://github.com/godotengine/godot/issues/93537
755: 	float avg = textureProjLod(shadow, pos, 0.0);
756: #ifdef SHADOW_MODE_PCF_13
757: 	pos /= pos.w;
758: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size * 2.0, 0.0), pos.zw), 0.0);
759: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size * 2.0, 0.0), pos.zw), 0.0);
760: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, shadow_pixel_size * 2.0), pos.zw), 0.0);
761: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, -shadow_pixel_size * 2.0), pos.zw), 0.0);
762: 
763: 	// Early bail if distant samples are fully shaded (or none are shaded) to improve performance.
764: 	if (avg <= 0.000001) {
765: 		// None shaded at all.
766: 		return 0.0;
767: 	} else if (avg >= 4.999999) {
768: 		// All fully shaded.
769: 		return 1.0;
770: 	}
771: 
772: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, 0.0), pos.zw), 0.0);
773: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, 0.0), pos.zw), 0.0);
774: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, shadow_pixel_size), pos.zw), 0.0);
775: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, -shadow_pixel_size), pos.zw), 0.0);
776: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, shadow_pixel_size), pos.zw), 0.0);
777: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, shadow_pixel_size), pos.zw), 0.0);
778: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, -shadow_pixel_size), pos.zw), 0.0);
779: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, -shadow_pixel_size), pos.zw), 0.0);
780: 	return avg * (1.0 / 13.0);
781: #endif
782: 
783: #ifdef SHADOW_MODE_PCF_5
784: 	pos /= pos.w;
785: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, 0.0), pos.zw), 0.0);
786: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, 0.0), pos.zw), 0.0);
787: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, shadow_pixel_size), pos.zw), 0.0);
788: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, -shadow_pixel_size), pos.zw), 0.0);
789: 	return avg * (1.0 / 5.0);
790: 
791: #endif
792: 
793: 	return avg;
794: }
