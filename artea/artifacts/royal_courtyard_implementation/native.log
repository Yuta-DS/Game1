1876: #ifdef LIGHTMAP_BICUBIC_FILTER
1877: // w0, w1, w2, and w3 are the four cubic B-spline basis functions
1878: float w0(float a) {
1879: 	return (1.0 / 6.0) * (a * (a * (-a + 3.0) - 3.0) + 1.0);
1880: }
1881: 
1882: float w1(float a) {
1883: 	return (1.0 / 6.0) * (a * a * (3.0 * a - 6.0) + 4.0);
1884: }
1885: 
1886: float w2(float a) {
1887: 	return (1.0 / 6.0) * (a * (a * (-3.0 * a + 3.0) + 3.0) + 1.0);
1888: }
1889: 
1890: float w3(float a) {
1891: 	return (1.0 / 6.0) * (a * a * a);
1892: }
1893: 
1894: // g0 and g1 are the two amplitude functions
1895: float g0(float a) {
1896: 	return w0(a) + w1(a);
1897: }
1898: 
1899: float g1(float a) {
1900: 	return w2(a) + w3(a);
1901: }
1902: 
1903: // h0 and h1 are the two offset functions
1904: float h0(float a) {
1905: 	return -1.0 + w1(a) / (w0(a) + w1(a));
1906: }
1907: 
1908: float h1(float a) {
1909: 	return 1.0 + w3(a) / (w2(a) + w3(a));
1910: }
1911: 
1912: vec4 textureArray_bicubic(sampler2DArray tex, vec3 uv, vec2 texture_size) {
1913: 	vec2 texel_size = vec2(1.0) / texture_size;
1914: 
1915: 	uv.xy = uv.xy * texture_size + vec2(0.5);
1916: 
1917: 	vec2 iuv = floor(uv.xy);
1918: 	vec2 fuv = fract(uv.xy);
1919: 
1920: 	float g0x = g0(fuv.x);
1921: 	float g1x = g1(fuv.x);
1922: 	float h0x = h0(fuv.x);
1923: 	float h1x = h1(fuv.x);
1924: 	float h0y = h0(fuv.y);
1925: 	float h1y = h1(fuv.y);
1926: 
1927: 	vec2 p0 = (vec2(iuv.x + h0x, iuv.y + h0y) - vec2(0.5)) * texel_size;
1928: 	vec2 p1 = (vec2(iuv.x + h1x, iuv.y + h0y) - vec2(0.5)) * texel_size;
1929: 	vec2 p2 = (vec2(iuv.x + h0x, iuv.y + h1y) - vec2(0.5)) * texel_size;
1930: 	vec2 p3 = (vec2(iuv.x + h1x, iuv.y + h1y) - vec2(0.5)) * texel_size;
1931: 
1932: 	return (g0(fuv.y) * (g0x * texture(tex, vec3(p0, uv.z)) + g1x * texture(tex, vec3(p1, uv.z)))) +
1933: 			(g1(fuv.y) * (g0x * texture(tex, vec3(p2, uv.z)) + g1x * texture(tex, vec3(p3, uv.z))));
1934: }
1935: #endif //LIGHTMAP_BICUBIC_FILTER
