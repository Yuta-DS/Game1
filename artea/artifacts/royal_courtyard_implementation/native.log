1528: // implementation of area lights with Linearly Transformed Cosines (LTC): https://eheitzresearch.wordpress.com/415-2/
1529: void light_process_area(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 f0, float roughness, float metallic, float shadow, vec3 albedo, inout float alpha, vec2 screen_uv,
1530: #ifdef LIGHT_BACKLIGHT_USED
1531: 		vec3 backlight,
1532: #endif
1533: #ifdef LIGHT_RIM_USED
1534: 		float rim, float rim_tint,
1535: #endif
1536: #ifdef LIGHT_CLEARCOAT_USED
1537: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1538: #endif
1539: #ifdef LIGHT_ANISOTROPY_USED
1540: 		vec3 binormal, vec3 tangent, float anisotropy,
1541: #endif
1542: 		inout vec3 diffuse_light, inout vec3 specular_light) {
1543: 	float EPSILON = 1e-7f;
1544: 	vec3 area_width = area_lights[idx].area_width.xyz;
1545: 	vec3 area_height = area_lights[idx].area_height.xyz;
1546: 	vec3 area_direction = area_lights[idx].direction;
1547: 
1548: 	if (dot(area_width, area_width) < EPSILON || dot(area_height, area_height) < EPSILON) { // area is 0
1549: 		return;
1550: 	}
1551: 	if (dot(area_direction, vertex - area_lights[idx].position) <= 0.0) {
1552: 		return; // vertex is behind light
1553: 	}
1554: 
1555: 	float a_len = length(area_width);
1556: 	float b_len = length(area_height);
1557: 	float a_half_len = a_len / 2.0;
1558: 	float b_half_len = b_len / 2.0;
1559: 	vec3 light_center = area_lights[idx].position;
1560: 	vec3 light_to_vert = vertex - light_center;
1561: 	vec3 pos_local_to_light = vec3(dot(light_to_vert, normalize(area_width)), dot(light_to_vert, normalize(area_height)), dot(light_to_vert, -area_direction));
1562: 
1563: 	vec3 closest_point_local_to_light = vec3(clamp(pos_local_to_light.x, -a_half_len, a_half_len), clamp(pos_local_to_light.y, -b_half_len, b_half_len), 0);
1564: 	float dist = length(closest_point_local_to_light - pos_local_to_light);
1565: 
1566: 	vec3 points[4];
1567: 	vec3 h_area_width = area_width / 2.0;
1568: 	vec3 h_area_height = area_height / 2.0;
1569: 	points[0] = area_lights[idx].position - h_area_width - h_area_height - vertex;
1570: 	points[1] = area_lights[idx].position + h_area_width - h_area_height - vertex;
1571: 	points[2] = area_lights[idx].position + h_area_width + h_area_height - vertex;
1572: 	points[3] = area_lights[idx].position - h_area_width + h_area_height - vertex;
1573: 
1574: 	float ltc_diffuse = 0.0;
1575: 	float ltc_specular = 0.0;
1576: 	vec2 ltc_fresnel = vec2(0.0);
1577: 	ltc_evaluate(normal, eye_vec, mat3(1), points, ltc_diffuse);
1578: 	ltc_evaluate_specular(normal, eye_vec, roughness, points, ltc_lut1, ltc_lut2, ltc_specular, ltc_fresnel);
1579: 
1580: 	float f90 = clamp(dot(f0, vec3(50.0 * 0.33)), metallic, 1.0);
1581: 	vec3 fresnel_color = f0 * max(ltc_fresnel.x, 0.0) + (f90 - f0) * max(ltc_fresnel.y, 0.0);
1582: 
1583: 	float light_length = max(0.0, dist);
1584: 	float light_attenuation_raw = get_omni_spot_attenuation(light_length, area_lights[idx].inv_radius, area_lights[idx].attenuation);
1585: 	float light_attenuation_ltc = light_attenuation_raw * light_length * light_length; // solid angle already decreases by inverse square, so attenuation power is 2.0 by default -> subtract 2.0
1586: 
1587: 	vec3 light_color = area_lights[idx].color;
1588: 	light_attenuation_ltc = light_attenuation_ltc * shadow;
1589: 	float light_attenuation = light_attenuation_raw * shadow;
1590: 	float specular_amount = area_lights[idx].specular_amount;
1591: 
1592: #if defined(LIGHT_CODE_USED) && defined(AREA_LIGHT_CODE_USED)
1593: 	// light is written by the light shader
1594: 
1595: 	highp mat4 model_matrix = world_transform;
1596: 	mat4 projection_matrix = scene_data_block.data.projection_matrix;
1597: 	mat4 inv_projection_matrix = scene_data_block.data.inv_projection_matrix;
1598: 
1599: 	vec3 light = (light_center - vertex) / light_length;
1600: 	vec3 view = eye_vec;
1601: 
1602: 	bool is_area = true;
1603: 	vec3 area_diffuse = vec3(ltc_diffuse);
1604: 	vec3 area_specular = ltc_specular * fresnel_color;
1605: 	float attenuation = light_attenuation_ltc;
1606: 
1607: 	/* clang-format off */
1608: 
1609: 
1610: 	/* clang-format on */
1611: 
1612: #else
1613: 	float area = a_len * b_len;
1614: 	float cc_attenuation = 1.0;
1615: 
1616: #if defined(LIGHT_BACKLIGHT_USED) || defined(LIGHT_RIM_USED) || defined(DIFFUSE_TOON) || defined(SPECULAR_TOON)
1617: 	float solid_angle = quad_solid_angle(points);
1618: #endif
1619: 
1620: #if defined(LIGHT_CLEARCOAT_USED)
1621: 	float cc_specular_ltc = 0.0;
1622: 	vec2 cc_fresnel = vec2(0.0);
1623: 	ltc_evaluate_specular(vertex_normal, eye_vec, sqrt(mix(0.001, 0.1, float(clearcoat_roughness))), points, ltc_lut1, ltc_lut2, cc_specular_ltc, cc_fresnel);
1624: 	float Fr = (0.04 * max(cc_fresnel.x, 0.0) + (1.0 - 0.04) * max(cc_fresnel.y, 0.0)) * clearcoat;
1625: 	cc_attenuation = 1.0 - Fr;
1626: 	specular_light += cc_specular_ltc * Fr * light_color * light_attenuation_ltc * specular_amount;
1627: #endif // LIGHT_CLEARCOAT_USED
1628: 
1629: 	if (metallic < 1.0) {
1630: #if defined(DIFFUSE_TOON)
1631: 		float backface_ltc_diffuse = 0.0;
1632: 		ltc_evaluate(vec3(-normal), vec3(eye_vec), mat3(1), points, backface_ltc_diffuse);
1633: 		float NdotL = (ltc_diffuse - backface_ltc_diffuse) / (max(solid_angle, 0.001) / M_PI);
1634: 		float diffuse_brdf_NL = smoothstep(-roughness, max(roughness, 0.01), NdotL) * (1.0 / M_PI);
1635: 		diffuse_light += diffuse_brdf_NL * light_color * area * light_attenuation * cc_attenuation;
1636: #else
1637: 		diffuse_light += ltc_diffuse * light_color * light_attenuation_ltc * cc_attenuation;
1638: #endif // DIFFUSE_TOON
1639: 
1640: #if defined(LIGHT_BACKLIGHT_USED)
1641: 		diffuse_light += light_color * max((solid_angle / M_PI) - ltc_diffuse, 0.0) * backlight * light_attenuation_ltc;
1642: #endif
1643: 	}
1644: 
1645: #if defined(LIGHT_RIM_USED) // same as for point lights
1646: 	float cNdotV = max(dot(normal, eye_vec), 1e-4);
1647: 	float rim_light = pow(max(1e-4, 1.0 - cNdotV), max(0.0, (1.0 - roughness) * 16.0));
1648: 	diffuse_light += rim_light * rim * mix(vec3(1.0), albedo, rim_tint) * light_color * solid_angle * light_attenuation_ltc;
1649: #endif
1650: 
1651: #if defined(SPECULAR_TOON)
1652: 	// If ltc_specular turns out to be not similar enough to RdotV, since its based on GGX, toon shading would need its own lookup-table.
1653: 	float mid = 1.0 - roughness;
1654: 	mid *= mid;
1655: 
1656: 	float RdotV = ltc_specular / (max(solid_angle, 0.001) / (M_PI));
1657: 	float intensity = smoothstep(mid - roughness * 0.5, mid + roughness * 0.5, RdotV) * mid; // should we use specular tex color here?? or diffuse? or white?
1658: 	diffuse_light += intensity * light_color * area * light_attenuation * specular_amount; // write to diffuse_light, as in toon shading you generally want no reflection
1659: #elif defined(SPECULAR_DISABLED)
1660: 	// do nothing
1661: #else
1662: 	vec3 spec = ltc_specular * light_color * fresnel_color;
1663: 	specular_light += spec * specular_amount * light_attenuation_ltc * cc_attenuation;
1664: #endif // SPECULAR_TOON
1665: #endif // LIGHT_CODE_USED
1666: }
1667: #endif // !DISABLE_LIGHT_AREA
