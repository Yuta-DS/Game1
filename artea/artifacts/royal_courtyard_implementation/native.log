157: // allenwp tonemapping curve; developed for use in the Godot game engine.
158: // Source and details: https://allenwp.com/blog/2025/05/29/allenwp-tonemapping-curve/
159: // Input must be a non-negative linear scene value.
160: vec3 allenwp_curve(vec3 x) {
161: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
162: 
163: 	// These constants must match the those in the C++ code that calculates the parameters.
164: 	// 18% "middle gray" is perceptually 50% of the brightness of reference white.
165: 	const float awp_crossover_point = 0.18;
166: 	// When output_max_value and/or awp_crossover_point are no longer constant,
167: 	// awp_shoulder_max can be calculated on the CPU and passed in as tonemap_e.
168: 	const float awp_shoulder_max = output_max_value - awp_crossover_point;
169: 
170: 	float awp_contrast = tonemapper_params.x;
171: 	float awp_toe_a = tonemapper_params.y;
172: 	float awp_slope = tonemapper_params.z;
173: 	float awp_w = tonemapper_params.w;
174: 
175: 	// Reinhard-like shoulder:
176: 	vec3 s = x - awp_crossover_point;
177: 	vec3 slope_s = awp_slope * s;
178: 	s = slope_s * (1.0 + s / awp_w) / (1.0 + (slope_s / awp_shoulder_max));
179: 	s += awp_crossover_point;
180: 
181: 	// Sigmoid power function toe:
182: 	vec3 t = pow(x, vec3(awp_contrast));
183: 	t = t / (t + awp_toe_a);
184: 
185: 	return mix(s, t, lessThan(x, vec3(awp_crossover_point)));
186: }
