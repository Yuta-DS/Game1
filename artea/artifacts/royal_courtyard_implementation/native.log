98: // Based on Reinhard's extended formula, see equation 4 in https://doi.org/cjbgrt
99: vec3 tonemap_reinhard(vec3 color) {
100: 	float white_squared = tonemapper_params.x;
101: 	vec3 white_squared_color = white_squared * color;
102: 	// Equivalent to color * (1 + color / white_squared) / (1 + color)
103: 	return (white_squared_color + color * color) / (white_squared_color + white_squared);
104: }
