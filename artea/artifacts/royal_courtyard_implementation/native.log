240: #define TONEMAPPER_LINEAR 0
241: #define TONEMAPPER_REINHARD 1
242: #define TONEMAPPER_FILMIC 2
243: #define TONEMAPPER_ACES 3
244: #define TONEMAPPER_AGX 4
245: 
246: vec3 apply_tonemapping(vec3 color) { // inputs are LINEAR
247: 	if (tonemapper == TONEMAPPER_LINEAR) {
248: 		return color;
249: 	}
250: 
251: 	// Ensure color values passed to tonemappers are positive.
252: 	// They can be negative in the case of negative lights, which leads to undesired behavior.
253: 	color = max(vec3(0.0), color);
254: 
255: 	if (tonemapper == TONEMAPPER_REINHARD) {
256: 		return tonemap_reinhard(color);
257: 	} else if (tonemapper == TONEMAPPER_FILMIC) {
258: 		return tonemap_filmic(color);
259: 	} else if (tonemapper == TONEMAPPER_ACES) {
260: 		return tonemap_aces(color);
261: 	} else { // TONEMAPPER_AGX
262: 		return tonemap_agx(color);
263: 	}
264: }
265: 
266: #endif // APPLY_TONEMAPPING
267: #endif
268: // Compatibility renames. These are exposed with the "godot_" prefix
269: // to work around two distinct Adreno bugs:
270: // 1. Some Adreno devices expose ES310 functions in ES300 shaders.
271: //    Internally, we must use the "godot_" prefix, but user shaders
272: //    will be mapped automatically.
273: // 2. Adreno 3XX devices have poor implementations of the other packing
274: //    functions, so we just use our own there to keep it simple.
275: 
276: #ifdef USE_HALF2FLOAT
277: // Floating point pack/unpack functions are part of the GLSL ES 300 specification used by web and mobile.
278: // It appears to be safe to expose these on mobile, but when running through ANGLE this appears to break.
279: uint float2half(uint f) {
280: 	uint e = f & uint(0x7f800000);
281: 	if (e <= uint(0x38000000)) {
282: 		return uint(0);
283: 	} else {
284: 		return ((f >> uint(16)) & uint(0x8000)) |
285: 				(((e - uint(0x38000000)) >> uint(13)) & uint(0x7c00)) |
286: 				((f >> uint(13)) & uint(0x03ff));
287: 	}
288: }
289: 
290: uint half2float(uint h) {
291: 	uint h_e = h & uint(0x7c00);
292: 	return ((h & uint(0x8000)) << uint(16)) | uint((h_e >> uint(10)) != uint(0)) * (((h_e + uint(0x1c000)) << uint(13)) | ((h & uint(0x03ff)) << uint(13)));
293: }
294: 
295: uint godot_packHalf2x16(vec2 v) {
296: 	return float2half(floatBitsToUint(v.x)) | float2half(floatBitsToUint(v.y)) << uint(16);
297: }
298: 
299: vec2 godot_unpackHalf2x16(uint v) {
300: 	return vec2(uintBitsToFloat(half2float(v & uint(0xffff))),
301: 			uintBitsToFloat(half2float(v >> uint(16))));
302: }
303: 
304: uint godot_packUnorm2x16(vec2 v) {
305: 	uvec2 uv = uvec2(round(clamp(v, vec2(0.0), vec2(1.0)) * 65535.0));
306: 	return uv.x | uv.y << uint(16);
307: }
308: 
309: vec2 godot_unpackUnorm2x16(uint p) {
310: 	return vec2(float(p & uint(0xffff)), float(p >> uint(16))) * 0.000015259021; // 1.0 / 65535.0 optimization
311: }
312: 
313: uint godot_packSnorm2x16(vec2 v) {
314: 	uvec2 uv = uvec2(round(clamp(v, vec2(-1.0), vec2(1.0)) * 32767.0) + 32767.0);
315: 	return uv.x | uv.y << uint(16);
316: }
317: 
318: vec2 godot_unpackSnorm2x16(uint p) {
319: 	vec2 v = vec2(float(p & uint(0xffff)), float(p >> uint(16)));
320: 	return clamp((v - 32767.0) * vec2(0.00003051851), vec2(-1.0), vec2(1.0));
321: }
322: 
323: #define packHalf2x16 godot_packHalf2x16
324: #define unpackHalf2x16 godot_unpackHalf2x16
325: #define packUnorm2x16 godot_packUnorm2x16
326: #define unpackUnorm2x16 godot_unpackUnorm2x16
327: #define packSnorm2x16 godot_packSnorm2x16
328: #define unpackSnorm2x16 godot_unpackSnorm2x16
329: 
330: #endif // USE_HALF2FLOAT
331: 
332: // Always expose these as they are ES310 functions and not available in ES300 or GLSL 330.
333: 
334: uint godot_packUnorm4x8(vec4 v) {
335: 	uvec4 uv = uvec4(round(clamp(v, vec4(0.0), vec4(1.0)) * 255.0));
336: 	return uv.x | (uv.y << uint(8)) | (uv.z << uint(16)) | (uv.w << uint(24));
337: }
338: 
339: vec4 godot_unpackUnorm4x8(uint p) {
340: 	return vec4(float(p & uint(0xff)), float((p >> uint(8)) & uint(0xff)), float((p >> uint(16)) & uint(0xff)), float(p >> uint(24))) * 0.00392156862; // 1.0 / 255.0
341: }
342: 
343: uint godot_packSnorm4x8(vec4 v) {
344: 	uvec4 uv = uvec4(round(clamp(v, vec4(-1.0), vec4(1.0)) * 127.0) + 127.0);
345: 	return uv.x | uv.y << uint(8) | uv.z << uint(16) | uv.w << uint(24);
346: }
347: 
348: vec4 godot_unpackSnorm4x8(uint p) {
349: 	vec4 v = vec4(float(p & uint(0xff)), float((p >> uint(8)) & uint(0xff)), float((p >> uint(16)) & uint(0xff)), float(p >> uint(24)));
350: 	return clamp((v - vec4(127.0)) * vec4(0.00787401574), vec4(-1.0), vec4(1.0));
351: }
352: 
353: #define packUnorm4x8 godot_packUnorm4x8
354: #define unpackUnorm4x8 godot_unpackUnorm4x8
355: #define packSnorm4x8 godot_packSnorm4x8
356: #define unpackSnorm4x8 godot_unpackSnorm4x8
