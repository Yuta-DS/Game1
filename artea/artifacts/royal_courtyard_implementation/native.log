1131: 	// Clearcoat ignores normal_map, use vertex normal instead
1132: 	float ccNdotL = clamp(A + dot(vertex_normal, L), 0.0, 1.0);
1133: 	float ccNdotH = clamp(A + dot(vertex_normal, H), 0.0, 1.0);
1134: 	float cLdotH5 = SchlickFresnel(cLdotH);
1135: 
1136: 	float Dr = D_GGX(ccNdotH, mix(0.001, 0.1, clearcoat_roughness));
1137: 	float Gr = V_Kelemen(cLdotH);
1138: 	float Fr = mix(0.04, 1.0, cLdotH5) * clearcoat;
1139: 	cc_attenuation = 1.0 - Fr;
1140: 	float clearcoat_specular_brdf_NL = Dr * Gr * Fr * ccNdotL;
1141: 
1142: 	specular_light += clearcoat_specular_brdf_NL * light_color * attenuation * specular_amount;
1143: #endif // LIGHT_CLEARCOAT_USED
1144: 
1145: 	if (metallic < 1.0) {
1146: 		float diffuse_brdf_NL; // BRDF times N.L for calculating diffuse radiance
1147: 
1148: #if defined(DIFFUSE_LAMBERT_WRAP)
1149: 		// Energy conserving lambert wrap shader.
1150: 		// https://web.archive.org/web/20210228210901/http://blog.stevemcauley.com/2011/12/03/energy-conserving-wrapped-diffuse/
1151: 		diffuse_brdf_NL = max(0.0, (NdotL + roughness) / ((1.0 + roughness) * (1.0 + roughness))) * (1.0 / M_PI);
1152: #elif defined(DIFFUSE_TOON)
1153: 		diffuse_brdf_NL = smoothstep(-roughness, max(roughness, 0.01), NdotL) * (1.0 / M_PI);
1154: #elif defined(DIFFUSE_BURLEY)
1155: 		{
1156: 			float FD90_minus_1 = 2.0 * cLdotH * cLdotH * roughness - 0.5;
1157: 			float FdV = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotV);
1158: 			float FdL = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotL);
1159: 			diffuse_brdf_NL = (1.0 / M_PI) * FdV * FdL * cNdotL;
1160: 		}
1161: #else
1162: 		// Lambert
1163: 		diffuse_brdf_NL = cNdotL * (1.0 / M_PI);
1164: #endif
1165: 
1166: 		diffuse_light += light_color * diffuse_brdf_NL * attenuation * cc_attenuation;
1167: 
1168: #if defined(LIGHT_BACKLIGHT_USED)
1169: 		diffuse_light += light_color * (vec3(1.0 / M_PI) - diffuse_brdf_NL) * backlight * attenuation * cc_attenuation;
1170: #endif
1171: 
1172: #if defined(LIGHT_RIM_USED)
1173: 		// Epsilon min to prevent pow(0, 0) singularity which results in undefined behavior.
1174: 		float rim_light = pow(max(1e-4, 1.0 - cNdotV), max(0.0, (1.0 - roughness) * 16.0));
1175: 		diffuse_light += rim_light * rim * mix(vec3(1.0), albedo, rim_tint) * light_color;
1176: #endif
1177: 	}
1178: 
1179: 	if (roughness > 0.0) { // FIXME: roughness == 0 should not disable specular light entirely
1180: 
1181: 		// D
1182: 
1183: #if defined(SPECULAR_TOON)
1184: 
1185: 		vec3 R = normalize(-reflect(L, N));
1186: 		float RdotV = dot(R, V);
1187: 		float mid = 1.0 - roughness;
1188: 		mid *= mid;
1189: 		float intensity = smoothstep(mid - roughness * 0.5, mid + roughness * 0.5, RdotV) * mid;
1190: 		diffuse_light += light_color * intensity * attenuation * specular_amount; // write to diffuse_light, as in toon shading you generally want no reflection
1191: 
1192: #elif defined(SPECULAR_DISABLED)
1193: 		// none..
1194: 
1195: #elif defined(SPECULAR_SCHLICK_GGX)
1196: 		// shlick+ggx as default
1197: 		float alpha_ggx = roughness * roughness;
1198: #if defined(LIGHT_ANISOTROPY_USED)
1199: 		float aspect = sqrt(1.0 - anisotropy * 0.9);
1200: 		float ax = alpha_ggx / aspect;
1201: 		float ay = alpha_ggx * aspect;
1202: 		float XdotH = dot(T, H);
1203: 		float YdotH = dot(B, H);
1204: 		float D = D_GGX_anisotropic(cNdotH, ax, ay, XdotH, YdotH);
1205: 		float G = V_GGX_anisotropic(ax, ay, dot(T, V), dot(T, L), dot(B, V), dot(B, L), cNdotV, cNdotL);
1206: #else
1207: 		float D = D_GGX(cNdotH, alpha_ggx);
1208: 		float G = V_GGX(cNdotL, cNdotV, alpha_ggx);
1209: #endif // LIGHT_ANISOTROPY_USED
1210: 	   // F
1211: #if !defined(LIGHT_CLEARCOAT_USED)
1212: 		float cLdotH5 = SchlickFresnel(cLdotH);
1213: #endif
1214: 		// Calculate Fresnel using cheap approximate specular occlusion term from Filament:
1215: 		// https://google.github.io/filament/Filament.html#lighting/occlusion/specularocclusion
1216: 		float f90 = clamp(50.0 * f0.g, 0.0, 1.0);
1217: 		vec3 F = f0 + (f90 - f0) * cLdotH5;
1218: 
1219: 		vec3 specular_brdf_NL = cNdotL * D * F * G;
1220: 
1221: 		specular_light += specular_brdf_NL * light_color * attenuation * cc_attenuation * specular_amount;
1222: #endif
1223: 	}
1224: 
1225: #ifdef USE_SHADOW_TO_OPACITY
1226: 	alpha = min(alpha, clamp(1.0 - attenuation, 0.0, 1.0));
1227: #endif
1228: 
1229: #endif // LIGHT_CODE_USED
1230: }
1231: 
1232: float get_omni_spot_attenuation(float distance, float inv_range, float decay) {
1233: 	float nd = distance * inv_range;
1234: 	nd *= nd;
1235: 	nd *= nd; // nd^4
1236: 	nd = max(1.0 - nd, 0.0);
1237: 	nd *= nd; // nd^2
1238: 	return nd * pow(max(distance, 0.0001), -decay);
1239: }
