226: 	color = rec709_to_rec2020_agx_inset_matrix * color;
227: 
228: 	// Use the allenwp tonemapping curve to match the Blender AgX curve while
229: 	// providing stability across all variable dyanimc range (SDR, HDR, EDR).
230: 	color = allenwp_curve(color);
231: 
232: 	// Clipping to output_max_value is required to address a cyan colour that occurs
233: 	// with very bright inputs.
234: 	color = min(vec3(output_max_value), color);
235: 
236: 	// Apply outset to make the result more chroma-laden and then go back to Rec. 709.
237: 	color = agx_outset_rec2020_to_rec709_matrix * color;
238: 
239: 	// Blender's lusRGB.compensate_low_side is too complex for this shader, so
240: 	// simply return the color, even if it has negative components. These negative
241: 	// components may be useful for subsequent color adjustments.
242: 	return color;
243: }
244: 
245: #define TONEMAPPER_LINEAR 0
246: #define TONEMAPPER_REINHARD 1
247: #define TONEMAPPER_FILMIC 2
248: #define TONEMAPPER_ACES 3
249: #define TONEMAPPER_AGX 4
250: 
251: vec3 apply_tonemapping(vec3 color) { // inputs are LINEAR
252: 	if (tonemapper == TONEMAPPER_LINEAR) {
253: 		return color;
254: 	}
255: 
256: 	// Ensure color values passed to tonemappers are positive.
257: 	// They can be negative in the case of negative lights, which leads to undesired behavior.
258: 	color = max(vec3(0.0), color);
259: 
260: 	if (tonemapper == TONEMAPPER_REINHARD) {
261: 		return tonemap_reinhard(color);
262: 	} else if (tonemapper == TONEMAPPER_FILMIC) {
263: 		return tonemap_filmic(color);
264: 	} else if (tonemapper == TONEMAPPER_ACES) {
265: 		return tonemap_aces(color);
266: 	} else { // TONEMAPPER_AGX
267: 		return tonemap_agx(color);
268: 	}
269: }
270: 
271: #endif // APPLY_TONEMAPPING
272: #endif
273: // Compatibility renames. These are exposed with the "godot_" prefix
274: // to work around two distinct Adreno bugs:
275: // 1. Some Adreno devices expose ES310 functions in ES300 shaders.
276: //    Internally, we must use the "godot_" prefix, but user shaders
277: //    will be mapped automatically.
278: // 2. Adreno 3XX devices have poor implementations of the other packing
279: //    functions, so we just use our own there to keep it simple.
280: 
281: #ifdef USE_HALF2FLOAT
282: // Floating point pack/unpack functions are part of the GLSL ES 300 specification used by web and mobile.
283: // It appears to be safe to expose these on mobile, but when running through ANGLE this appears to break.
284: uint float2half(uint f) {
285: 	uint e = f & uint(0x7f800000);
286: 	if (e <= uint(0x38000000)) {
287: 		return uint(0);
288: 	} else {
289: 		return ((f >> uint(16)) & uint(0x8000)) |
290: 				(((e - uint(0x38000000)) >> uint(13)) & uint(0x7c00)) |
291: 				((f >> uint(13)) & uint(0x03ff));
292: 	}
293: }
294: 
295: uint half2float(uint h) {
296: 	uint h_e = h & uint(0x7c00);
297: 	return ((h & uint(0x8000)) << uint(16)) | uint((h_e >> uint(10)) != uint(0)) * (((h_e + uint(0x1c000)) << uint(13)) | ((h & uint(0x03ff)) << uint(13)));
298: }
299: 
300: uint godot_packHalf2x16(vec2 v) {
301: 	return float2half(floatBitsToUint(v.x)) | float2half(floatBitsToUint(v.y)) << uint(16);
302: }
303: 
304: vec2 godot_unpackHalf2x16(uint v) {
305: 	return vec2(uintBitsToFloat(half2float(v & uint(0xffff))),
306: 			uintBitsToFloat(half2float(v >> uint(16))));
307: }
308: 
309: uint godot_packUnorm2x16(vec2 v) {
310: 	uvec2 uv = uvec2(round(clamp(v, vec2(0.0), vec2(1.0)) * 65535.0));
311: 	return uv.x | uv.y << uint(16);
312: }
313: 
314: vec2 godot_unpackUnorm2x16(uint p) {
315: 	return vec2(float(p & uint(0xffff)), float(p >> uint(16))) * 0.000015259021; // 1.0 / 65535.0 optimization
316: }
317: 
318: uint godot_packSnorm2x16(vec2 v) {
319: 	uvec2 uv = uvec2(round(clamp(v, vec2(-1.0), vec2(1.0)) * 32767.0) + 32767.0);
320: 	return uv.x | uv.y << uint(16);
321: }
322: 
323: vec2 godot_unpackSnorm2x16(uint p) {
324: 	vec2 v = vec2(float(p & uint(0xffff)), float(p >> uint(16)));
325: 	return clamp((v - 32767.0) * vec2(0.00003051851), vec2(-1.0), vec2(1.0));
326: }
327: 
328: #define packHalf2x16 godot_packHalf2x16
329: #define unpackHalf2x16 godot_unpackHalf2x16
330: #define packUnorm2x16 godot_packUnorm2x16
331: #define unpackUnorm2x16 godot_unpackUnorm2x16
332: #define packSnorm2x16 godot_packSnorm2x16
333: #define unpackSnorm2x16 godot_unpackSnorm2x16
334: 
335: #endif // USE_HALF2FLOAT
336: 
337: // Always expose these as they are ES310 functions and not available in ES300 or GLSL 330.
338: 
339: uint godot_packUnorm4x8(vec4 v) {
340: 	uvec4 uv = uvec4(round(clamp(v, vec4(0.0), vec4(1.0)) * 255.0));
341: 	return uv.x | (uv.y << uint(8)) | (uv.z << uint(16)) | (uv.w << uint(24));
342: }
343: 
344: vec4 godot_unpackUnorm4x8(uint p) {
345: 	return vec4(float(p & uint(0xff)), float((p >> uint(8)) & uint(0xff)), float((p >> uint(16)) & uint(0xff)), float(p >> uint(24))) * 0.00392156862; // 1.0 / 255.0
346: }
347: 
348: uint godot_packSnorm4x8(vec4 v) {
349: 	uvec4 uv = uvec4(round(clamp(v, vec4(-1.0), vec4(1.0)) * 127.0) + 127.0);
350: 	return uv.x | uv.y << uint(8) | uv.z << uint(16) | uv.w << uint(24);
351: }
352: 
353: vec4 godot_unpackSnorm4x8(uint p) {
354: 	vec4 v = vec4(float(p & uint(0xff)), float((p >> uint(8)) & uint(0xff)), float((p >> uint(16)) & uint(0xff)), float(p >> uint(24)));
355: 	return clamp((v - vec4(127.0)) * vec4(0.00787401574), vec4(-1.0), vec4(1.0));
356: }
357: 
358: #define packUnorm4x8 godot_packUnorm4x8
359: #define unpackUnorm4x8 godot_unpackUnorm4x8
360: #define packSnorm4x8 godot_packSnorm4x8
361: #define unpackSnorm4x8 godot_unpackSnorm4x8
