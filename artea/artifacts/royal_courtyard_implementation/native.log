1232: float get_omni_spot_attenuation(float distance, float inv_range, float decay) {
1233: 	float nd = distance * inv_range;
1234: 	nd *= nd;
1235: 	nd *= nd; // nd^4
1236: 	nd = max(1.0 - nd, 0.0);
1237: 	nd *= nd; // nd^2
1238: 	return nd * pow(max(distance, 0.0001), -decay);
1239: }
