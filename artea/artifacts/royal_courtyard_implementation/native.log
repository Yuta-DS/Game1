1026: vec3 F0(float metallic, float specular, vec3 albedo) {
1027: 	float dielectric = 0.16 * specular * specular;
1028: 	// use albedo * metallic as colored specular reflectance at 0 angle for metallic materials;
1029: 	// see https://google.github.io/filament/Filament.md.html
1030: 	return mix(vec3(dielectric), albedo, vec3(metallic));
1031: }
