1668: #if !defined(DISABLE_LIGHT_SPOT) || defined(ADDITIVE_SPOT)
1669: void light_process_spot(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 f0, float roughness, float metallic, float shadow, vec3 albedo, inout float alpha, vec2 screen_uv,
1670: #ifdef LIGHT_BACKLIGHT_USED
1671: 		vec3 backlight,
1672: #endif
1673: #ifdef LIGHT_RIM_USED
1674: 		float rim, float rim_tint,
1675: #endif
1676: #ifdef LIGHT_CLEARCOAT_USED
1677: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1678: #endif
1679: #ifdef LIGHT_ANISOTROPY_USED
1680: 		vec3 binormal, vec3 tangent, float anisotropy,
1681: #endif
1682: 		inout vec3 diffuse_light,
1683: 		inout vec3 specular_light) {
1684: 
1685: 	vec3 light_rel_vec = spot_lights[idx].position - vertex;
1686: 	float light_length = length(light_rel_vec);
1687: 	float spot_attenuation = get_omni_spot_attenuation(light_length, spot_lights[idx].inv_radius, spot_lights[idx].attenuation);
1688: 	vec3 spot_dir = spot_lights[idx].direction;
1689: 	float scos = max(dot(-normalize(light_rel_vec), spot_dir), spot_lights[idx].cone_angle);
1690: 	float spot_rim = max(0.0001, (1.0 - scos) / (1.0 - spot_lights[idx].cone_angle));
1691: 
1692: 	mediump float cone_attenuation = spot_lights[idx].cone_attenuation;
1693: 	spot_attenuation *= 1.0 - pow(spot_rim, cone_attenuation);
1694: 
1695: 	vec3 color = spot_lights[idx].color;
1696: 
1697: 	float size_A = 0.0;
1698: 
1699: 	if (spot_lights[idx].size > 0.0) {
1700: 		float t = spot_lights[idx].size / max(0.001, light_length);
1701: 		size_A = max(0.0, 1.0 - 1.0 / sqrt(1.0 + t * t));
1702: 	}
1703: 
1704: 	spot_attenuation *= shadow;
1705: 
1706: 	light_compute(normal, normalize(light_rel_vec), eye_vec, size_A, color, false, spot_attenuation, f0, roughness, metallic, spot_lights[idx].specular_amount, albedo, alpha, screen_uv,
1707: #ifdef LIGHT_BACKLIGHT_USED
1708: 			backlight,
1709: #endif
1710: #ifdef LIGHT_RIM_USED
1711: 			rim * spot_attenuation, rim_tint,
1712: #endif
1713: #ifdef LIGHT_CLEARCOAT_USED
1714: 			clearcoat, clearcoat_roughness, vertex_normal,
1715: #endif
1716: #ifdef LIGHT_ANISOTROPY_USED
1717: 			binormal, tangent, anisotropy,
1718: #endif
1719: 			diffuse_light, specular_light);
1720: }
1721: #endif // !defined(DISABLE_LIGHT_SPOT) || defined(ADDITIVE_SPOT)
1722: 
1723: #endif // !defined(DISABLE_LIGHT_DIRECTIONAL) || !defined(DISABLE_LIGHT_OMNI) || !defined(DISABLE_LIGHT_SPOT)
1724: #endif // !USE_VERTEX_LIGHTING
1725: 
1726: vec4 fog_process(vec3 vertex) {
1727: 	vec3 fog_color = scene_data_block.data.fog_light_color;
1728: 
1729: #ifdef USE_RADIANCE_MAP
1730: /*
1731: 		if (scene_data_block.data.fog_aerial_perspective > 0.0) {
1732: 		vec3 sky_fog_color = vec3(0.0);
1733: 		vec3 cube_view = scene_data_block.data.radiance_inverse_xform * vertex;
1734: 		// mip_level always reads from the second mipmap and higher so the fog is always slightly blurred
1735: 		float mip_level = mix(1.0 / MAX_ROUGHNESS_LOD, 1.0, 1.0 - (abs(vertex.z) - scene_data_block.data.z_near) / (scene_data_block.data.z_far - scene_data_block.data.z_near));
1736: 
1737: 		sky_fog_color = textureLod(radiance_map, cube_view, mip_level * RADIANCE_MAX_LOD).rgb;
1738: 
1739: 		fog_color = mix(fog_color, sky_fog_color, scene_data_block.data.fog_aerial_perspective);
1740: 	}
1741: 	*/
1742: #endif
1743: 
1744: #ifdef USE_SUN_SCATTER
1745: 	vec4 sun_scatter = vec4(0.0);
1746: 	float sun_total = 0.0;
1747: 	vec3 view = normalize(vertex);
1748: 	for (uint i = uint(0); i < scene_data_block.data.directional_light_count; i++) {
1749: 		vec3 light_color = directional_lights[i].color * directional_lights[i].energy;
1750: 		float light_amount = pow(max(dot(view, directional_lights[i].direction), 0.0), 8.0);
1751: 		fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
1752: 	}
1753: 	for (uint i = uint(MAX_DIRECTIONAL_LIGHT_DATA_STRUCTS) - uint(scene_data_block.data.directional_shadow_count); i < uint(MAX_DIRECTIONAL_LIGHT_DATA_STRUCTS); i++) {
1754: 		vec3 light_color = directional_lights[i].color * directional_lights[i].energy;
1755: 		float light_amount = pow(max(dot(view, directional_lights[i].direction), 0.0), 8.0);
1756: 		fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
1757: 	}
1758: #endif // USE_SUN_SCATTER
1759: 
1760: 	float fog_amount = 0.0;
1761: 
1762: #ifdef USE_DEPTH_FOG
1763: 	float fog_z = smoothstep(scene_data_block.data.fog_depth_begin, scene_data_block.data.fog_depth_end, length(vertex));
1764: 	fog_amount = pow(fog_z, scene_data_block.data.fog_depth_curve) * scene_data_block.data.fog_density;
1765: #else
1766: 	fog_amount = 1.0 - exp(min(0.0, -length(vertex) * scene_data_block.data.fog_density));
1767: #endif // USE_DEPTH_FOG
1768: 
1769: 	if (abs(scene_data_block.data.fog_height_density) >= 0.0001) {
1770: 		float y = (scene_data_block.data.inv_view_matrix * vec4(vertex, 1.0)).y;
1771: 
1772: 		float y_dist = y - scene_data_block.data.fog_height;
1773: 
1774: 		float vfog_amount = 1.0 - exp(min(0.0, y_dist * scene_data_block.data.fog_height_density));
1775: 
1776: 		fog_amount = max(vfog_amount, fog_amount);
1777: 	}
1778: 
1779: 	return vec4(fog_color, fog_amount);
1780: }
1781: 
1782: #ifndef DISABLE_REFLECTION_PROBE
1783: 
1784: #define REFLECTION_AMBIENT_DISABLED 0
1785: #define REFLECTION_AMBIENT_ENVIRONMENT 1
1786: #define REFLECTION_AMBIENT_COLOR 2
1787: 
1788: void reflection_process(samplerCube reflection_map,
1789: 		vec3 normal, vec3 vertex,
1790: 		mat4 local_matrix,
1791: 		bool use_box_project, vec3 box_extents, vec3 box_offset,
1792: 		bool exterior, float intensity, float blend_distance, int ref_ambient_mode, vec4 ref_ambient_color,
1793: 		float roughness, vec3 ambient, vec3 skybox,
1794: 		inout highp vec4 reflection_accum, inout highp vec4 ambient_accum) {
1795: 	vec4 reflection;
1796: 
1797: 	vec3 local_pos = (local_matrix * vec4(vertex, 1.0)).xyz;
1798: 
1799: 	if (any(greaterThan(abs(local_pos), box_extents))) { //out of the reflection box
1800: 		return;
1801: 	}
1802: 
1803: 	float blend = 1.0;
1804: 	if (blend_distance != 0.0) {
1805: 		vec3 axis_blend_distance = min(vec3(blend_distance), box_extents);
1806: 		vec3 blend_axes = abs(local_pos) - box_extents + axis_blend_distance;
1807: 		blend_axes /= axis_blend_distance;
1808: 		blend_axes = clamp(1.0 - blend_axes, vec3(0.0), vec3(1.0));
1809: 
1810: 		blend = pow(blend_axes.x * blend_axes.y * blend_axes.z, 2.0);
1811: 	}
1812: 
1813: 	//reflect and make local
1814: 	vec3 ref_normal = normalize(reflect(vertex, normal));
