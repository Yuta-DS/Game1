1032: 
1033: #ifndef USE_VERTEX_LIGHTING
1034: #if !defined(DISABLE_LIGHT_DIRECTIONAL) || !defined(DISABLE_LIGHT_OMNI) || !defined(DISABLE_LIGHT_SPOT) || !defined(DISABLE_LIGHT_AREA) || defined(USE_ADDITIVE_LIGHTING)
1035: 
1036: float D_GGX(float cos_theta_m, float alpha) {
1037: 	float a = cos_theta_m * alpha;
1038: 	float k = alpha / (1.0 - cos_theta_m * cos_theta_m + a * a);
1039: 	return k * k * (1.0 / M_PI);
1040: }
1041: 
1042: // From Earl Hammon, Jr. "PBR Diffuse Lighting for GGX+Smith Microsurfaces" https://www.gdcvault.com/play/1024478/PBR-Diffuse-Lighting-for-GGX
1043: float V_GGX(float NdotL, float NdotV, float alpha) {
1044: 	return 0.5 / mix(2.0 * NdotL * NdotV, NdotL + NdotV, alpha);
1045: }
1046: 
1047: float D_GGX_anisotropic(float cos_theta_m, float alpha_x, float alpha_y, float cos_phi, float sin_phi) {
1048: 	float alpha2 = alpha_x * alpha_y;
1049: 	highp vec3 v = vec3(alpha_y * cos_phi, alpha_x * sin_phi, alpha2 * cos_theta_m);
1050: 	highp float v2 = dot(v, v);
1051: 	float w2 = alpha2 / v2;
1052: 	float D = alpha2 * w2 * w2 * (1.0 / M_PI);
1053: 	return D;
1054: }
1055: 
1056: float V_GGX_anisotropic(float alpha_x, float alpha_y, float TdotV, float TdotL, float BdotV, float BdotL, float NdotV, float NdotL) {
1057: 	float Lambda_V = NdotL * length(vec3(alpha_x * TdotV, alpha_y * BdotV, NdotV));
1058: 	float Lambda_L = NdotV * length(vec3(alpha_x * TdotL, alpha_y * BdotL, NdotL));
1059: 	return 0.5 / (Lambda_V + Lambda_L);
1060: }
1061: 
1062: float SchlickFresnel(float u) {
1063: 	float m = 1.0 - u;
1064: 	float m2 = m * m;
1065: 	return m2 * m2 * m; // pow(m,5)
1066: }
1067: 
1068: float V_Kelemen(float LdotH) {
1069: 	// Kelemen 2001, "A Microfacet Based Coupled Specular-Matte BRDF Model with Importance Sampling"
1070: 	return 0.25 / (LdotH * LdotH + 1e-4);
1071: }
1072: 
1073: void light_compute(vec3 N, vec3 L, vec3 V, float A, vec3 light_color, bool is_directional, float attenuation, vec3 f0, float roughness, float metallic, float specular_amount, vec3 albedo, inout float alpha, vec2 screen_uv,
1074: #ifdef LIGHT_BACKLIGHT_USED
1075: 		vec3 backlight,
1076: #endif
1077: #ifdef LIGHT_RIM_USED
1078: 		float rim, float rim_tint,
1079: #endif
1080: #ifdef LIGHT_CLEARCOAT_USED
1081: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1082: #endif
1083: #ifdef LIGHT_ANISOTROPY_USED
1084: 		vec3 B, vec3 T, float anisotropy,
1085: #endif
1086: 		inout vec3 diffuse_light, inout vec3 specular_light) {
1087: 
1088: #if defined(LIGHT_CODE_USED)
1089: 	// light is written by the light shader
1090: 
1091: 	highp mat4 model_matrix = world_transform;
1092: 	mat4 projection_matrix = scene_data_block.data.projection_matrix;
1093: 	mat4 inv_projection_matrix = scene_data_block.data.inv_projection_matrix;
1094: 
1095: 	vec3 normal = N;
1096: 	vec3 light = L;
1097: 	vec3 view = V;
1098: 	bool is_area = false;
1099: 	float area_diffuse = 1.0;
1100: 	float area_specular = 1.0;
1101: 	vec3 area_diffuse_tex_color = vec3(1.0);
1102: 	vec3 area_specular_tex_color = vec3(1.0);
1103: 
1104: 	/* clang-format off */
1105: 
1106: 
1107: 	/* clang-format on */
1108: 
1109: #else
1110: 	float NdotL = min(A + dot(N, L), 1.0);
1111: 	float cNdotL = max(NdotL, 0.0); // clamped NdotL
1112: 	float NdotV = dot(N, V);
1113: 	float cNdotV = max(NdotV, 1e-4);
1114: 
1115: 	float cc_attenuation = 1.0;
1116: 
1117: #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1118: 	vec3 H = normalize(V + L);
1119: #endif
1120: 
1121: #if defined(SPECULAR_SCHLICK_GGX)
1122: 	float cNdotH = clamp(A + dot(N, H), 0.0, 1.0);
1123: #endif
1124: 
1125: #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1126: 	float cLdotH = clamp(A + dot(L, H), 0.0, 1.0);
1127: #endif
1128: 
1129: #if defined(LIGHT_CLEARCOAT_USED)
1130: 	// Clearcoat ignores normal_map, use vertex normal instead
1131: 	float ccNdotL = clamp(A + dot(vertex_normal, L), 0.0, 1.0);
1132: 	float ccNdotH = clamp(A + dot(vertex_normal, H), 0.0, 1.0);
1133: 	float cLdotH5 = SchlickFresnel(cLdotH);
1134: 
1135: 	float Dr = D_GGX(ccNdotH, mix(0.001, 0.1, clearcoat_roughness));
1136: 	float Gr = V_Kelemen(cLdotH);
1137: 	float Fr = mix(0.04, 1.0, cLdotH5) * clearcoat;
1138: 	cc_attenuation = 1.0 - Fr;
1139: 	float clearcoat_specular_brdf_NL = Dr * Gr * Fr * ccNdotL;
1140: 
1141: 	specular_light += clearcoat_specular_brdf_NL * light_color * attenuation * specular_amount;
1142: #endif // LIGHT_CLEARCOAT_USED
1143: 
1144: 	if (metallic < 1.0) {
1145: 		float diffuse_brdf_NL; // BRDF times N.L for calculating diffuse radiance
1146: 
1147: #if defined(DIFFUSE_LAMBERT_WRAP)
1148: 		// Energy conserving lambert wrap shader.
1149: 		// https://web.archive.org/web/20210228210901/http://blog.stevemcauley.com/2011/12/03/energy-conserving-wrapped-diffuse/
1150: 		diffuse_brdf_NL = max(0.0, (NdotL + roughness) / ((1.0 + roughness) * (1.0 + roughness))) * (1.0 / M_PI);
1151: #elif defined(DIFFUSE_TOON)
1152: 		diffuse_brdf_NL = smoothstep(-roughness, max(roughness, 0.01), NdotL) * (1.0 / M_PI);
1153: #elif defined(DIFFUSE_BURLEY)
1154: 		{
1155: 			float FD90_minus_1 = 2.0 * cLdotH * cLdotH * roughness - 0.5;
1156: 			float FdV = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotV);
1157: 			float FdL = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotL);
1158: 			diffuse_brdf_NL = (1.0 / M_PI) * FdV * FdL * cNdotL;
1159: 		}
1160: #else
1161: 		// Lambert
1162: 		diffuse_brdf_NL = cNdotL * (1.0 / M_PI);
1163: #endif
1164: 
1165: 		diffuse_light += light_color * diffuse_brdf_NL * attenuation * cc_attenuation;
1166: 
1167: #if defined(LIGHT_BACKLIGHT_USED)
1168: 		diffuse_light += light_color * (vec3(1.0 / M_PI) - diffuse_brdf_NL) * backlight * attenuation * cc_attenuation;
1169: #endif
1170: 
1171: #if defined(LIGHT_RIM_USED)
1172: 		// Epsilon min to prevent pow(0, 0) singularity which results in undefined behavior.
1173: 		float rim_light = pow(max(1e-4, 1.0 - cNdotV), max(0.0, (1.0 - roughness) * 16.0));
1174: 		diffuse_light += rim_light * rim * mix(vec3(1.0), albedo, rim_tint) * light_color;
1175: #endif
1176: 	}
1177: 
1178: 	if (roughness > 0.0) { // FIXME: roughness == 0 should not disable specular light entirely
1179: 
1180: 		// D
1181: 
1182: #if defined(SPECULAR_TOON)
1183: 
1184: 		vec3 R = normalize(-reflect(L, N));
1185: 		float RdotV = dot(R, V);
1186: 		float mid = 1.0 - roughness;
1187: 		mid *= mid;
1188: 		float intensity = smoothstep(mid - roughness * 0.5, mid + roughness * 0.5, RdotV) * mid;
1189: 		diffuse_light += light_color * intensity * attenuation * specular_amount; // write to diffuse_light, as in toon shading you generally want no reflection
1190: 
1191: #elif defined(SPECULAR_DISABLED)
1192: 		// none..
1193: 
1194: #elif defined(SPECULAR_SCHLICK_GGX)
1195: 		// shlick+ggx as default
1196: 		float alpha_ggx = roughness * roughness;
1197: #if defined(LIGHT_ANISOTROPY_USED)
1198: 		float aspect = sqrt(1.0 - anisotropy * 0.9);
1199: 		float ax = alpha_ggx / aspect;
1200: 		float ay = alpha_ggx * aspect;
1201: 		float XdotH = dot(T, H);
1202: 		float YdotH = dot(B, H);
1203: 		float D = D_GGX_anisotropic(cNdotH, ax, ay, XdotH, YdotH);
1204: 		float G = V_GGX_anisotropic(ax, ay, dot(T, V), dot(T, L), dot(B, V), dot(B, L), cNdotV, cNdotL);
1205: #else
1206: 		float D = D_GGX(cNdotH, alpha_ggx);
1207: 		float G = V_GGX(cNdotL, cNdotV, alpha_ggx);
1208: #endif // LIGHT_ANISOTROPY_USED
1209: 	   // F
1210: #if !defined(LIGHT_CLEARCOAT_USED)
1211: 		float cLdotH5 = SchlickFresnel(cLdotH);
1212: #endif
1213: 		// Calculate Fresnel using cheap approximate specular occlusion term from Filament:
1214: 		// https://google.github.io/filament/Filament.html#lighting/occlusion/specularocclusion
1215: 		float f90 = clamp(50.0 * f0.g, 0.0, 1.0);
1216: 		vec3 F = f0 + (f90 - f0) * cLdotH5;
1217: 
1218: 		vec3 specular_brdf_NL = cNdotL * D * F * G;
1219: 
1220: 		specular_light += specular_brdf_NL * light_color * attenuation * cc_attenuation * specular_amount;
1221: #endif
1222: 	}
1223: 
1224: #ifdef USE_SHADOW_TO_OPACITY
1225: 	alpha = min(alpha, clamp(1.0 - attenuation, 0.0, 1.0));
1226: #endif
1227: 
1228: #endif // LIGHT_CODE_USED
1229: }
1230: 
1231: float get_omni_spot_attenuation(float distance, float inv_range, float decay) {
1232: 	float nd = distance * inv_range;
1233: 	nd *= nd;
1234: 	nd *= nd; // nd^4
1235: 	nd = max(1.0 - nd, 0.0);
1236: 	nd *= nd; // nd^2
1237: 	return nd * pow(max(distance, 0.0001), -decay);
1238: }
