1030: #ifndef USE_VERTEX_LIGHTING
1031: #if !defined(DISABLE_LIGHT_DIRECTIONAL) || !defined(DISABLE_LIGHT_OMNI) || !defined(DISABLE_LIGHT_SPOT) || !defined(DISABLE_LIGHT_AREA) || defined(USE_ADDITIVE_LIGHTING)
1032: 
1033: float D_GGX(float cos_theta_m, float alpha) {
1034: 	float a = cos_theta_m * alpha;
1035: 	float k = alpha / (1.0 - cos_theta_m * cos_theta_m + a * a);
1036: 	return k * k * (1.0 / M_PI);
1037: }
1038: 
1039: // From Earl Hammon, Jr. "PBR Diffuse Lighting for GGX+Smith Microsurfaces" https://www.gdcvault.com/play/1024478/PBR-Diffuse-Lighting-for-GGX
1040: float V_GGX(float NdotL, float NdotV, float alpha) {
1041: 	return 0.5 / mix(2.0 * NdotL * NdotV, NdotL + NdotV, alpha);
1042: }
1043: 
1044: float D_GGX_anisotropic(float cos_theta_m, float alpha_x, float alpha_y, float cos_phi, float sin_phi) {
1045: 	float alpha2 = alpha_x * alpha_y;
1046: 	highp vec3 v = vec3(alpha_y * cos_phi, alpha_x * sin_phi, alpha2 * cos_theta_m);
1047: 	highp float v2 = dot(v, v);
1048: 	float w2 = alpha2 / v2;
1049: 	float D = alpha2 * w2 * w2 * (1.0 / M_PI);
1050: 	return D;
1051: }
1052: 
1053: float V_GGX_anisotropic(float alpha_x, float alpha_y, float TdotV, float TdotL, float BdotV, float BdotL, float NdotV, float NdotL) {
1054: 	float Lambda_V = NdotL * length(vec3(alpha_x * TdotV, alpha_y * BdotV, NdotV));
1055: 	float Lambda_L = NdotV * length(vec3(alpha_x * TdotL, alpha_y * BdotL, NdotL));
1056: 	return 0.5 / (Lambda_V + Lambda_L);
1057: }
1058: 
1059: float SchlickFresnel(float u) {
1060: 	float m = 1.0 - u;
1061: 	float m2 = m * m;
1062: 	return m2 * m2 * m; // pow(m,5)
1063: }
1064: 
1065: float V_Kelemen(float LdotH) {
1066: 	// Kelemen 2001, "A Microfacet Based Coupled Specular-Matte BRDF Model with Importance Sampling"
1067: 	return 0.25 / (LdotH * LdotH + 1e-4);
1068: }
