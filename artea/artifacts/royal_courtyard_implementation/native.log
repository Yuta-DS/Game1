183: // This is an approximation and simplification of EaryChow's AgX implementation that is used by Blender.
184: // This code is based off of the script that generates the AgX_Base_sRGB.cube LUT that Blender uses.
185: // Source: https://github.com/EaryChow/AgX_LUT_Gen/blob/main/AgXBasesRGB.py
186: // Colorspace transformation source: https://www.colour-science.org:8010/apps/rgb_colourspace_transformation_matrix
187: vec3 tonemap_agx(vec3 color) {
188: 	// Input color should be non-negative!
189: 	// Large negative values in one channel and large positive values in other
190: 	// channels can result in a colour that appears darker and more saturated than
191: 	// desired after passing it through the inset matrix. For this reason, it is
192: 	// best to prevent negative input values.
193: 	// This is done before the Rec. 2020 transform to allow the Rec. 2020
194: 	// transform to be combined with the AgX inset matrix. This results in a loss
195: 	// of color information that could be correctly interpreted within the
196: 	// Rec. 2020 color space as positive RGB values, but is often not worth
197: 	// the performance cost of an additional matrix multiplication.
198: 	//
199: 	// Additionally, this AgX configuration was created subjectively based on
200: 	// output appearance in the Rec. 709 color gamut, so it is possible that these
201: 	// matrices will not perform well with non-Rec. 709 output (more testing with
202: 	// future wide-gamut displays is be needed).
203: 	// See this comment from the author on the decisions made to create the matrices:
204: 	// https://github.com/godotengine/godot-proposals/issues/12317#issuecomment-2835824250
205: 
206: 	// Combined Rec. 709 to Rec. 2020 and Blender AgX inset matrices:
207: 	const mat3 rec709_to_rec2020_agx_inset_matrix = mat3(
208: 			0.544814746488245, 0.140416948464053, 0.0888104196149096,
209: 			0.373787398372697, 0.754137554567394, 0.178871756420858,
210: 			0.0813978551390581, 0.105445496968552, 0.732317823964232);
211: 
212: 	// Combined inverse AgX outset matrix and Rec. 2020 to Rec. 709 matrices.
213: 	const mat3 agx_outset_rec2020_to_rec709_matrix = mat3(
214: 			1.96488741169489, -0.299313364904742, -0.164352742528393,
215: 			-0.855988495690215, 1.32639796461980, -0.238183969428088,
216: 			-0.108898916004672, -0.0270845997150571, 1.40253671195648);
217: 
218: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
219: 
220: 	// Apply inset matrix.
221: 	color = rec709_to_rec2020_agx_inset_matrix * color;
222: 
223: 	// Use the allenwp tonemapping curve to match the Blender AgX curve while
224: 	// providing stability across all variable dyanimc range (SDR, HDR, EDR).
225: 	color = allenwp_curve(color);
226: 
227: 	// Clipping to output_max_value is required to address a cyan colour that occurs
228: 	// with very bright inputs.
229: 	color = min(vec3(output_max_value), color);
230: 
231: 	// Apply outset to make the result more chroma-laden and then go back to Rec. 709.
232: 	color = agx_outset_rec2020_to_rec709_matrix * color;
233: 
234: 	// Blender's lusRGB.compensate_low_side is too complex for this shader, so
235: 	// simply return the color, even if it has negative components. These negative
236: 	// components may be useful for subsequent color adjustments.
237: 	return color;
238: }
