109: vec3 tonemap_filmic(vec3 color) {
110: 	// These constants must match the those in the C++ code that calculates the parameters.
111: 	// exposure_bias: Input scale (color *= bias, env->white *= bias) to make the brightness consistent with other tonemappers.
112: 	// Also useful to scale the input to the range that the tonemapper is designed for (some require very high input values).
113: 	// Has no effect on the curve's general shape or visual properties.
114: 	const float exposure_bias = 2.0f;
115: 	const float A = 0.22f * exposure_bias * exposure_bias; // bias baked into constants for performance
116: 	const float B = 0.30f * exposure_bias;
117: 	const float C = 0.10f;
118: 	const float D = 0.20f;
119: 	const float E = 0.01f;
120: 	const float F = 0.30f;
