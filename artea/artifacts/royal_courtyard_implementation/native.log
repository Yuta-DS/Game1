1103: 	vec3 area_specular_tex_color = vec3(1.0);
1104: 
1105: 	/* clang-format off */
1106: 
1107: 
1108: 	/* clang-format on */
1109: 
1110: #else
1111: 	float NdotL = min(A + dot(N, L), 1.0);
1112: 	float cNdotL = max(NdotL, 0.0); // clamped NdotL
1113: 	float NdotV = dot(N, V);
1114: 	float cNdotV = max(NdotV, 1e-4);
1115: 
1116: 	float cc_attenuation = 1.0;
1117: 
1118: #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1119: 	vec3 H = normalize(V + L);
1120: #endif
1121: 
1122: #if defined(SPECULAR_SCHLICK_GGX)
1123: 	float cNdotH = clamp(A + dot(N, H), 0.0, 1.0);
1124: #endif
1125: 
1126: #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1127: 	float cLdotH = clamp(A + dot(L, H), 0.0, 1.0);
1128: #endif
1129: 
1130: #if defined(LIGHT_CLEARCOAT_USED)
1131: 	// Clearcoat ignores normal_map, use vertex normal instead
1132: 	float ccNdotL = clamp(A + dot(vertex_normal, L), 0.0, 1.0);
1133: 	float ccNdotH = clamp(A + dot(vertex_normal, H), 0.0, 1.0);
