1037: float D_GGX(float cos_theta_m, float alpha) {
1038: 	float a = cos_theta_m * alpha;
1039: 	float k = alpha / (1.0 - cos_theta_m * cos_theta_m + a * a);
1040: 	return k * k * (1.0 / M_PI);
1041: }
1042: 
1043: // From Earl Hammon, Jr. "PBR Diffuse Lighting for GGX+Smith Microsurfaces" https://www.gdcvault.com/play/1024478/PBR-Diffuse-Lighting-for-GGX
1044: float V_GGX(float NdotL, float NdotV, float alpha) {
1045: 	return 0.5 / mix(2.0 * NdotL * NdotV, NdotL + NdotV, alpha);
1046: }
1047: 
1048: float D_GGX_anisotropic(float cos_theta_m, float alpha_x, float alpha_y, float cos_phi, float sin_phi) {
1049: 	float alpha2 = alpha_x * alpha_y;
1050: 	highp vec3 v = vec3(alpha_y * cos_phi, alpha_x * sin_phi, alpha2 * cos_theta_m);
1051: 	highp float v2 = dot(v, v);
1052: 	float w2 = alpha2 / v2;
1053: 	float D = alpha2 * w2 * w2 * (1.0 / M_PI);
1054: 	return D;
1055: }
1056: 
1057: float V_GGX_anisotropic(float alpha_x, float alpha_y, float TdotV, float TdotL, float BdotV, float BdotL, float NdotV, float NdotL) {
1058: 	float Lambda_V = NdotL * length(vec3(alpha_x * TdotV, alpha_y * BdotV, NdotV));
1059: 	float Lambda_L = NdotV * length(vec3(alpha_x * TdotL, alpha_y * BdotL, NdotL));
1060: 	return 0.5 / (Lambda_V + Lambda_L);
1061: }
