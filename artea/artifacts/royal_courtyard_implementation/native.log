152: // allenwp tonemapping curve; developed for use in the Godot game engine.
153: // Source and details: https://allenwp.com/blog/2025/05/29/allenwp-tonemapping-curve/
154: // Input must be a non-negative linear scene value.
155: vec3 allenwp_curve(vec3 x) {
156: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
157: 
158: 	// These constants must match the those in the C++ code that calculates the parameters.
159: 	// 18% "middle gray" is perceptually 50% of the brightness of reference white.
160: 	const float awp_crossover_point = 0.18;
161: 	// When output_max_value and/or awp_crossover_point are no longer constant,
162: 	// awp_shoulder_max can be calculated on the CPU and passed in as tonemap_e.
163: 	const float awp_shoulder_max = output_max_value - awp_crossover_point;
164: 
165: 	float awp_contrast = tonemapper_params.x;
166: 	float awp_toe_a = tonemapper_params.y;
167: 	float awp_slope = tonemapper_params.z;
168: 	float awp_w = tonemapper_params.w;
169: 
170: 	// Reinhard-like shoulder:
171: 	vec3 s = x - awp_crossover_point;
172: 	vec3 slope_s = awp_slope * s;
173: 	s = slope_s * (1.0 + s / awp_w) / (1.0 + (slope_s / awp_shoulder_max));
174: 	s += awp_crossover_point;
175: 
176: 	// Sigmoid power function toe:
177: 	vec3 t = pow(x, vec3(awp_contrast));
178: 	t = t / (t + awp_toe_a);
179: 
180: 	return mix(s, t, lessThan(x, vec3(awp_crossover_point)));
181: }
