1285: // COPIED FROM servers\rendering\renderer_rd\shaders\area_lights_inc.glsl
1286: // Partially modified
1287: // Functions related to area lights
1288: #define M_PI 3.14159265359
1289: #define M_TAU 6.28318530718
1290: 
1291: float acos_approx(float p_x) {
1292: 	float x = abs(p_x);
1293: 	float res = -0.156583f * x + (M_PI / 2.0);
1294: 	res *= sqrt(1.0f - x);
1295: 	return (p_x >= 0.0) ? res : M_PI - res;
1296: }
1297: 
1298: vec3 integrate_edge_hill(vec3 p0, vec3 p1) {
1299: 	// Approximation suggested by Hill and Heitz, calculating the integral of the spherical cosine distribution over the line between p0 and p1.
1300: 	// Runs faster than the exact formula of Baum et al. (1989).
1301: 	float cosTheta = dot(p0, p1);
1302: 
1303: 	float x = cosTheta;
1304: 	float y = abs(x);
1305: 	float a = 5.42031 + (3.12829 + 0.0902326 * y) * y;
1306: 	float b = 3.45068 + (4.18814 + y) * y;
1307: 	float theta_sintheta = a / b;
1308: 
1309: 	if (x < 0.0) {
1310: 		theta_sintheta = M_PI * inversesqrt(1.0 - x * x) - theta_sintheta; // original paper: 0.5*inversesqrt(max(1.0 - x*x, 1e-7)) - theta_sintheta
1311: 	}
1312: 	return theta_sintheta * cross(p0, p1);
1313: }
1314: 
1315: float integrate_edge(vec3 p_proj0, vec3 p_proj1, vec3 p0, vec3 p1) {
1316: 	float epsilon = 0.00001;
1317: 	bool opposite_sides = dot(p_proj0, p_proj1) < -1.0 + epsilon;
1318: 	if (opposite_sides) {
1319: 		// calculate the point on the line p0 to p1 that is closest to the vertex (origin)
1320: 		vec3 half_point_t = p0 + normalize(p1 - p0) * dot(p0, normalize(p0 - p1));
1321: 		vec3 half_point = normalize(half_point_t);
1322: 		return integrate_edge_hill(p_proj0, half_point).y + integrate_edge_hill(half_point, p_proj1).y;
1323: 	}
1324: 	return integrate_edge_hill(p_proj0, p_proj1).y;
1325: }
1326: 
1327: // Form factor function for area light, taken from Urena, Fajardo, et.al. (2013): An Area-Preserving Parametrization for Spherical Rectangles
1328: float quad_solid_angle(vec3 L[4]) {
1329: 	// The solid angle of a spherical rectangle is the difference of the sum of its angles
1330: 	// and the sum of the angles of a plane rectangle (2*PI)
1331: 	vec3 c1 = cross(L[0], L[1]);
1332: 	vec3 c2 = cross(L[1], L[2]);
1333: 	vec3 c3 = cross(L[2], L[3]);
1334: 	vec3 c4 = cross(L[3], L[0]);
1335: 	vec3 n0 = normalize(c1);
1336: 	vec3 n1 = normalize(c2);
1337: 	vec3 n2 = normalize(c3);
1338: 	vec3 n3 = normalize(c4);
1339: 	float g0 = acos(clamp(dot(-n0, n1), -1.0, 1.0));
1340: 	float g1 = acos(clamp(dot(-n1, n2), -1.0, 1.0));
1341: 	float g2 = acos(clamp(dot(-n2, n3), -1.0, 1.0));
1342: 	float g3 = acos(clamp(dot(-n3, n0), -1.0, 1.0));
1343: 
1344: 	float angle_sum = g0 + g1 + g2 + g3;
1345: 
1346: 	return clamp(angle_sum - M_TAU, 0.0, M_TAU);
1347: }
1348: 
1349: void clip_quad_to_horizon(inout vec3 L[5], out int vertex_count) {
1350: 	// detect clipping config
1351: 	int config = 0;
1352: 	if (L[0].y > 0.0) {
1353: 		config += 1;
1354: 	}
1355: 	if (L[1].y > 0.0) {
1356: 		config += 2;
1357: 	}
1358: 	if (L[2].y > 0.0) {
1359: 		config += 4;
1360: 	}
1361: 	if (L[3].y > 0.0) {
1362: 		config += 8;
1363: 	}
1364: 
1365: 	// clip
1366: 	vertex_count = 0;
1367: 
1368: 	if (config == 0) {
1369: 		// clip all
1370: 	} else if (config == 1) { // V1 clip V2 V3 V4
1371: 		vertex_count = 3;
1372: 		L[1] = -L[1].y * L[0] + L[0].y * L[1];
1373: 		L[2] = -L[3].y * L[0] + L[0].y * L[3];
1374: 	} else if (config == 2) { // V2 clip V1 V3 V4
1375: 		vertex_count = 3;
1376: 		L[0] = -L[0].y * L[1] + L[1].y * L[0];
1377: 		L[2] = -L[2].y * L[1] + L[1].y * L[2];
1378: 	} else if (config == 3) { // V1 V2 clip V3 V4
1379: 		vertex_count = 4;
1380: 		L[2] = -L[2].y * L[1] + L[1].y * L[2];
1381: 		L[3] = -L[3].y * L[0] + L[0].y * L[3];
1382: 	} else if (config == 4) { // V3 clip V1 V2 V4
1383: 		vertex_count = 3;
1384: 		L[0] = -L[3].y * L[2] + L[2].y * L[3];
1385: 		L[1] = -L[1].y * L[2] + L[2].y * L[1];
1386: 	} else if (config == 5) { // V1 V3 clip V2 V4) impossible
1387: 		vertex_count = 0;
1388: 	} else if (config == 6) { // V2 V3 clip V1 V4
1389: 		vertex_count = 4;
1390: 		L[0] = -L[0].y * L[1] + L[1].y * L[0];
1391: 		L[3] = -L[3].y * L[2] + L[2].y * L[3];
1392: 	} else if (config == 7) { // V1 V2 V3 clip V4
1393: 		vertex_count = 5;
1394: 		L[4] = -L[3].y * L[0] + L[0].y * L[3];
1395: 		L[3] = -L[3].y * L[2] + L[2].y * L[3];
1396: 	} else if (config == 8) { // V4 clip V1 V2 V3
1397: 		vertex_count = 3;
1398: 		L[0] = -L[0].y * L[3] + L[3].y * L[0];
1399: 		L[1] = -L[2].y * L[3] + L[3].y * L[2];
1400: 		L[2] = L[3];
1401: 	} else if (config == 9) { // V1 V4 clip V2 V3
1402: 		vertex_count = 4;
1403: 		L[1] = -L[1].y * L[0] + L[0].y * L[1];
1404: 		L[2] = -L[2].y * L[3] + L[3].y * L[2];
1405: 	} else if (config == 10) { // V2 V4 clip V1 V3) impossible
1406: 		vertex_count = 0;
1407: 	} else if (config == 11) { // V1 V2 V4 clip V3
1408: 		vertex_count = 5;
1409: 		L[4] = L[3];
1410: 		L[3] = -L[2].y * L[3] + L[3].y * L[2];
1411: 		L[2] = -L[2].y * L[1] + L[1].y * L[2];
1412: 	} else if (config == 12) { // V3 V4 clip V1 V2
1413: 		vertex_count = 4;
1414: 		L[1] = -L[1].y * L[2] + L[2].y * L[1];
1415: 		L[0] = -L[0].y * L[3] + L[3].y * L[0];
1416: 	} else if (config == 13) { // V1 V3 V4 clip V2
1417: 		vertex_count = 5;
1418: 		L[4] = L[3];
1419: 		L[3] = L[2];
1420: 		L[2] = -L[1].y * L[2] + L[2].y * L[1];
1421: 		L[1] = -L[1].y * L[0] + L[0].y * L[1];
1422: 	} else if (config == 14) { // V2 V3 V4 clip V1
1423: 		vertex_count = 5;
1424: 		L[4] = -L[0].y * L[3] + L[3].y * L[0];
1425: 		L[0] = -L[0].y * L[1] + L[1].y * L[0];
1426: 	} else if (config == 15) { // V1 V2 V3 V4
1427: 		vertex_count = 4;
1428: 	}
1429: 
1430: 	if (vertex_count == 3) {
1431: 		L[3] = L[0];
1432: 	}
1433: 	if (vertex_count == 4) {
1434: 		L[4] = L[0];
1435: 	}
1436: }
1437: 
1438: float ltc_integrate_clipped_quad(vec3 L[5], vec3 L_proj[5], int vertices_above_horizon) {
1439: 	float I;
1440: 	I = integrate_edge(L_proj[0], L_proj[1], L[0], L[1]);
1441: 	I += integrate_edge(L_proj[1], L_proj[2], L[1], L[2]);
1442: 	I += integrate_edge(L_proj[2], L_proj[3], L[2], L[3]);
1443: 	if (vertices_above_horizon >= 4) {
1444: 		I += integrate_edge(L_proj[3], L_proj[4], L[3], L[4]);
1445: 	}
1446: 	if (vertices_above_horizon == 5) {
1447: 		I += integrate_edge(L_proj[4], L_proj[0], L[4], L[0]);
1448: 	}
1449: 	return abs(I);
1450: }
1451: 
1452: void ltc_evaluate(vec3 normal, vec3 eye_vec, mat3 M_inv, vec3 points[4], out float integral) {
1453: 	// construct the orthonormal basis around the normal vector
1454: 	vec3 x, z;
1455: 	z = -normalize(eye_vec - normal * dot(eye_vec, normal)); // expanding the angle between view and normal vector to 90 degrees, this gives a normal vector
1456: 	x = cross(normal, z);
1457: 
1458: 	// rotate area light in (T1, normal, T2) basis
1459: 	M_inv = M_inv * transpose(mat3(x, normal, z));
1460: 
1461: 	vec3 L[5];
1462: 	L[0] = M_inv * points[0];
1463: 	L[1] = M_inv * points[1];
1464: 	L[2] = M_inv * points[2];
1465: 	L[3] = M_inv * points[3];
1466: 
1467: 	vec3 L_unclipped[4];
1468: 	L_unclipped[0] = L[0];
1469: 	L_unclipped[1] = L[1];
1470: 	L_unclipped[2] = L[2];
1471: 	L_unclipped[3] = L[3];
1472: 
1473: 	int n;
1474: 	clip_quad_to_horizon(L, n);
1475: 	if (n == 0) {
1476: 		integral = 0.0;
1477: 		return;
1478: 	}
1479: 
1480: 	// project onto unit sphere
1481: 	vec3 L_proj[5];
1482: 	L_proj[0] = normalize(L[0]);
1483: 	L_proj[1] = normalize(L[1]);
1484: 	L_proj[2] = normalize(L[2]);
1485: 	L_proj[3] = normalize(L[3]);
1486: 	L_proj[4] = normalize(L[4]);
1487: 
1488: 	// Prevent abnormal values when the light goes through (or close to) the fragment
1489: 	vec3 pnorm = normalize(cross(L_proj[0] - L_proj[1], L_proj[2] - L_proj[1]));
1490: 	if (abs(dot(pnorm, L_proj[0])) < 1e-10) {
1491: 		// we could just return black, but that would lead to some black pixels in front of the light.
1492: 		// Better, we check if the fragment is on the light, and return white if so.
1493: 		vec3 r10 = points[0] - points[1];
1494: 		vec3 r12 = points[2] - points[1];
1495: 		float alpha = -dot(points[1], r10) / dot(r10, r10);
1496: 		float beta = -dot(points[1], r12) / dot(r12, r12);
1497: 		if (0.0 < alpha && alpha < 1.0 && 0.0 < beta && beta < 1.0) { // fragment is on light {
1498: 			integral = 1.0;
1499: 			return;
1500: 		} else {
1501: 			integral = 0.0;
1502: 			return;
1503: 		}
1504: 	}
1505: 
1506: 	float I = ltc_integrate_clipped_quad(L, L_proj, n);
1507: 	integral = I / (2.0 * M_PI);
1508: }
1509: 
1510: void ltc_evaluate_specular(vec3 normal, vec3 eye_vec, float roughness, vec3 points[4], sampler2D ltc_lut1, sampler2D ltc_lut2, out float ltc_specular, out vec2 fresnel) {
1511: 	float theta = acos_approx(dot(normal, eye_vec));
1512: 	const float LTC_LUT_SIZE = float(64.0);
1513: 	vec2 lut_pos = vec2(max(roughness, float(0.02)), theta / float(0.5 * M_PI));
1514: 	vec2 lut_uv = vec2(lut_pos * (float(63.0) / LTC_LUT_SIZE) + vec2(float(0.5) / LTC_LUT_SIZE)); // offset by 1 pixel
1515: 	vec4 M_brdf_abcd = texture(ltc_lut1, lut_uv);
1516: 	vec3 M_brdf_e_mag_fres = texture(ltc_lut2, lut_uv).xyz;
1517: 	float scale = 1.0 / (M_brdf_abcd.x * M_brdf_e_mag_fres.x - M_brdf_abcd.y * M_brdf_abcd.w);
1518: 
1519: 	mat3 M_inv = mat3(
1520: 			vec3(0, 0, 1.0 / M_brdf_abcd.z),
1521: 			vec3(-M_brdf_abcd.w * scale, M_brdf_abcd.x * scale, 0),
1522: 			vec3(-M_brdf_e_mag_fres.x * scale, M_brdf_abcd.y * scale, 0));
1523: 
1524: 	ltc_evaluate(normal, eye_vec, M_inv, points, ltc_specular);
1525: 	fresnel = vec2(M_brdf_e_mag_fres.yz);
1526: }
