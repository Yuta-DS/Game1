1787: #ifndef DISABLE_REFLECTION_PROBE
1788: 
1789: #define REFLECTION_AMBIENT_DISABLED 0
1790: #define REFLECTION_AMBIENT_ENVIRONMENT 1
1791: #define REFLECTION_AMBIENT_COLOR 2
1792: 
1793: void reflection_process(samplerCube reflection_map,
1794: 		vec3 normal, vec3 vertex,
1795: 		mat4 local_matrix,
1796: 		bool use_box_project, vec3 box_extents, vec3 box_offset,
1797: 		bool exterior, float intensity, float blend_distance, int ref_ambient_mode, vec4 ref_ambient_color,
1798: 		float roughness, vec3 ambient, vec3 skybox,
1799: 		inout highp vec4 reflection_accum, inout highp vec4 ambient_accum) {
1800: 	vec4 reflection;
1801: 
1802: 	vec3 local_pos = (local_matrix * vec4(vertex, 1.0)).xyz;
1803: 
1804: 	if (any(greaterThan(abs(local_pos), box_extents))) { //out of the reflection box
1805: 		return;
1806: 	}
1807: 
1808: 	float blend = 1.0;
1809: 	if (blend_distance != 0.0) {
1810: 		vec3 axis_blend_distance = min(vec3(blend_distance), box_extents);
1811: 		vec3 blend_axes = abs(local_pos) - box_extents + axis_blend_distance;
1812: 		blend_axes /= axis_blend_distance;
1813: 		blend_axes = clamp(1.0 - blend_axes, vec3(0.0), vec3(1.0));
1814: 
1815: 		blend = pow(blend_axes.x * blend_axes.y * blend_axes.z, 2.0);
1816: 	}
1817: 
1818: 	//reflect and make local
1819: 	vec3 ref_normal = normalize(reflect(vertex, normal));
1820: 	ref_normal = (local_matrix * vec4(ref_normal, 0.0)).xyz;
1821: 
1822: 	if (use_box_project) { //box project
1823: 
1824: 		vec3 nrdir = normalize(ref_normal);
1825: 		vec3 rbmax = (box_extents - local_pos) / nrdir;
1826: 		vec3 rbmin = (-box_extents - local_pos) / nrdir;
1827: 
1828: 		vec3 rbminmax = mix(rbmin, rbmax, vec3(greaterThan(nrdir, vec3(0.0, 0.0, 0.0))));
1829: 
1830: 		float fa = min(min(rbminmax.x, rbminmax.y), rbminmax.z);
1831: 		vec3 posonbox = local_pos + nrdir * fa;
1832: 		ref_normal = posonbox - box_offset.xyz;
1833: 	}
1834: 
1835: 	reflection.rgb = srgb_to_linear(textureLod(reflection_map, ref_normal, roughness * MAX_ROUGHNESS_LOD).rgb);
1836: 
1837: 	if (exterior) {
1838: 		reflection.rgb = mix(skybox, reflection.rgb, blend);
1839: 	}
1840: 	reflection.rgb *= intensity;
1841: 	reflection.a = blend;
1842: 	reflection.rgb *= blend;
1843: 
1844: 	reflection_accum += reflection;
1845: 
1846: #ifndef USE_LIGHTMAP
1847: 	if (ref_ambient_mode == REFLECTION_AMBIENT_ENVIRONMENT) {
1848: 		vec4 ambient_out;
1849: 		vec3 amb_normal = (local_matrix * vec4(normal, 0.0)).xyz;
1850: 
1851: 		ambient_out.rgb = srgb_to_linear(textureLod(reflection_map, amb_normal, MAX_ROUGHNESS_LOD).rgb);
1852: 		if (exterior) {
1853: 			ambient_out.rgb = mix(ambient, ambient_out.rgb, blend);
1854: 		}
1855: 
1856: 		ambient_out.a = blend;
1857: 		ambient_out.rgb *= blend;
1858: 		ambient_accum += ambient_out;
1859: 	} else if (ref_ambient_mode == REFLECTION_AMBIENT_COLOR) {
1860: 		vec4 ambient_out;
1861: 		ambient_out.rgb = ref_ambient_color.rgb;
1862: 		if (exterior) {
1863: 			ambient_out.rgb = mix(ambient, ambient_out.rgb, blend);
1864: 		}
1865: 
1866: 		ambient_out.a = blend;
1867: 		ambient_out.rgb *= blend;
1868: 		ambient_accum += ambient_out;
1869: 	}
1870: #endif // USE_LIGHTMAP
1871: }
1872: 
1873: #endif // DISABLE_REFLECTION_PROBE
