756: #if !defined(ADDITIVE_OMNI)
757: float sample_shadow(highp sampler2DShadow shadow, float shadow_pixel_size, vec4 pos) {
758: 	// Use textureProjLod with LOD set to 0.0 over textureProj, as textureProj not working correctly on ANGLE with Metal backend.
759: 	// https://github.com/godotengine/godot/issues/93537
760: 	float avg = textureProjLod(shadow, pos, 0.0);
761: #ifdef SHADOW_MODE_PCF_13
762: 	pos /= pos.w;
763: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size * 2.0, 0.0), pos.zw), 0.0);
764: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size * 2.0, 0.0), pos.zw), 0.0);
765: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, shadow_pixel_size * 2.0), pos.zw), 0.0);
766: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, -shadow_pixel_size * 2.0), pos.zw), 0.0);
767: 
768: 	// Early bail if distant samples are fully shaded (or none are shaded) to improve performance.
769: 	if (avg <= 0.000001) {
770: 		// None shaded at all.
771: 		return 0.0;
772: 	} else if (avg >= 4.999999) {
773: 		// All fully shaded.
774: 		return 1.0;
775: 	}
776: 
777: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, 0.0), pos.zw), 0.0);
778: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, 0.0), pos.zw), 0.0);
779: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, shadow_pixel_size), pos.zw), 0.0);
780: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, -shadow_pixel_size), pos.zw), 0.0);
