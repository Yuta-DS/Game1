273: // Compatibility renames. These are exposed with the "godot_" prefix
274: // to work around two distinct Adreno bugs:
275: // 1. Some Adreno devices expose ES310 functions in ES300 shaders.
276: //    Internally, we must use the "godot_" prefix, but user shaders
277: //    will be mapped automatically.
278: // 2. Adreno 3XX devices have poor implementations of the other packing
279: //    functions, so we just use our own there to keep it simple.
280: 
281: #ifdef USE_HALF2FLOAT
282: // Floating point pack/unpack functions are part of the GLSL ES 300 specification used by web and mobile.
283: // It appears to be safe to expose these on mobile, but when running through ANGLE this appears to break.
284: uint float2half(uint f) {
285: 	uint e = f & uint(0x7f800000);
286: 	if (e <= uint(0x38000000)) {
287: 		return uint(0);
288: 	} else {
289: 		return ((f >> uint(16)) & uint(0x8000)) |
290: 				(((e - uint(0x38000000)) >> uint(13)) & uint(0x7c00)) |
291: 				((f >> uint(13)) & uint(0x03ff));
292: 	}
293: }
294: 
295: uint half2float(uint h) {
296: 	uint h_e = h & uint(0x7c00);
297: 	return ((h & uint(0x8000)) << uint(16)) | uint((h_e >> uint(10)) != uint(0)) * (((h_e + uint(0x1c000)) << uint(13)) | ((h & uint(0x03ff)) << uint(13)));
298: }
