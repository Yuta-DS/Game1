1070: void light_compute(vec3 N, vec3 L, vec3 V, float A, vec3 light_color, bool is_directional, float attenuation, vec3 f0, float roughness, float metallic, float specular_amount, vec3 albedo, inout float alpha, vec2 screen_uv,
1071: #ifdef LIGHT_BACKLIGHT_USED
1072: 		vec3 backlight,
1073: #endif
1074: #ifdef LIGHT_RIM_USED
1075: 		float rim, float rim_tint,
1076: #endif
1077: #ifdef LIGHT_CLEARCOAT_USED
1078: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1079: #endif
1080: #ifdef LIGHT_ANISOTROPY_USED
1081: 		vec3 B, vec3 T, float anisotropy,
1082: #endif
1083: 		inout vec3 diffuse_light, inout vec3 specular_light) {
1084: 
1085: #if defined(LIGHT_CODE_USED)
1086: 	// light is written by the light shader
1087: 
1088: 	highp mat4 model_matrix = world_transform;
1089: 	mat4 projection_matrix = scene_data_block.data.projection_matrix;
1090: 	mat4 inv_projection_matrix = scene_data_block.data.inv_projection_matrix;
1091: 
1092: 	vec3 normal = N;
1093: 	vec3 light = L;
1094: 	vec3 view = V;
1095: 	bool is_area = false;
1096: 	float area_diffuse = 1.0;
1097: 	float area_specular = 1.0;
1098: 	vec3 area_diffuse_tex_color = vec3(1.0);
1099: 	vec3 area_specular_tex_color = vec3(1.0);
1100: 
1101: 	/* clang-format off */
1102: 
1103: 
1104: 	/* clang-format on */
1105: 
1106: #else
1107: 	float NdotL = min(A + dot(N, L), 1.0);
1108: 	float cNdotL = max(NdotL, 0.0); // clamped NdotL
1109: 	float NdotV = dot(N, V);
1110: 	float cNdotV = max(NdotV, 1e-4);
1111: 
1112: 	float cc_attenuation = 1.0;
1113: 
1114: #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1115: 	vec3 H = normalize(V + L);
1116: #endif
1117: 
1118: #if defined(SPECULAR_SCHLICK_GGX)
1119: 	float cNdotH = clamp(A + dot(N, H), 0.0, 1.0);
1120: #endif
1121: 
1122: #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1123: 	float cLdotH = clamp(A + dot(L, H), 0.0, 1.0);
1124: #endif
1125: 
1126: #if defined(LIGHT_CLEARCOAT_USED)
1127: 	// Clearcoat ignores normal_map, use vertex normal instead
1128: 	float ccNdotL = clamp(A + dot(vertex_normal, L), 0.0, 1.0);
1129: 	float ccNdotH = clamp(A + dot(vertex_normal, H), 0.0, 1.0);
1130: 	float cLdotH5 = SchlickFresnel(cLdotH);
1131: 
1132: 	float Dr = D_GGX(ccNdotH, mix(0.001, 0.1, clearcoat_roughness));
1133: 	float Gr = V_Kelemen(cLdotH);
1134: 	float Fr = mix(0.04, 1.0, cLdotH5) * clearcoat;
1135: 	cc_attenuation = 1.0 - Fr;
1136: 	float clearcoat_specular_brdf_NL = Dr * Gr * Fr * ccNdotL;
1137: 
1138: 	specular_light += clearcoat_specular_brdf_NL * light_color * attenuation * specular_amount;
1139: #endif // LIGHT_CLEARCOAT_USED
1140: 
1141: 	if (metallic < 1.0) {
1142: 		float diffuse_brdf_NL; // BRDF times N.L for calculating diffuse radiance
1143: 
1144: #if defined(DIFFUSE_LAMBERT_WRAP)
1145: 		// Energy conserving lambert wrap shader.
1146: 		// https://web.archive.org/web/20210228210901/http://blog.stevemcauley.com/2011/12/03/energy-conserving-wrapped-diffuse/
1147: 		diffuse_brdf_NL = max(0.0, (NdotL + roughness) / ((1.0 + roughness) * (1.0 + roughness))) * (1.0 / M_PI);
1148: #elif defined(DIFFUSE_TOON)
1149: 		diffuse_brdf_NL = smoothstep(-roughness, max(roughness, 0.01), NdotL) * (1.0 / M_PI);
1150: #elif defined(DIFFUSE_BURLEY)
1151: 		{
1152: 			float FD90_minus_1 = 2.0 * cLdotH * cLdotH * roughness - 0.5;
1153: 			float FdV = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotV);
1154: 			float FdL = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotL);
