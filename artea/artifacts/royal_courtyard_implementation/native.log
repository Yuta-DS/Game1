1011: vec3 m_get_index_uv(const vec2 m_uv2)
1012: 	{
1013: 		ivec2 m_pos=(ivec2(floor(m_uv2)) + (m_dus_region_map_size / 2));
1014: 		int m_bounds=int((uint((m_pos.x | m_pos.y)) < uint(m_dus_region_map_size)));
1015: 		int m_layer_index=((m_dus_region_map[((m_pos.y * m_dus_region_map_size) + m_pos.x)] * m_bounds) - 1);
1016: return vec3((m_uv2 - m_dus_region_locations[m_layer_index]), float(m_layer_index));	}
