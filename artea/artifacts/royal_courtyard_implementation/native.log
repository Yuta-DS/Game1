1238: void light_process_omni(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 f0, float roughness, float metallic, float shadow, vec3 albedo, inout float alpha, vec2 screen_uv,
1239: #ifdef LIGHT_BACKLIGHT_USED
1240: 		vec3 backlight,
1241: #endif
1242: #ifdef LIGHT_RIM_USED
1243: 		float rim, float rim_tint,
1244: #endif
1245: #ifdef LIGHT_CLEARCOAT_USED
1246: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1247: #endif
1248: #ifdef LIGHT_ANISOTROPY_USED
1249: 		vec3 binormal, vec3 tangent, float anisotropy,
1250: #endif
1251: 		inout vec3 diffuse_light, inout vec3 specular_light) {
1252: 	vec3 light_rel_vec = omni_lights[idx].position - vertex;
1253: 	float light_length = length(light_rel_vec);
1254: 	float omni_attenuation = get_omni_spot_attenuation(light_length, omni_lights[idx].inv_radius, omni_lights[idx].attenuation);
1255: 	vec3 color = omni_lights[idx].color;
1256: 	float size_A = 0.0;
1257: 
1258: 	if (omni_lights[idx].size > 0.0) {
1259: 		float t = omni_lights[idx].size / max(0.001, light_length);
1260: 		size_A = max(0.0, 1.0 - 1.0 / sqrt(1.0 + t * t));
1261: 	}
1262: 
1263: 	omni_attenuation *= shadow;
1264: 
1265: 	light_compute(normal, normalize(light_rel_vec), eye_vec, size_A, color, false, omni_attenuation, f0, roughness, metallic, omni_lights[idx].specular_amount, albedo, alpha, screen_uv,
1266: #ifdef LIGHT_BACKLIGHT_USED
1267: 			backlight,
1268: #endif
1269: #ifdef LIGHT_RIM_USED
1270: 			rim * omni_attenuation, rim_tint,
1271: #endif
1272: #ifdef LIGHT_CLEARCOAT_USED
1273: 			clearcoat, clearcoat_roughness, vertex_normal,
1274: #endif
1275: #ifdef LIGHT_ANISOTROPY_USED
1276: 			binormal, tangent, anisotropy,
1277: #endif
1278: 			diffuse_light,
1279: 			specular_light);
