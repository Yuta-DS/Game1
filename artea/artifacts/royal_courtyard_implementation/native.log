756: float sample_shadow(highp sampler2DShadow shadow, float shadow_pixel_size, vec4 pos) {
757: 	// Use textureProjLod with LOD set to 0.0 over textureProj, as textureProj not working correctly on ANGLE with Metal backend.
758: 	// https://github.com/godotengine/godot/issues/93537
759: 	float avg = textureProjLod(shadow, pos, 0.0);
760: #ifdef SHADOW_MODE_PCF_13
761: 	pos /= pos.w;
762: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size * 2.0, 0.0), pos.zw), 0.0);
763: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size * 2.0, 0.0), pos.zw), 0.0);
764: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, shadow_pixel_size * 2.0), pos.zw), 0.0);
765: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, -shadow_pixel_size * 2.0), pos.zw), 0.0);
766: 
767: 	// Early bail if distant samples are fully shaded (or none are shaded) to improve performance.
768: 	if (avg <= 0.000001) {
769: 		// None shaded at all.
770: 		return 0.0;
771: 	} else if (avg >= 4.999999) {
772: 		// All fully shaded.
773: 		return 1.0;
774: 	}
775: 
776: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, 0.0), pos.zw), 0.0);
777: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, 0.0), pos.zw), 0.0);
778: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, shadow_pixel_size), pos.zw), 0.0);
779: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, -shadow_pixel_size), pos.zw), 0.0);
780: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, shadow_pixel_size), pos.zw), 0.0);
781: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, shadow_pixel_size), pos.zw), 0.0);
782: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, -shadow_pixel_size), pos.zw), 0.0);
783: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, -shadow_pixel_size), pos.zw), 0.0);
784: 	return avg * (1.0 / 13.0);
785: #endif
786: 
787: #ifdef SHADOW_MODE_PCF_5
788: 	pos /= pos.w;
789: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, 0.0), pos.zw), 0.0);
790: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, 0.0), pos.zw), 0.0);
791: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, shadow_pixel_size), pos.zw), 0.0);
792: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, -shadow_pixel_size), pos.zw), 0.0);
793: 	return avg * (1.0 / 5.0);
794: 
795: #endif
796: 
797: 	return avg;
798: }
