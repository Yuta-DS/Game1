184: // This is an approximation and simplification of EaryChow's AgX implementation that is used by Blender.
185: // This code is based off of the script that generates the AgX_Base_sRGB.cube LUT that Blender uses.
186: // Source: https://github.com/EaryChow/AgX_LUT_Gen/blob/main/AgXBasesRGB.py
187: // Colorspace transformation source: https://www.colour-science.org:8010/apps/rgb_colourspace_transformation_matrix
188: vec3 tonemap_agx(vec3 color) {
189: 	// Input color should be non-negative!
190: 	// Large negative values in one channel and large positive values in other
191: 	// channels can result in a colour that appears darker and more saturated than
192: 	// desired after passing it through the inset matrix. For this reason, it is
193: 	// best to prevent negative input values.
194: 	// This is done before the Rec. 2020 transform to allow the Rec. 2020
195: 	// transform to be combined with the AgX inset matrix. This results in a loss
196: 	// of color information that could be correctly interpreted within the
197: 	// Rec. 2020 color space as positive RGB values, but is often not worth
198: 	// the performance cost of an additional matrix multiplication.
199: 	//
200: 	// Additionally, this AgX configuration was created subjectively based on
201: 	// output appearance in the Rec. 709 color gamut, so it is possible that these
202: 	// matrices will not perform well with non-Rec. 709 output (more testing with
203: 	// future wide-gamut displays is be needed).
204: 	// See this comment from the author on the decisions made to create the matrices:
205: 	// https://github.com/godotengine/godot-proposals/issues/12317#issuecomment-2835824250
206: 
207: 	// Combined Rec. 709 to Rec. 2020 and Blender AgX inset matrices:
208: 	const mat3 rec709_to_rec2020_agx_inset_matrix = mat3(
209: 			0.544814746488245, 0.140416948464053, 0.0888104196149096,
210: 			0.373787398372697, 0.754137554567394, 0.178871756420858,
211: 			0.0813978551390581, 0.105445496968552, 0.732317823964232);
212: 
213: 	// Combined inverse AgX outset matrix and Rec. 2020 to Rec. 709 matrices.
214: 	const mat3 agx_outset_rec2020_to_rec709_matrix = mat3(
215: 			1.96488741169489, -0.299313364904742, -0.164352742528393,
216: 			-0.855988495690215, 1.32639796461980, -0.238183969428088,
217: 			-0.108898916004672, -0.0270845997150571, 1.40253671195648);
218: 
219: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
220: 
221: 	// Apply inset matrix.
222: 	color = rec709_to_rec2020_agx_inset_matrix * color;
223: 
224: 	// Use the allenwp tonemapping curve to match the Blender AgX curve while
225: 	// providing stability across all variable dyanimc range (SDR, HDR, EDR).
226: 	color = allenwp_curve(color);
227: 
228: 	// Clipping to output_max_value is required to address a cyan colour that occurs
229: 	// with very bright inputs.
230: 	color = min(vec3(output_max_value), color);
231: 
232: 	// Apply outset to make the result more chroma-laden and then go back to Rec. 709.
233: 	color = agx_outset_rec2020_to_rec709_matrix * color;
234: 
235: 	// Blender's lusRGB.compensate_low_side is too complex for this shader, so
236: 	// simply return the color, even if it has negative components. These negative
237: 	// components may be useful for subsequent color adjustments.
238: 	return color;
239: }
240: 
241: #define TONEMAPPER_LINEAR 0
242: #define TONEMAPPER_REINHARD 1
243: #define TONEMAPPER_FILMIC 2
244: #define TONEMAPPER_ACES 3
245: #define TONEMAPPER_AGX 4
246: 
247: vec3 apply_tonemapping(vec3 color) { // inputs are LINEAR
248: 	if (tonemapper == TONEMAPPER_LINEAR) {
249: 		return color;
250: 	}
251: 
252: 	// Ensure color values passed to tonemappers are positive.
253: 	// They can be negative in the case of negative lights, which leads to undesired behavior.
254: 	color = max(vec3(0.0), color);
255: 
256: 	if (tonemapper == TONEMAPPER_REINHARD) {
257: 		return tonemap_reinhard(color);
258: 	} else if (tonemapper == TONEMAPPER_FILMIC) {
259: 		return tonemap_filmic(color);
260: 	} else if (tonemapper == TONEMAPPER_ACES) {
261: 		return tonemap_aces(color);
262: 	} else { // TONEMAPPER_AGX
263: 		return tonemap_agx(color);
264: 	}
265: }
266: 
267: #endif // APPLY_TONEMAPPING
268: #endif
269: // Compatibility renames. These are exposed with the "godot_" prefix
270: // to work around two distinct Adreno bugs:
271: // 1. Some Adreno devices expose ES310 functions in ES300 shaders.
272: //    Internally, we must use the "godot_" prefix, but user shaders
273: //    will be mapped automatically.
274: // 2. Adreno 3XX devices have poor implementations of the other packing
275: //    functions, so we just use our own there to keep it simple.
276: 
277: #ifdef USE_HALF2FLOAT
278: // Floating point pack/unpack functions are part of the GLSL ES 300 specification used by web and mobile.
279: // It appears to be safe to expose these on mobile, but when running through ANGLE this appears to break.
280: uint float2half(uint f) {
281: 	uint e = f & uint(0x7f800000);
282: 	if (e <= uint(0x38000000)) {
283: 		return uint(0);
284: 	} else {
285: 		return ((f >> uint(16)) & uint(0x8000)) |
286: 				(((e - uint(0x38000000)) >> uint(13)) & uint(0x7c00)) |
287: 				((f >> uint(13)) & uint(0x03ff));
288: 	}
289: }
290: 
291: uint half2float(uint h) {
292: 	uint h_e = h & uint(0x7c00);
293: 	return ((h & uint(0x8000)) << uint(16)) | uint((h_e >> uint(10)) != uint(0)) * (((h_e + uint(0x1c000)) << uint(13)) | ((h & uint(0x03ff)) << uint(13)));
294: }
295: 
296: uint godot_packHalf2x16(vec2 v) {
297: 	return float2half(floatBitsToUint(v.x)) | float2half(floatBitsToUint(v.y)) << uint(16);
298: }
299: 
300: vec2 godot_unpackHalf2x16(uint v) {
301: 	return vec2(uintBitsToFloat(half2float(v & uint(0xffff))),
302: 			uintBitsToFloat(half2float(v >> uint(16))));
303: }
304: 
305: uint godot_packUnorm2x16(vec2 v) {
306: 	uvec2 uv = uvec2(round(clamp(v, vec2(0.0), vec2(1.0)) * 65535.0));
307: 	return uv.x | uv.y << uint(16);
308: }
309: 
310: vec2 godot_unpackUnorm2x16(uint p) {
311: 	return vec2(float(p & uint(0xffff)), float(p >> uint(16))) * 0.000015259021; // 1.0 / 65535.0 optimization
312: }
313: 
314: uint godot_packSnorm2x16(vec2 v) {
315: 	uvec2 uv = uvec2(round(clamp(v, vec2(-1.0), vec2(1.0)) * 32767.0) + 32767.0);
316: 	return uv.x | uv.y << uint(16);
317: }
318: 
319: vec2 godot_unpackSnorm2x16(uint p) {
320: 	vec2 v = vec2(float(p & uint(0xffff)), float(p >> uint(16)));
321: 	return clamp((v - 32767.0) * vec2(0.00003051851), vec2(-1.0), vec2(1.0));
322: }
323: 
324: #define packHalf2x16 godot_packHalf2x16
325: #define unpackHalf2x16 godot_unpackHalf2x16
326: #define packUnorm2x16 godot_packUnorm2x16
327: #define unpackUnorm2x16 godot_unpackUnorm2x16
328: #define packSnorm2x16 godot_packSnorm2x16
329: #define unpackSnorm2x16 godot_unpackSnorm2x16
330: 
331: #endif // USE_HALF2FLOAT
332: 
333: // Always expose these as they are ES310 functions and not available in ES300 or GLSL 330.
334: 
335: uint godot_packUnorm4x8(vec4 v) {
336: 	uvec4 uv = uvec4(round(clamp(v, vec4(0.0), vec4(1.0)) * 255.0));
337: 	return uv.x | (uv.y << uint(8)) | (uv.z << uint(16)) | (uv.w << uint(24));
338: }
339: 
340: vec4 godot_unpackUnorm4x8(uint p) {
341: 	return vec4(float(p & uint(0xff)), float((p >> uint(8)) & uint(0xff)), float((p >> uint(16)) & uint(0xff)), float(p >> uint(24))) * 0.00392156862; // 1.0 / 255.0
342: }
343: 
344: uint godot_packSnorm4x8(vec4 v) {
345: 	uvec4 uv = uvec4(round(clamp(v, vec4(-1.0), vec4(1.0)) * 127.0) + 127.0);
346: 	return uv.x | uv.y << uint(8) | uv.z << uint(16) | uv.w << uint(24);
347: }
348: 
349: vec4 godot_unpackSnorm4x8(uint p) {
350: 	vec4 v = vec4(float(p & uint(0xff)), float((p >> uint(8)) & uint(0xff)), float((p >> uint(16)) & uint(0xff)), float(p >> uint(24)));
351: 	return clamp((v - vec4(127.0)) * vec4(0.00787401574), vec4(-1.0), vec4(1.0));
352: }
353: 
354: #define packUnorm4x8 godot_packUnorm4x8
355: #define unpackUnorm4x8 godot_unpackUnorm4x8
356: #define packSnorm4x8 godot_packSnorm4x8
357: #define unpackSnorm4x8 godot_unpackSnorm4x8
