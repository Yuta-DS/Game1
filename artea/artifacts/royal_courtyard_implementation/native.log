1032: float D_GGX(float cos_theta_m, float alpha) {
1033: 	float a = cos_theta_m * alpha;
1034: 	float k = alpha / (1.0 - cos_theta_m * cos_theta_m + a * a);
1035: 	return k * k * (1.0 / M_PI);
