309: uint godot_packUnorm2x16(vec2 v) {
310: 	uvec2 uv = uvec2(round(clamp(v, vec2(0.0), vec2(1.0)) * 65535.0));
311: 	return uv.x | uv.y << uint(16);
312: }
313: 
314: vec2 godot_unpackUnorm2x16(uint p) {
315: 	return vec2(float(p & uint(0xffff)), float(p >> uint(16))) * 0.000015259021; // 1.0 / 65535.0 optimization
316: }
317: 
318: uint godot_packSnorm2x16(vec2 v) {
319: 	uvec2 uv = uvec2(round(clamp(v, vec2(-1.0), vec2(1.0)) * 32767.0) + 32767.0);
320: 	return uv.x | uv.y << uint(16);
321: }
322: 
323: vec2 godot_unpackSnorm2x16(uint p) {
324: 	vec2 v = vec2(float(p & uint(0xffff)), float(p >> uint(16)));
325: 	return clamp((v - 32767.0) * vec2(0.00003051851), vec2(-1.0), vec2(1.0));
326: }
