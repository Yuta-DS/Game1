245: #define TONEMAPPER_LINEAR 0
246: #define TONEMAPPER_REINHARD 1
247: #define TONEMAPPER_FILMIC 2
248: #define TONEMAPPER_ACES 3
249: #define TONEMAPPER_AGX 4
250: 
251: vec3 apply_tonemapping(vec3 color) { // inputs are LINEAR
252: 	if (tonemapper == TONEMAPPER_LINEAR) {
253: 		return color;
254: 	}
255: 
256: 	// Ensure color values passed to tonemappers are positive.
257: 	// They can be negative in the case of negative lights, which leads to undesired behavior.
258: 	color = max(vec3(0.0), color);
259: 
260: 	if (tonemapper == TONEMAPPER_REINHARD) {
261: 		return tonemap_reinhard(color);
262: 	} else if (tonemapper == TONEMAPPER_FILMIC) {
263: 		return tonemap_filmic(color);
264: 	} else if (tonemapper == TONEMAPPER_ACES) {
265: 		return tonemap_aces(color);
266: 	} else { // TONEMAPPER_AGX
267: 		return tonemap_agx(color);
268: 	}
269: }
270: 
271: #endif // APPLY_TONEMAPPING
