1217: 		vec3 F = f0 + (f90 - f0) * cLdotH5;
1218: 
1219: 		vec3 specular_brdf_NL = cNdotL * D * F * G;
1220: 
1221: 		specular_light += specular_brdf_NL * light_color * attenuation * cc_attenuation * specular_amount;
1222: #endif
1223: 	}
1224: 
1225: #ifdef USE_SHADOW_TO_OPACITY
1226: 	alpha = min(alpha, clamp(1.0 - attenuation, 0.0, 1.0));
1227: #endif
1228: 
1229: #endif // LIGHT_CODE_USED
1230: }
