1288: 
1289: // COPIED FROM servers\rendering\renderer_rd\shaders\area_lights_inc.glsl
1290: // Partially modified
1291: // Functions related to area lights
1292: #define M_PI 3.14159265359
1293: #define M_TAU 6.28318530718
1294: 
1295: float acos_approx(float p_x) {
1296: 	float x = abs(p_x);
1297: 	float res = -0.156583f * x + (M_PI / 2.0);
1298: 	res *= sqrt(1.0f - x);
1299: 	return (p_x >= 0.0) ? res : M_PI - res;
1300: }
1301: 
1302: vec3 integrate_edge_hill(vec3 p0, vec3 p1) {
1303: 	// Approximation suggested by Hill and Heitz, calculating the integral of the spherical cosine distribution over the line between p0 and p1.
1304: 	// Runs faster than the exact formula of Baum et al. (1989).
1305: 	float cosTheta = dot(p0, p1);
1306: 
1307: 	float x = cosTheta;
1308: 	float y = abs(x);
1309: 	float a = 5.42031 + (3.12829 + 0.0902326 * y) * y;
1310: 	float b = 3.45068 + (4.18814 + y) * y;
1311: 	float theta_sintheta = a / b;
1312: 
1313: 	if (x < 0.0) {
1314: 		theta_sintheta = M_PI * inversesqrt(1.0 - x * x) - theta_sintheta; // original paper: 0.5*inversesqrt(max(1.0 - x*x, 1e-7)) - theta_sintheta
1315: 	}
1316: 	return theta_sintheta * cross(p0, p1);
1317: }
1318: 
1319: float integrate_edge(vec3 p_proj0, vec3 p_proj1, vec3 p0, vec3 p1) {
1320: 	float epsilon = 0.00001;
1321: 	bool opposite_sides = dot(p_proj0, p_proj1) < -1.0 + epsilon;
1322: 	if (opposite_sides) {
1323: 		// calculate the point on the line p0 to p1 that is closest to the vertex (origin)
1324: 		vec3 half_point_t = p0 + normalize(p1 - p0) * dot(p0, normalize(p0 - p1));
1325: 		vec3 half_point = normalize(half_point_t);
1326: 		return integrate_edge_hill(p_proj0, half_point).y + integrate_edge_hill(half_point, p_proj1).y;
1327: 	}
1328: 	return integrate_edge_hill(p_proj0, p_proj1).y;
1329: }
1330: 
1331: // Form factor function for area light, taken from Urena, Fajardo, et.al. (2013): An Area-Preserving Parametrization for Spherical Rectangles
1332: float quad_solid_angle(vec3 L[4]) {
1333: 	// The solid angle of a spherical rectangle is the difference of the sum of its angles
1334: 	// and the sum of the angles of a plane rectangle (2*PI)
1335: 	vec3 c1 = cross(L[0], L[1]);
1336: 	vec3 c2 = cross(L[1], L[2]);
1337: 	vec3 c3 = cross(L[2], L[3]);
1338: 	vec3 c4 = cross(L[3], L[0]);
1339: 	vec3 n0 = normalize(c1);
1340: 	vec3 n1 = normalize(c2);
1341: 	vec3 n2 = normalize(c3);
1342: 	vec3 n3 = normalize(c4);
1343: 	float g0 = acos(clamp(dot(-n0, n1), -1.0, 1.0));
1344: 	float g1 = acos(clamp(dot(-n1, n2), -1.0, 1.0));
1345: 	float g2 = acos(clamp(dot(-n2, n3), -1.0, 1.0));
1346: 	float g3 = acos(clamp(dot(-n3, n0), -1.0, 1.0));
1347: 
1348: 	float angle_sum = g0 + g1 + g2 + g3;
1349: 
1350: 	return clamp(angle_sum - M_TAU, 0.0, M_TAU);
1351: }
1352: 
1353: void clip_quad_to_horizon(inout vec3 L[5], out int vertex_count) {
1354: 	// detect clipping config
1355: 	int config = 0;
1356: 	if (L[0].y > 0.0) {
1357: 		config += 1;
1358: 	}
1359: 	if (L[1].y > 0.0) {
1360: 		config += 2;
1361: 	}
1362: 	if (L[2].y > 0.0) {
1363: 		config += 4;
1364: 	}
1365: 	if (L[3].y > 0.0) {
1366: 		config += 8;
1367: 	}
1368: 
1369: 	// clip
1370: 	vertex_count = 0;
1371: 
1372: 	if (config == 0) {
1373: 		// clip all
1374: 	} else if (config == 1) { // V1 clip V2 V3 V4
1375: 		vertex_count = 3;
1376: 		L[1] = -L[1].y * L[0] + L[0].y * L[1];
1377: 		L[2] = -L[3].y * L[0] + L[0].y * L[3];
1378: 	} else if (config == 2) { // V2 clip V1 V3 V4
1379: 		vertex_count = 3;
1380: 		L[0] = -L[0].y * L[1] + L[1].y * L[0];
1381: 		L[2] = -L[2].y * L[1] + L[1].y * L[2];
1382: 	} else if (config == 3) { // V1 V2 clip V3 V4
1383: 		vertex_count = 4;
1384: 		L[2] = -L[2].y * L[1] + L[1].y * L[2];
1385: 		L[3] = -L[3].y * L[0] + L[0].y * L[3];
1386: 	} else if (config == 4) { // V3 clip V1 V2 V4
1387: 		vertex_count = 3;
1388: 		L[0] = -L[3].y * L[2] + L[2].y * L[3];
1389: 		L[1] = -L[1].y * L[2] + L[2].y * L[1];
1390: 	} else if (config == 5) { // V1 V3 clip V2 V4) impossible
1391: 		vertex_count = 0;
1392: 	} else if (config == 6) { // V2 V3 clip V1 V4
1393: 		vertex_count = 4;
1394: 		L[0] = -L[0].y * L[1] + L[1].y * L[0];
1395: 		L[3] = -L[3].y * L[2] + L[2].y * L[3];
1396: 	} else if (config == 7) { // V1 V2 V3 clip V4
1397: 		vertex_count = 5;
1398: 		L[4] = -L[3].y * L[0] + L[0].y * L[3];
1399: 		L[3] = -L[3].y * L[2] + L[2].y * L[3];
1400: 	} else if (config == 8) { // V4 clip V1 V2 V3
1401: 		vertex_count = 3;
1402: 		L[0] = -L[0].y * L[3] + L[3].y * L[0];
1403: 		L[1] = -L[2].y * L[3] + L[3].y * L[2];
1404: 		L[2] = L[3];
1405: 	} else if (config == 9) { // V1 V4 clip V2 V3
1406: 		vertex_count = 4;
1407: 		L[1] = -L[1].y * L[0] + L[0].y * L[1];
1408: 		L[2] = -L[2].y * L[3] + L[3].y * L[2];
1409: 	} else if (config == 10) { // V2 V4 clip V1 V3) impossible
1410: 		vertex_count = 0;
1411: 	} else if (config == 11) { // V1 V2 V4 clip V3
1412: 		vertex_count = 5;
1413: 		L[4] = L[3];
1414: 		L[3] = -L[2].y * L[3] + L[3].y * L[2];
1415: 		L[2] = -L[2].y * L[1] + L[1].y * L[2];
1416: 	} else if (config == 12) { // V3 V4 clip V1 V2
1417: 		vertex_count = 4;
1418: 		L[1] = -L[1].y * L[2] + L[2].y * L[1];
1419: 		L[0] = -L[0].y * L[3] + L[3].y * L[0];
1420: 	} else if (config == 13) { // V1 V3 V4 clip V2
1421: 		vertex_count = 5;
1422: 		L[4] = L[3];
1423: 		L[3] = L[2];
1424: 		L[2] = -L[1].y * L[2] + L[2].y * L[1];
1425: 		L[1] = -L[1].y * L[0] + L[0].y * L[1];
1426: 	} else if (config == 14) { // V2 V3 V4 clip V1
1427: 		vertex_count = 5;
1428: 		L[4] = -L[0].y * L[3] + L[3].y * L[0];
1429: 		L[0] = -L[0].y * L[1] + L[1].y * L[0];
1430: 	} else if (config == 15) { // V1 V2 V3 V4
1431: 		vertex_count = 4;
1432: 	}
1433: 
1434: 	if (vertex_count == 3) {
1435: 		L[3] = L[0];
1436: 	}
1437: 	if (vertex_count == 4) {
1438: 		L[4] = L[0];
1439: 	}
1440: }
1441: 
1442: float ltc_integrate_clipped_quad(vec3 L[5], vec3 L_proj[5], int vertices_above_horizon) {
1443: 	float I;
1444: 	I = integrate_edge(L_proj[0], L_proj[1], L[0], L[1]);
1445: 	I += integrate_edge(L_proj[1], L_proj[2], L[1], L[2]);
1446: 	I += integrate_edge(L_proj[2], L_proj[3], L[2], L[3]);
1447: 	if (vertices_above_horizon >= 4) {
1448: 		I += integrate_edge(L_proj[3], L_proj[4], L[3], L[4]);
1449: 	}
1450: 	if (vertices_above_horizon == 5) {
1451: 		I += integrate_edge(L_proj[4], L_proj[0], L[4], L[0]);
1452: 	}
1453: 	return abs(I);
1454: }
1455: 
1456: void ltc_evaluate(vec3 normal, vec3 eye_vec, mat3 M_inv, vec3 points[4], out float integral) {
1457: 	// construct the orthonormal basis around the normal vector
1458: 	vec3 x, z;
1459: 	z = -normalize(eye_vec - normal * dot(eye_vec, normal)); // expanding the angle between view and normal vector to 90 degrees, this gives a normal vector
1460: 	x = cross(normal, z);
1461: 
1462: 	// rotate area light in (T1, normal, T2) basis
1463: 	M_inv = M_inv * transpose(mat3(x, normal, z));
1464: 
1465: 	vec3 L[5];
1466: 	L[0] = M_inv * points[0];
1467: 	L[1] = M_inv * points[1];
1468: 	L[2] = M_inv * points[2];
1469: 	L[3] = M_inv * points[3];
1470: 
1471: 	vec3 L_unclipped[4];
1472: 	L_unclipped[0] = L[0];
1473: 	L_unclipped[1] = L[1];
1474: 	L_unclipped[2] = L[2];
1475: 	L_unclipped[3] = L[3];
1476: 
1477: 	int n;
1478: 	clip_quad_to_horizon(L, n);
1479: 	if (n == 0) {
1480: 		integral = 0.0;
1481: 		return;
1482: 	}
1483: 
1484: 	// project onto unit sphere
1485: 	vec3 L_proj[5];
1486: 	L_proj[0] = normalize(L[0]);
1487: 	L_proj[1] = normalize(L[1]);
1488: 	L_proj[2] = normalize(L[2]);
1489: 	L_proj[3] = normalize(L[3]);
1490: 	L_proj[4] = normalize(L[4]);
1491: 
1492: 	// Prevent abnormal values when the light goes through (or close to) the fragment
1493: 	vec3 pnorm = normalize(cross(L_proj[0] - L_proj[1], L_proj[2] - L_proj[1]));
1494: 	if (abs(dot(pnorm, L_proj[0])) < 1e-10) {
1495: 		// we could just return black, but that would lead to some black pixels in front of the light.
1496: 		// Better, we check if the fragment is on the light, and return white if so.
1497: 		vec3 r10 = points[0] - points[1];
1498: 		vec3 r12 = points[2] - points[1];
1499: 		float alpha = -dot(points[1], r10) / dot(r10, r10);
1500: 		float beta = -dot(points[1], r12) / dot(r12, r12);
1501: 		if (0.0 < alpha && alpha < 1.0 && 0.0 < beta && beta < 1.0) { // fragment is on light {
1502: 			integral = 1.0;
1503: 			return;
1504: 		} else {
1505: 			integral = 0.0;
1506: 			return;
1507: 		}
1508: 	}
1509: 
1510: 	float I = ltc_integrate_clipped_quad(L, L_proj, n);
1511: 	integral = I / (2.0 * M_PI);
1512: }
1513: 
1514: void ltc_evaluate_specular(vec3 normal, vec3 eye_vec, float roughness, vec3 points[4], sampler2D ltc_lut1, sampler2D ltc_lut2, out float ltc_specular, out vec2 fresnel) {
1515: 	float theta = acos_approx(dot(normal, eye_vec));
1516: 	const float LTC_LUT_SIZE = float(64.0);
1517: 	vec2 lut_pos = vec2(max(roughness, float(0.02)), theta / float(0.5 * M_PI));
1518: 	vec2 lut_uv = vec2(lut_pos * (float(63.0) / LTC_LUT_SIZE) + vec2(float(0.5) / LTC_LUT_SIZE)); // offset by 1 pixel
1519: 	vec4 M_brdf_abcd = texture(ltc_lut1, lut_uv);
1520: 	vec3 M_brdf_e_mag_fres = texture(ltc_lut2, lut_uv).xyz;
1521: 	float scale = 1.0 / (M_brdf_abcd.x * M_brdf_e_mag_fres.x - M_brdf_abcd.y * M_brdf_abcd.w);
1522: 
1523: 	mat3 M_inv = mat3(
1524: 			vec3(0, 0, 1.0 / M_brdf_abcd.z),
1525: 			vec3(-M_brdf_abcd.w * scale, M_brdf_abcd.x * scale, 0),
1526: 			vec3(-M_brdf_e_mag_fres.x * scale, M_brdf_abcd.y * scale, 0));
1527: 
1528: 	ltc_evaluate(normal, eye_vec, M_inv, points, ltc_specular);
1529: 	fresnel = vec2(M_brdf_e_mag_fres.yz);
1530: }
1531: 
1532: // implementation of area lights with Linearly Transformed Cosines (LTC): https://eheitzresearch.wordpress.com/415-2/
1533: void light_process_area(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 f0, float roughness, float metallic, float shadow, vec3 albedo, inout float alpha, vec2 screen_uv,
1534: #ifdef LIGHT_BACKLIGHT_USED
1535: 		vec3 backlight,
1536: #endif
1537: #ifdef LIGHT_RIM_USED
1538: 		float rim, float rim_tint,
1539: #endif
1540: #ifdef LIGHT_CLEARCOAT_USED
1541: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1542: #endif
1543: #ifdef LIGHT_ANISOTROPY_USED
1544: 		vec3 binormal, vec3 tangent, float anisotropy,
1545: #endif
1546: 		inout vec3 diffuse_light, inout vec3 specular_light) {
1547: 	float EPSILON = 1e-7f;
1548: 	vec3 area_width = area_lights[idx].area_width.xyz;
1549: 	vec3 area_height = area_lights[idx].area_height.xyz;
1550: 	vec3 area_direction = area_lights[idx].direction;
1551: 
1552: 	if (dot(area_width, area_width) < EPSILON || dot(area_height, area_height) < EPSILON) { // area is 0
1553: 		return;
1554: 	}
1555: 	if (dot(area_direction, vertex - area_lights[idx].position) <= 0.0) {
1556: 		return; // vertex is behind light
1557: 	}
1558: 
1559: 	float a_len = length(area_width);
1560: 	float b_len = length(area_height);
1561: 	float a_half_len = a_len / 2.0;
1562: 	float b_half_len = b_len / 2.0;
1563: 	vec3 light_center = area_lights[idx].position;
1564: 	vec3 light_to_vert = vertex - light_center;
1565: 	vec3 pos_local_to_light = vec3(dot(light_to_vert, normalize(area_width)), dot(light_to_vert, normalize(area_height)), dot(light_to_vert, -area_direction));
1566: 
1567: 	vec3 closest_point_local_to_light = vec3(clamp(pos_local_to_light.x, -a_half_len, a_half_len), clamp(pos_local_to_light.y, -b_half_len, b_half_len), 0);
1568: 	float dist = length(closest_point_local_to_light - pos_local_to_light);
1569: 
1570: 	vec3 points[4];
1571: 	vec3 h_area_width = area_width / 2.0;
1572: 	vec3 h_area_height = area_height / 2.0;
1573: 	points[0] = area_lights[idx].position - h_area_width - h_area_height - vertex;
1574: 	points[1] = area_lights[idx].position + h_area_width - h_area_height - vertex;
1575: 	points[2] = area_lights[idx].position + h_area_width + h_area_height - vertex;
1576: 	points[3] = area_lights[idx].position - h_area_width + h_area_height - vertex;
1577: 
1578: 	float ltc_diffuse = 0.0;
1579: 	float ltc_specular = 0.0;
1580: 	vec2 ltc_fresnel = vec2(0.0);
1581: 	ltc_evaluate(normal, eye_vec, mat3(1), points, ltc_diffuse);
1582: 	ltc_evaluate_specular(normal, eye_vec, roughness, points, ltc_lut1, ltc_lut2, ltc_specular, ltc_fresnel);
1583: 
1584: 	float f90 = clamp(dot(f0, vec3(50.0 * 0.33)), metallic, 1.0);
1585: 	vec3 fresnel_color = f0 * max(ltc_fresnel.x, 0.0) + (f90 - f0) * max(ltc_fresnel.y, 0.0);
1586: 
1587: 	float light_length = max(0.0, dist);
1588: 	float light_attenuation_raw = get_omni_spot_attenuation(light_length, area_lights[idx].inv_radius, area_lights[idx].attenuation);
1589: 	float light_attenuation_ltc = light_attenuation_raw * light_length * light_length; // solid angle already decreases by inverse square, so attenuation power is 2.0 by default -> subtract 2.0
1590: 
1591: 	vec3 light_color = area_lights[idx].color;
1592: 	light_attenuation_ltc = light_attenuation_ltc * shadow;
1593: 	float light_attenuation = light_attenuation_raw * shadow;
1594: 	float specular_amount = area_lights[idx].specular_amount;
1595: 
1596: #if defined(LIGHT_CODE_USED) && defined(AREA_LIGHT_CODE_USED)
1597: 	// light is written by the light shader
1598: 
1599: 	highp mat4 model_matrix = world_transform;
1600: 	mat4 projection_matrix = scene_data_block.data.projection_matrix;
1601: 	mat4 inv_projection_matrix = scene_data_block.data.inv_projection_matrix;
1602: 
1603: 	vec3 light = (light_center - vertex) / light_length;
1604: 	vec3 view = eye_vec;
1605: 
1606: 	bool is_area = true;
1607: 	vec3 area_diffuse = vec3(ltc_diffuse);
1608: 	vec3 area_specular = ltc_specular * fresnel_color;
1609: 	float attenuation = light_attenuation_ltc;
1610: 
1611: 	/* clang-format off */
1612: 
1613: 
1614: 	/* clang-format on */
1615: 
1616: #else
1617: 	float area = a_len * b_len;
1618: 	float cc_attenuation = 1.0;
1619: 
1620: #if defined(LIGHT_BACKLIGHT_USED) || defined(LIGHT_RIM_USED) || defined(DIFFUSE_TOON) || defined(SPECULAR_TOON)
1621: 	float solid_angle = quad_solid_angle(points);
1622: #endif
1623: 
1624: #if defined(LIGHT_CLEARCOAT_USED)
1625: 	float cc_specular_ltc = 0.0;
1626: 	vec2 cc_fresnel = vec2(0.0);
1627: 	ltc_evaluate_specular(vertex_normal, eye_vec, sqrt(mix(0.001, 0.1, float(clearcoat_roughness))), points, ltc_lut1, ltc_lut2, cc_specular_ltc, cc_fresnel);
1628: 	float Fr = (0.04 * max(cc_fresnel.x, 0.0) + (1.0 - 0.04) * max(cc_fresnel.y, 0.0)) * clearcoat;
1629: 	cc_attenuation = 1.0 - Fr;
1630: 	specular_light += cc_specular_ltc * Fr * light_color * light_attenuation_ltc * specular_amount;
1631: #endif // LIGHT_CLEARCOAT_USED
1632: 
1633: 	if (metallic < 1.0) {
1634: #if defined(DIFFUSE_TOON)
1635: 		float backface_ltc_diffuse = 0.0;
1636: 		ltc_evaluate(vec3(-normal), vec3(eye_vec), mat3(1), points, backface_ltc_diffuse);
1637: 		float NdotL = (ltc_diffuse - backface_ltc_diffuse) / (max(solid_angle, 0.001) / M_PI);
1638: 		float diffuse_brdf_NL = smoothstep(-roughness, max(roughness, 0.01), NdotL) * (1.0 / M_PI);
1639: 		diffuse_light += diffuse_brdf_NL * light_color * area * light_attenuation * cc_attenuation;
1640: #else
1641: 		diffuse_light += ltc_diffuse * light_color * light_attenuation_ltc * cc_attenuation;
1642: #endif // DIFFUSE_TOON
1643: 
1644: #if defined(LIGHT_BACKLIGHT_USED)
1645: 		diffuse_light += light_color * max((solid_angle / M_PI) - ltc_diffuse, 0.0) * backlight * light_attenuation_ltc;
1646: #endif
1647: 	}
1648: 
1649: #if defined(LIGHT_RIM_USED) // same as for point lights
1650: 	float cNdotV = max(dot(normal, eye_vec), 1e-4);
1651: 	float rim_light = pow(max(1e-4, 1.0 - cNdotV), max(0.0, (1.0 - roughness) * 16.0));
1652: 	diffuse_light += rim_light * rim * mix(vec3(1.0), albedo, rim_tint) * light_color * solid_angle * light_attenuation_ltc;
1653: #endif
1654: 
1655: #if defined(SPECULAR_TOON)
1656: 	// If ltc_specular turns out to be not similar enough to RdotV, since its based on GGX, toon shading would need its own lookup-table.
1657: 	float mid = 1.0 - roughness;
1658: 	mid *= mid;
1659: 
1660: 	float RdotV = ltc_specular / (max(solid_angle, 0.001) / (M_PI));
1661: 	float intensity = smoothstep(mid - roughness * 0.5, mid + roughness * 0.5, RdotV) * mid; // should we use specular tex color here?? or diffuse? or white?
1662: 	diffuse_light += intensity * light_color * area * light_attenuation * specular_amount; // write to diffuse_light, as in toon shading you generally want no reflection
1663: #elif defined(SPECULAR_DISABLED)
1664: 	// do nothing
1665: #else
1666: 	vec3 spec = ltc_specular * light_color * fresnel_color;
1667: 	specular_light += spec * specular_amount * light_attenuation_ltc * cc_attenuation;
1668: #endif // SPECULAR_TOON
1669: #endif // LIGHT_CODE_USED
1670: }
1671: #endif // !DISABLE_LIGHT_AREA
