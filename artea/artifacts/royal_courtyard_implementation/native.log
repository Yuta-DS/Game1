1020: #ifndef RENDER_MOTION_VECTORS
1021: vec3 F0(float metallic, float specular, vec3 albedo) {
1022: 	float dielectric = 0.16 * specular * specular;
1023: 	// use albedo * metallic as colored specular reflectance at 0 angle for metallic materials;
1024: 	// see https://google.github.io/filament/Filament.md.html
1025: 	return mix(vec3(dielectric), albedo, vec3(metallic));
1026: }
1027: #ifndef MODE_RENDER_DEPTH
1028: 
1029: #ifndef USE_VERTEX_LIGHTING
1030: #if !defined(DISABLE_LIGHT_DIRECTIONAL) || !defined(DISABLE_LIGHT_OMNI) || !defined(DISABLE_LIGHT_SPOT) || !defined(DISABLE_LIGHT_AREA) || defined(USE_ADDITIVE_LIGHTING)
1031: 
1032: float D_GGX(float cos_theta_m, float alpha) {
1033: 	float a = cos_theta_m * alpha;
1034: 	float k = alpha / (1.0 - cos_theta_m * cos_theta_m + a * a);
1035: 	return k * k * (1.0 / M_PI);
1036: }
1037: 
1038: // From Earl Hammon, Jr. "PBR Diffuse Lighting for GGX+Smith Microsurfaces" https://www.gdcvault.com/play/1024478/PBR-Diffuse-Lighting-for-GGX
1039: float V_GGX(float NdotL, float NdotV, float alpha) {
1040: 	return 0.5 / mix(2.0 * NdotL * NdotV, NdotL + NdotV, alpha);
1041: }
1042: 
1043: float D_GGX_anisotropic(float cos_theta_m, float alpha_x, float alpha_y, float cos_phi, float sin_phi) {
1044: 	float alpha2 = alpha_x * alpha_y;
1045: 	highp vec3 v = vec3(alpha_y * cos_phi, alpha_x * sin_phi, alpha2 * cos_theta_m);
1046: 	highp float v2 = dot(v, v);
1047: 	float w2 = alpha2 / v2;
1048: 	float D = alpha2 * w2 * w2 * (1.0 / M_PI);
1049: 	return D;
1050: }
1051: 
1052: float V_GGX_anisotropic(float alpha_x, float alpha_y, float TdotV, float TdotL, float BdotV, float BdotL, float NdotV, float NdotL) {
1053: 	float Lambda_V = NdotL * length(vec3(alpha_x * TdotV, alpha_y * BdotV, NdotV));
1054: 	float Lambda_L = NdotV * length(vec3(alpha_x * TdotL, alpha_y * BdotL, NdotL));
1055: 	return 0.5 / (Lambda_V + Lambda_L);
1056: }
1057: 
1058: float SchlickFresnel(float u) {
1059: 	float m = 1.0 - u;
1060: 	float m2 = m * m;
1061: 	return m2 * m2 * m; // pow(m,5)
1062: }
1063: 
1064: float V_Kelemen(float LdotH) {
1065: 	// Kelemen 2001, "A Microfacet Based Coupled Specular-Matte BRDF Model with Importance Sampling"
1066: 	return 0.25 / (LdotH * LdotH + 1e-4);
1067: }
1068: 
1069: void light_compute(vec3 N, vec3 L, vec3 V, float A, vec3 light_color, bool is_directional, float attenuation, vec3 f0, float roughness, float metallic, float specular_amount, vec3 albedo, inout float alpha, vec2 screen_uv,
1070: #ifdef LIGHT_BACKLIGHT_USED
1071: 		vec3 backlight,
1072: #endif
1073: #ifdef LIGHT_RIM_USED
1074: 		float rim, float rim_tint,
1075: #endif
1076: #ifdef LIGHT_CLEARCOAT_USED
1077: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1078: #endif
1079: #ifdef LIGHT_ANISOTROPY_USED
1080: 		vec3 B, vec3 T, float anisotropy,
1081: #endif
1082: 		inout vec3 diffuse_light, inout vec3 specular_light) {
1083: 
1084: #if defined(LIGHT_CODE_USED)
1085: 	// light is written by the light shader
1086: 
1087: 	highp mat4 model_matrix = world_transform;
1088: 	mat4 projection_matrix = scene_data_block.data.projection_matrix;
1089: 	mat4 inv_projection_matrix = scene_data_block.data.inv_projection_matrix;
1090: 
1091: 	vec3 normal = N;
1092: 	vec3 light = L;
1093: 	vec3 view = V;
1094: 	bool is_area = false;
1095: 	float area_diffuse = 1.0;
1096: 	float area_specular = 1.0;
1097: 	vec3 area_diffuse_tex_color = vec3(1.0);
1098: 	vec3 area_specular_tex_color = vec3(1.0);
1099: 
1100: 	/* clang-format off */
1101: 
1102: 
1103: 	/* clang-format on */
1104: 
1105: #else
1106: 	float NdotL = min(A + dot(N, L), 1.0);
1107: 	float cNdotL = max(NdotL, 0.0); // clamped NdotL
1108: 	float NdotV = dot(N, V);
1109: 	float cNdotV = max(NdotV, 1e-4);
1110: 
1111: 	float cc_attenuation = 1.0;
1112: 
1113: #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1114: 	vec3 H = normalize(V + L);
1115: #endif
1116: 
1117: #if defined(SPECULAR_SCHLICK_GGX)
1118: 	float cNdotH = clamp(A + dot(N, H), 0.0, 1.0);
1119: #endif
1120: 
1121: #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1122: 	float cLdotH = clamp(A + dot(L, H), 0.0, 1.0);
1123: #endif
1124: 
1125: #if defined(LIGHT_CLEARCOAT_USED)
1126: 	// Clearcoat ignores normal_map, use vertex normal instead
1127: 	float ccNdotL = clamp(A + dot(vertex_normal, L), 0.0, 1.0);
1128: 	float ccNdotH = clamp(A + dot(vertex_normal, H), 0.0, 1.0);
1129: 	float cLdotH5 = SchlickFresnel(cLdotH);
1130: 
1131: 	float Dr = D_GGX(ccNdotH, mix(0.001, 0.1, clearcoat_roughness));
1132: 	float Gr = V_Kelemen(cLdotH);
1133: 	float Fr = mix(0.04, 1.0, cLdotH5) * clearcoat;
1134: 	cc_attenuation = 1.0 - Fr;
1135: 	float clearcoat_specular_brdf_NL = Dr * Gr * Fr * ccNdotL;
1136: 
1137: 	specular_light += clearcoat_specular_brdf_NL * light_color * attenuation * specular_amount;
1138: #endif // LIGHT_CLEARCOAT_USED
1139: 
1140: 	if (metallic < 1.0) {
1141: 		float diffuse_brdf_NL; // BRDF times N.L for calculating diffuse radiance
1142: 
1143: #if defined(DIFFUSE_LAMBERT_WRAP)
1144: 		// Energy conserving lambert wrap shader.
1145: 		// https://web.archive.org/web/20210228210901/http://blog.stevemcauley.com/2011/12/03/energy-conserving-wrapped-diffuse/
1146: 		diffuse_brdf_NL = max(0.0, (NdotL + roughness) / ((1.0 + roughness) * (1.0 + roughness))) * (1.0 / M_PI);
1147: #elif defined(DIFFUSE_TOON)
1148: 		diffuse_brdf_NL = smoothstep(-roughness, max(roughness, 0.01), NdotL) * (1.0 / M_PI);
1149: #elif defined(DIFFUSE_BURLEY)
1150: 		{
1151: 			float FD90_minus_1 = 2.0 * cLdotH * cLdotH * roughness - 0.5;
1152: 			float FdV = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotV);
1153: 			float FdL = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotL);
1154: 			diffuse_brdf_NL = (1.0 / M_PI) * FdV * FdL * cNdotL;
1155: 		}
1156: #else
1157: 		// Lambert
1158: 		diffuse_brdf_NL = cNdotL * (1.0 / M_PI);
1159: #endif
1160: 
1161: 		diffuse_light += light_color * diffuse_brdf_NL * attenuation * cc_attenuation;
1162: 
1163: #if defined(LIGHT_BACKLIGHT_USED)
1164: 		diffuse_light += light_color * (vec3(1.0 / M_PI) - diffuse_brdf_NL) * backlight * attenuation * cc_attenuation;
1165: #endif
1166: 
1167: #if defined(LIGHT_RIM_USED)
1168: 		// Epsilon min to prevent pow(0, 0) singularity which results in undefined behavior.
1169: 		float rim_light = pow(max(1e-4, 1.0 - cNdotV), max(0.0, (1.0 - roughness) * 16.0));
1170: 		diffuse_light += rim_light * rim * mix(vec3(1.0), albedo, rim_tint) * light_color;
1171: #endif
1172: 	}
1173: 
1174: 	if (roughness > 0.0) { // FIXME: roughness == 0 should not disable specular light entirely
1175: 
1176: 		// D
1177: 
1178: #if defined(SPECULAR_TOON)
1179: 
1180: 		vec3 R = normalize(-reflect(L, N));
1181: 		float RdotV = dot(R, V);
1182: 		float mid = 1.0 - roughness;
1183: 		mid *= mid;
1184: 		float intensity = smoothstep(mid - roughness * 0.5, mid + roughness * 0.5, RdotV) * mid;
1185: 		diffuse_light += light_color * intensity * attenuation * specular_amount; // write to diffuse_light, as in toon shading you generally want no reflection
1186: 
1187: #elif defined(SPECULAR_DISABLED)
1188: 		// none..
1189: 
1190: #elif defined(SPECULAR_SCHLICK_GGX)
1191: 		// shlick+ggx as default
1192: 		float alpha_ggx = roughness * roughness;
1193: #if defined(LIGHT_ANISOTROPY_USED)
1194: 		float aspect = sqrt(1.0 - anisotropy * 0.9);
1195: 		float ax = alpha_ggx / aspect;
1196: 		float ay = alpha_ggx * aspect;
1197: 		float XdotH = dot(T, H);
1198: 		float YdotH = dot(B, H);
1199: 		float D = D_GGX_anisotropic(cNdotH, ax, ay, XdotH, YdotH);
1200: 		float G = V_GGX_anisotropic(ax, ay, dot(T, V), dot(T, L), dot(B, V), dot(B, L), cNdotV, cNdotL);
1201: #else
1202: 		float D = D_GGX(cNdotH, alpha_ggx);
1203: 		float G = V_GGX(cNdotL, cNdotV, alpha_ggx);
1204: #endif // LIGHT_ANISOTROPY_USED
1205: 	   // F
1206: #if !defined(LIGHT_CLEARCOAT_USED)
1207: 		float cLdotH5 = SchlickFresnel(cLdotH);
1208: #endif
1209: 		// Calculate Fresnel using cheap approximate specular occlusion term from Filament:
1210: 		// https://google.github.io/filament/Filament.html#lighting/occlusion/specularocclusion
1211: 		float f90 = clamp(50.0 * f0.g, 0.0, 1.0);
1212: 		vec3 F = f0 + (f90 - f0) * cLdotH5;
1213: 
1214: 		vec3 specular_brdf_NL = cNdotL * D * F * G;
1215: 
1216: 		specular_light += specular_brdf_NL * light_color * attenuation * cc_attenuation * specular_amount;
1217: #endif
1218: 	}
1219: 
1220: #ifdef USE_SHADOW_TO_OPACITY
1221: 	alpha = min(alpha, clamp(1.0 - attenuation, 0.0, 1.0));
1222: #endif
1223: 
1224: #endif // LIGHT_CODE_USED
1225: }
1226: 
1227: float get_omni_spot_attenuation(float distance, float inv_range, float decay) {
1228: 	float nd = distance * inv_range;
1229: 	nd *= nd;
1230: 	nd *= nd; // nd^4
1231: 	nd = max(1.0 - nd, 0.0);
1232: 	nd *= nd; // nd^2
1233: 	return nd * pow(max(distance, 0.0001), -decay);
1234: }
