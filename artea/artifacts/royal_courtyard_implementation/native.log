1939: void main() {
1940: #ifndef RENDER_MOTION_VECTORS
1941: 	//lay out everything, whatever is unused is optimized away anyway
1942: 	vec3 vertex = vertex_interp;
1943: #ifdef USE_MULTIVIEW
1944: 	vec3 eye_offset = multiview_data_block.data.eye_offset[ViewIndex].xyz;
1945: 	vec3 view = -normalize(vertex_interp - eye_offset);
1946: 	mat4 projection_matrix = multiview_data_block.data.projection_matrix_view[ViewIndex];
1947: 	mat4 inv_projection_matrix = multiview_data_block.data.inv_projection_matrix_view[ViewIndex];
1948: #else
1949: 	vec3 eye_offset = vec3(0.0, 0.0, 0.0);
1950: 	vec3 view = -normalize(vertex_interp);
1951: 	mat4 projection_matrix = scene_data_block.data.projection_matrix;
1952: 	mat4 inv_projection_matrix = scene_data_block.data.inv_projection_matrix;
1953: #endif
1954: 	highp mat4 model_matrix = world_transform;
1955: 	vec3 albedo = vec3(1.0);
