1782: #ifndef DISABLE_REFLECTION_PROBE
1783: 
1784: #define REFLECTION_AMBIENT_DISABLED 0
1785: #define REFLECTION_AMBIENT_ENVIRONMENT 1
1786: #define REFLECTION_AMBIENT_COLOR 2
1787: 
1788: void reflection_process(samplerCube reflection_map,
1789: 		vec3 normal, vec3 vertex,
1790: 		mat4 local_matrix,
1791: 		bool use_box_project, vec3 box_extents, vec3 box_offset,
1792: 		bool exterior, float intensity, float blend_distance, int ref_ambient_mode, vec4 ref_ambient_color,
1793: 		float roughness, vec3 ambient, vec3 skybox,
1794: 		inout highp vec4 reflection_accum, inout highp vec4 ambient_accum) {
1795: 	vec4 reflection;
1796: 
1797: 	vec3 local_pos = (local_matrix * vec4(vertex, 1.0)).xyz;
1798: 
1799: 	if (any(greaterThan(abs(local_pos), box_extents))) { //out of the reflection box
1800: 		return;
1801: 	}
1802: 
1803: 	float blend = 1.0;
1804: 	if (blend_distance != 0.0) {
1805: 		vec3 axis_blend_distance = min(vec3(blend_distance), box_extents);
1806: 		vec3 blend_axes = abs(local_pos) - box_extents + axis_blend_distance;
1807: 		blend_axes /= axis_blend_distance;
1808: 		blend_axes = clamp(1.0 - blend_axes, vec3(0.0), vec3(1.0));
1809: 
1810: 		blend = pow(blend_axes.x * blend_axes.y * blend_axes.z, 2.0);
1811: 	}
1812: 
1813: 	//reflect and make local
1814: 	vec3 ref_normal = normalize(reflect(vertex, normal));
1815: 	ref_normal = (local_matrix * vec4(ref_normal, 0.0)).xyz;
1816: 
1817: 	if (use_box_project) { //box project
1818: 
1819: 		vec3 nrdir = normalize(ref_normal);
1820: 		vec3 rbmax = (box_extents - local_pos) / nrdir;
1821: 		vec3 rbmin = (-box_extents - local_pos) / nrdir;
1822: 
1823: 		vec3 rbminmax = mix(rbmin, rbmax, vec3(greaterThan(nrdir, vec3(0.0, 0.0, 0.0))));
1824: 
1825: 		float fa = min(min(rbminmax.x, rbminmax.y), rbminmax.z);
1826: 		vec3 posonbox = local_pos + nrdir * fa;
1827: 		ref_normal = posonbox - box_offset.xyz;
1828: 	}
1829: 
1830: 	reflection.rgb = srgb_to_linear(textureLod(reflection_map, ref_normal, roughness * MAX_ROUGHNESS_LOD).rgb);
1831: 
1832: 	if (exterior) {
1833: 		reflection.rgb = mix(skybox, reflection.rgb, blend);
1834: 	}
1835: 	reflection.rgb *= intensity;
1836: 	reflection.a = blend;
1837: 	reflection.rgb *= blend;
1838: 
1839: 	reflection_accum += reflection;
1840: 
1841: #ifndef USE_LIGHTMAP
1842: 	if (ref_ambient_mode == REFLECTION_AMBIENT_ENVIRONMENT) {
1843: 		vec4 ambient_out;
1844: 		vec3 amb_normal = (local_matrix * vec4(normal, 0.0)).xyz;
1845: 
1846: 		ambient_out.rgb = srgb_to_linear(textureLod(reflection_map, amb_normal, MAX_ROUGHNESS_LOD).rgb);
1847: 		if (exterior) {
1848: 			ambient_out.rgb = mix(ambient, ambient_out.rgb, blend);
1849: 		}
1850: 
1851: 		ambient_out.a = blend;
1852: 		ambient_out.rgb *= blend;
1853: 		ambient_accum += ambient_out;
1854: 	} else if (ref_ambient_mode == REFLECTION_AMBIENT_COLOR) {
1855: 		vec4 ambient_out;
1856: 		ambient_out.rgb = ref_ambient_color.rgb;
1857: 		if (exterior) {
1858: 			ambient_out.rgb = mix(ambient, ambient_out.rgb, blend);
1859: 		}
1860: 
1861: 		ambient_out.a = blend;
1862: 		ambient_out.rgb *= blend;
1863: 		ambient_accum += ambient_out;
1864: 	}
1865: #endif // USE_LIGHTMAP
1866: }
1867: 
1868: #endif // DISABLE_REFLECTION_PROBE
