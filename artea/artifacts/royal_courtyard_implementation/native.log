217: 	// Combined inverse AgX outset matrix and Rec. 2020 to Rec. 709 matrices.
218: 	const mat3 agx_outset_rec2020_to_rec709_matrix = mat3(
219: 			1.96488741169489, -0.299313364904742, -0.164352742528393,
220: 			-0.855988495690215, 1.32639796461980, -0.238183969428088,
221: 			-0.108898916004672, -0.0270845997150571, 1.40253671195648);
