1286: #if !defined(DISABLE_LIGHT_AREA)
1287: 
1288: // COPIED FROM servers\rendering\renderer_rd\shaders\area_lights_inc.glsl
1289: // Partially modified
1290: // Functions related to area lights
1291: #define M_PI 3.14159265359
1292: #define M_TAU 6.28318530718
1293: 
1294: float acos_approx(float p_x) {
1295: 	float x = abs(p_x);
1296: 	float res = -0.156583f * x + (M_PI / 2.0);
1297: 	res *= sqrt(1.0f - x);
1298: 	return (p_x >= 0.0) ? res : M_PI - res;
1299: }
1300: 
1301: vec3 integrate_edge_hill(vec3 p0, vec3 p1) {
1302: 	// Approximation suggested by Hill and Heitz, calculating the integral of the spherical cosine distribution over the line between p0 and p1.
1303: 	// Runs faster than the exact formula of Baum et al. (1989).
1304: 	float cosTheta = dot(p0, p1);
1305: 
1306: 	float x = cosTheta;
1307: 	float y = abs(x);
1308: 	float a = 5.42031 + (3.12829 + 0.0902326 * y) * y;
1309: 	float b = 3.45068 + (4.18814 + y) * y;
1310: 	float theta_sintheta = a / b;
1311: 
1312: 	if (x < 0.0) {
1313: 		theta_sintheta = M_PI * inversesqrt(1.0 - x * x) - theta_sintheta; // original paper: 0.5*inversesqrt(max(1.0 - x*x, 1e-7)) - theta_sintheta
1314: 	}
1315: 	return theta_sintheta * cross(p0, p1);
1316: }
1317: 
1318: float integrate_edge(vec3 p_proj0, vec3 p_proj1, vec3 p0, vec3 p1) {
1319: 	float epsilon = 0.00001;
1320: 	bool opposite_sides = dot(p_proj0, p_proj1) < -1.0 + epsilon;
1321: 	if (opposite_sides) {
1322: 		// calculate the point on the line p0 to p1 that is closest to the vertex (origin)
1323: 		vec3 half_point_t = p0 + normalize(p1 - p0) * dot(p0, normalize(p0 - p1));
1324: 		vec3 half_point = normalize(half_point_t);
1325: 		return integrate_edge_hill(p_proj0, half_point).y + integrate_edge_hill(half_point, p_proj1).y;
1326: 	}
1327: 	return integrate_edge_hill(p_proj0, p_proj1).y;
1328: }
1329: 
1330: // Form factor function for area light, taken from Urena, Fajardo, et.al. (2013): An Area-Preserving Parametrization for Spherical Rectangles
1331: float quad_solid_angle(vec3 L[4]) {
1332: 	// The solid angle of a spherical rectangle is the difference of the sum of its angles
1333: 	// and the sum of the angles of a plane rectangle (2*PI)
1334: 	vec3 c1 = cross(L[0], L[1]);
1335: 	vec3 c2 = cross(L[1], L[2]);
1336: 	vec3 c3 = cross(L[2], L[3]);
1337: 	vec3 c4 = cross(L[3], L[0]);
1338: 	vec3 n0 = normalize(c1);
1339: 	vec3 n1 = normalize(c2);
1340: 	vec3 n2 = normalize(c3);
1341: 	vec3 n3 = normalize(c4);
1342: 	float g0 = acos(clamp(dot(-n0, n1), -1.0, 1.0));
1343: 	float g1 = acos(clamp(dot(-n1, n2), -1.0, 1.0));
1344: 	float g2 = acos(clamp(dot(-n2, n3), -1.0, 1.0));
1345: 	float g3 = acos(clamp(dot(-n3, n0), -1.0, 1.0));
1346: 
1347: 	float angle_sum = g0 + g1 + g2 + g3;
1348: 
1349: 	return clamp(angle_sum - M_TAU, 0.0, M_TAU);
1350: }
1351: 
1352: void clip_quad_to_horizon(inout vec3 L[5], out int vertex_count) {
1353: 	// detect clipping config
1354: 	int config = 0;
1355: 	if (L[0].y > 0.0) {
1356: 		config += 1;
1357: 	}
1358: 	if (L[1].y > 0.0) {
1359: 		config += 2;
1360: 	}
1361: 	if (L[2].y > 0.0) {
1362: 		config += 4;
1363: 	}
1364: 	if (L[3].y > 0.0) {
1365: 		config += 8;
1366: 	}
1367: 
1368: 	// clip
1369: 	vertex_count = 0;
1370: 
1371: 	if (config == 0) {
1372: 		// clip all
1373: 	} else if (config == 1) { // V1 clip V2 V3 V4
1374: 		vertex_count = 3;
1375: 		L[1] = -L[1].y * L[0] + L[0].y * L[1];
1376: 		L[2] = -L[3].y * L[0] + L[0].y * L[3];
1377: 	} else if (config == 2) { // V2 clip V1 V3 V4
1378: 		vertex_count = 3;
1379: 		L[0] = -L[0].y * L[1] + L[1].y * L[0];
1380: 		L[2] = -L[2].y * L[1] + L[1].y * L[2];
1381: 	} else if (config == 3) { // V1 V2 clip V3 V4
1382: 		vertex_count = 4;
1383: 		L[2] = -L[2].y * L[1] + L[1].y * L[2];
1384: 		L[3] = -L[3].y * L[0] + L[0].y * L[3];
1385: 	} else if (config == 4) { // V3 clip V1 V2 V4
1386: 		vertex_count = 3;
1387: 		L[0] = -L[3].y * L[2] + L[2].y * L[3];
1388: 		L[1] = -L[1].y * L[2] + L[2].y * L[1];
1389: 	} else if (config == 5) { // V1 V3 clip V2 V4) impossible
1390: 		vertex_count = 0;
1391: 	} else if (config == 6) { // V2 V3 clip V1 V4
1392: 		vertex_count = 4;
1393: 		L[0] = -L[0].y * L[1] + L[1].y * L[0];
1394: 		L[3] = -L[3].y * L[2] + L[2].y * L[3];
1395: 	} else if (config == 7) { // V1 V2 V3 clip V4
1396: 		vertex_count = 5;
1397: 		L[4] = -L[3].y * L[0] + L[0].y * L[3];
1398: 		L[3] = -L[3].y * L[2] + L[2].y * L[3];
1399: 	} else if (config == 8) { // V4 clip V1 V2 V3
1400: 		vertex_count = 3;
1401: 		L[0] = -L[0].y * L[3] + L[3].y * L[0];
1402: 		L[1] = -L[2].y * L[3] + L[3].y * L[2];
1403: 		L[2] = L[3];
1404: 	} else if (config == 9) { // V1 V4 clip V2 V3
1405: 		vertex_count = 4;
1406: 		L[1] = -L[1].y * L[0] + L[0].y * L[1];
1407: 		L[2] = -L[2].y * L[3] + L[3].y * L[2];
1408: 	} else if (config == 10) { // V2 V4 clip V1 V3) impossible
1409: 		vertex_count = 0;
1410: 	} else if (config == 11) { // V1 V2 V4 clip V3
1411: 		vertex_count = 5;
1412: 		L[4] = L[3];
1413: 		L[3] = -L[2].y * L[3] + L[3].y * L[2];
1414: 		L[2] = -L[2].y * L[1] + L[1].y * L[2];
1415: 	} else if (config == 12) { // V3 V4 clip V1 V2
1416: 		vertex_count = 4;
1417: 		L[1] = -L[1].y * L[2] + L[2].y * L[1];
1418: 		L[0] = -L[0].y * L[3] + L[3].y * L[0];
1419: 	} else if (config == 13) { // V1 V3 V4 clip V2
1420: 		vertex_count = 5;
1421: 		L[4] = L[3];
1422: 		L[3] = L[2];
1423: 		L[2] = -L[1].y * L[2] + L[2].y * L[1];
1424: 		L[1] = -L[1].y * L[0] + L[0].y * L[1];
1425: 	} else if (config == 14) { // V2 V3 V4 clip V1
1426: 		vertex_count = 5;
1427: 		L[4] = -L[0].y * L[3] + L[3].y * L[0];
1428: 		L[0] = -L[0].y * L[1] + L[1].y * L[0];
1429: 	} else if (config == 15) { // V1 V2 V3 V4
1430: 		vertex_count = 4;
1431: 	}
1432: 
1433: 	if (vertex_count == 3) {
1434: 		L[3] = L[0];
1435: 	}
1436: 	if (vertex_count == 4) {
1437: 		L[4] = L[0];
1438: 	}
1439: }
1440: 
1441: float ltc_integrate_clipped_quad(vec3 L[5], vec3 L_proj[5], int vertices_above_horizon) {
1442: 	float I;
1443: 	I = integrate_edge(L_proj[0], L_proj[1], L[0], L[1]);
1444: 	I += integrate_edge(L_proj[1], L_proj[2], L[1], L[2]);
1445: 	I += integrate_edge(L_proj[2], L_proj[3], L[2], L[3]);
1446: 	if (vertices_above_horizon >= 4) {
1447: 		I += integrate_edge(L_proj[3], L_proj[4], L[3], L[4]);
1448: 	}
1449: 	if (vertices_above_horizon == 5) {
1450: 		I += integrate_edge(L_proj[4], L_proj[0], L[4], L[0]);
1451: 	}
1452: 	return abs(I);
1453: }
1454: 
1455: void ltc_evaluate(vec3 normal, vec3 eye_vec, mat3 M_inv, vec3 points[4], out float integral) {
1456: 	// construct the orthonormal basis around the normal vector
1457: 	vec3 x, z;
1458: 	z = -normalize(eye_vec - normal * dot(eye_vec, normal)); // expanding the angle between view and normal vector to 90 degrees, this gives a normal vector
1459: 	x = cross(normal, z);
1460: 
1461: 	// rotate area light in (T1, normal, T2) basis
1462: 	M_inv = M_inv * transpose(mat3(x, normal, z));
1463: 
1464: 	vec3 L[5];
1465: 	L[0] = M_inv * points[0];
1466: 	L[1] = M_inv * points[1];
1467: 	L[2] = M_inv * points[2];
1468: 	L[3] = M_inv * points[3];
1469: 
1470: 	vec3 L_unclipped[4];
1471: 	L_unclipped[0] = L[0];
1472: 	L_unclipped[1] = L[1];
1473: 	L_unclipped[2] = L[2];
1474: 	L_unclipped[3] = L[3];
1475: 
1476: 	int n;
1477: 	clip_quad_to_horizon(L, n);
1478: 	if (n == 0) {
1479: 		integral = 0.0;
1480: 		return;
1481: 	}
1482: 
1483: 	// project onto unit sphere
1484: 	vec3 L_proj[5];
1485: 	L_proj[0] = normalize(L[0]);
1486: 	L_proj[1] = normalize(L[1]);
1487: 	L_proj[2] = normalize(L[2]);
1488: 	L_proj[3] = normalize(L[3]);
1489: 	L_proj[4] = normalize(L[4]);
1490: 
1491: 	// Prevent abnormal values when the light goes through (or close to) the fragment
1492: 	vec3 pnorm = normalize(cross(L_proj[0] - L_proj[1], L_proj[2] - L_proj[1]));
1493: 	if (abs(dot(pnorm, L_proj[0])) < 1e-10) {
1494: 		// we could just return black, but that would lead to some black pixels in front of the light.
1495: 		// Better, we check if the fragment is on the light, and return white if so.
1496: 		vec3 r10 = points[0] - points[1];
1497: 		vec3 r12 = points[2] - points[1];
1498: 		float alpha = -dot(points[1], r10) / dot(r10, r10);
1499: 		float beta = -dot(points[1], r12) / dot(r12, r12);
1500: 		if (0.0 < alpha && alpha < 1.0 && 0.0 < beta && beta < 1.0) { // fragment is on light {
1501: 			integral = 1.0;
1502: 			return;
1503: 		} else {
1504: 			integral = 0.0;
1505: 			return;
1506: 		}
1507: 	}
1508: 
1509: 	float I = ltc_integrate_clipped_quad(L, L_proj, n);
1510: 	integral = I / (2.0 * M_PI);
1511: }
1512: 
1513: void ltc_evaluate_specular(vec3 normal, vec3 eye_vec, float roughness, vec3 points[4], sampler2D ltc_lut1, sampler2D ltc_lut2, out float ltc_specular, out vec2 fresnel) {
1514: 	float theta = acos_approx(dot(normal, eye_vec));
1515: 	const float LTC_LUT_SIZE = float(64.0);
1516: 	vec2 lut_pos = vec2(max(roughness, float(0.02)), theta / float(0.5 * M_PI));
1517: 	vec2 lut_uv = vec2(lut_pos * (float(63.0) / LTC_LUT_SIZE) + vec2(float(0.5) / LTC_LUT_SIZE)); // offset by 1 pixel
1518: 	vec4 M_brdf_abcd = texture(ltc_lut1, lut_uv);
1519: 	vec3 M_brdf_e_mag_fres = texture(ltc_lut2, lut_uv).xyz;
1520: 	float scale = 1.0 / (M_brdf_abcd.x * M_brdf_e_mag_fres.x - M_brdf_abcd.y * M_brdf_abcd.w);
1521: 
1522: 	mat3 M_inv = mat3(
1523: 			vec3(0, 0, 1.0 / M_brdf_abcd.z),
1524: 			vec3(-M_brdf_abcd.w * scale, M_brdf_abcd.x * scale, 0),
1525: 			vec3(-M_brdf_e_mag_fres.x * scale, M_brdf_abcd.y * scale, 0));
1526: 
1527: 	ltc_evaluate(normal, eye_vec, M_inv, points, ltc_specular);
1528: 	fresnel = vec2(M_brdf_e_mag_fres.yz);
1529: }
