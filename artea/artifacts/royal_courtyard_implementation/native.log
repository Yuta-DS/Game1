101: // Based on Reinhard's extended formula, see equation 4 in https://doi.org/cjbgrt
102: vec3 tonemap_reinhard(vec3 color) {
103: 	float white_squared = tonemapper_params.x;
104: 	vec3 white_squared_color = white_squared * color;
105: 	// Equivalent to color * (1 + color / white_squared) / (1 + color)
106: 	return (white_squared_color + color * color) / (white_squared_color + white_squared);
107: }
