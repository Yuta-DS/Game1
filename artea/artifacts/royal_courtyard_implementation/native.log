1669: #if !defined(DISABLE_LIGHT_SPOT) || defined(ADDITIVE_SPOT)
1670: void light_process_spot(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 f0, float roughness, float metallic, float shadow, vec3 albedo, inout float alpha, vec2 screen_uv,
1671: #ifdef LIGHT_BACKLIGHT_USED
1672: 		vec3 backlight,
1673: #endif
1674: #ifdef LIGHT_RIM_USED
1675: 		float rim, float rim_tint,
1676: #endif
1677: #ifdef LIGHT_CLEARCOAT_USED
1678: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1679: #endif
1680: #ifdef LIGHT_ANISOTROPY_USED
1681: 		vec3 binormal, vec3 tangent, float anisotropy,
1682: #endif
1683: 		inout vec3 diffuse_light,
1684: 		inout vec3 specular_light) {
1685: 
1686: 	vec3 light_rel_vec = spot_lights[idx].position - vertex;
1687: 	float light_length = length(light_rel_vec);
1688: 	float spot_attenuation = get_omni_spot_attenuation(light_length, spot_lights[idx].inv_radius, spot_lights[idx].attenuation);
1689: 	vec3 spot_dir = spot_lights[idx].direction;
1690: 	float scos = max(dot(-normalize(light_rel_vec), spot_dir), spot_lights[idx].cone_angle);
1691: 	float spot_rim = max(0.0001, (1.0 - scos) / (1.0 - spot_lights[idx].cone_angle));
1692: 
1693: 	mediump float cone_attenuation = spot_lights[idx].cone_attenuation;
1694: 	spot_attenuation *= 1.0 - pow(spot_rim, cone_attenuation);
1695: 
1696: 	vec3 color = spot_lights[idx].color;
1697: 
1698: 	float size_A = 0.0;
1699: 
1700: 	if (spot_lights[idx].size > 0.0) {
1701: 		float t = spot_lights[idx].size / max(0.001, light_length);
1702: 		size_A = max(0.0, 1.0 - 1.0 / sqrt(1.0 + t * t));
1703: 	}
1704: 
1705: 	spot_attenuation *= shadow;
1706: 
1707: 	light_compute(normal, normalize(light_rel_vec), eye_vec, size_A, color, false, spot_attenuation, f0, roughness, metallic, spot_lights[idx].specular_amount, albedo, alpha, screen_uv,
1708: #ifdef LIGHT_BACKLIGHT_USED
1709: 			backlight,
1710: #endif
1711: #ifdef LIGHT_RIM_USED
1712: 			rim * spot_attenuation, rim_tint,
1713: #endif
1714: #ifdef LIGHT_CLEARCOAT_USED
1715: 			clearcoat, clearcoat_roughness, vertex_normal,
1716: #endif
1717: #ifdef LIGHT_ANISOTROPY_USED
1718: 			binormal, tangent, anisotropy,
1719: #endif
1720: 			diffuse_light, specular_light);
1721: }
1722: #endif // !defined(DISABLE_LIGHT_SPOT) || defined(ADDITIVE_SPOT)
1723: 
1724: #endif // !defined(DISABLE_LIGHT_DIRECTIONAL) || !defined(DISABLE_LIGHT_OMNI) || !defined(DISABLE_LIGHT_SPOT)
1725: #endif // !USE_VERTEX_LIGHTING
