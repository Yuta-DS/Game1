348: uint godot_packSnorm4x8(vec4 v) {
349: 	uvec4 uv = uvec4(round(clamp(v, vec4(-1.0), vec4(1.0)) * 127.0) + 127.0);
350: 	return uv.x | uv.y << uint(8) | uv.z << uint(16) | uv.w << uint(24);
351: }
352: 
353: vec4 godot_unpackSnorm4x8(uint p) {
354: 	vec4 v = vec4(float(p & uint(0xff)), float((p >> uint(8)) & uint(0xff)), float((p >> uint(16)) & uint(0xff)), float(p >> uint(24)));
355: 	return clamp((v - vec4(127.0)) * vec4(0.00787401574), vec4(-1.0), vec4(1.0));
356: }
357: 
358: #define packUnorm4x8 godot_packUnorm4x8
359: #define unpackUnorm4x8 godot_unpackUnorm4x8
360: #define packSnorm4x8 godot_packSnorm4x8
361: #define unpackSnorm4x8 godot_unpackSnorm4x8
