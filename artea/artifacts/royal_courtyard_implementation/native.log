138: 	// Exposure bias baked into transform to save shader instructions. Equivalent to `color *= exposure_bias`
139: 	const mat3 rgb_to_rrt = mat3(
140: 			vec3(0.59719f * exposure_bias, 0.35458f * exposure_bias, 0.04823f * exposure_bias),
141: 			vec3(0.07600f * exposure_bias, 0.90834f * exposure_bias, 0.01566f * exposure_bias),
142: 			vec3(0.02840f * exposure_bias, 0.13383f * exposure_bias, 0.83777f * exposure_bias));
143: 
144: 	const mat3 odt_to_rgb = mat3(
145: 			vec3(1.60475f, -0.53108f, -0.07367f),
146: 			vec3(-0.10208f, 1.10813f, -0.00605f),
147: 			vec3(-0.00327f, -0.07276f, 1.07602f));
148: 
149: 	color *= rgb_to_rrt;
150: 	vec3 color_tonemapped = (color * (color + A) - B) / (color * (C * color + D) + E);
151: 	color_tonemapped *= odt_to_rgb;
152: 
153: 	return color_tonemapped / tonemapper_params.x;
154: }
155: 
156: // allenwp tonemapping curve; developed for use in the Godot game engine.
157: // Source and details: https://allenwp.com/blog/2025/05/29/allenwp-tonemapping-curve/
158: // Input must be a non-negative linear scene value.
159: vec3 allenwp_curve(vec3 x) {
160: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
161: 
162: 	// These constants must match the those in the C++ code that calculates the parameters.
163: 	// 18% "middle gray" is perceptually 50% of the brightness of reference white.
164: 	const float awp_crossover_point = 0.18;
165: 	// When output_max_value and/or awp_crossover_point are no longer constant,
166: 	// awp_shoulder_max can be calculated on the CPU and passed in as tonemap_e.
167: 	const float awp_shoulder_max = output_max_value - awp_crossover_point;
168: 
169: 	float awp_contrast = tonemapper_params.x;
170: 	float awp_toe_a = tonemapper_params.y;
171: 	float awp_slope = tonemapper_params.z;
172: 	float awp_w = tonemapper_params.w;
173: 
174: 	// Reinhard-like shoulder:
175: 	vec3 s = x - awp_crossover_point;
176: 	vec3 slope_s = awp_slope * s;
177: 	s = slope_s * (1.0 + s / awp_w) / (1.0 + (slope_s / awp_shoulder_max));
178: 	s += awp_crossover_point;
179: 
180: 	// Sigmoid power function toe:
181: 	vec3 t = pow(x, vec3(awp_contrast));
182: 	t = t / (t + awp_toe_a);
183: 
184: 	return mix(s, t, lessThan(x, vec3(awp_crossover_point)));
185: }
186: 
187: // This is an approximation and simplification of EaryChow's AgX implementation that is used by Blender.
188: // This code is based off of the script that generates the AgX_Base_sRGB.cube LUT that Blender uses.
189: // Source: https://github.com/EaryChow/AgX_LUT_Gen/blob/main/AgXBasesRGB.py
190: // Colorspace transformation source: https://www.colour-science.org:8010/apps/rgb_colourspace_transformation_matrix
191: vec3 tonemap_agx(vec3 color) {
192: 	// Input color should be non-negative!
193: 	// Large negative values in one channel and large positive values in other
194: 	// channels can result in a colour that appears darker and more saturated than
195: 	// desired after passing it through the inset matrix. For this reason, it is
196: 	// best to prevent negative input values.
197: 	// This is done before the Rec. 2020 transform to allow the Rec. 2020
198: 	// transform to be combined with the AgX inset matrix. This results in a loss
199: 	// of color information that could be correctly interpreted within the
200: 	// Rec. 2020 color space as positive RGB values, but is often not worth
201: 	// the performance cost of an additional matrix multiplication.
202: 	//
203: 	// Additionally, this AgX configuration was created subjectively based on
204: 	// output appearance in the Rec. 709 color gamut, so it is possible that these
205: 	// matrices will not perform well with non-Rec. 709 output (more testing with
206: 	// future wide-gamut displays is be needed).
207: 	// See this comment from the author on the decisions made to create the matrices:
208: 	// https://github.com/godotengine/godot-proposals/issues/12317#issuecomment-2835824250
209: 
210: 	// Combined Rec. 709 to Rec. 2020 and Blender AgX inset matrices:
211: 	const mat3 rec709_to_rec2020_agx_inset_matrix = mat3(
212: 			0.544814746488245, 0.140416948464053, 0.0888104196149096,
213: 			0.373787398372697, 0.754137554567394, 0.178871756420858,
214: 			0.0813978551390581, 0.105445496968552, 0.732317823964232);
215: 
216: 	// Combined inverse AgX outset matrix and Rec. 2020 to Rec. 709 matrices.
217: 	const mat3 agx_outset_rec2020_to_rec709_matrix = mat3(
218: 			1.96488741169489, -0.299313364904742, -0.164352742528393,
219: 			-0.855988495690215, 1.32639796461980, -0.238183969428088,
220: 			-0.108898916004672, -0.0270845997150571, 1.40253671195648);
221: 
222: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
223: 
224: 	// Apply inset matrix.
225: 	color = rec709_to_rec2020_agx_inset_matrix * color;
226: 
227: 	// Use the allenwp tonemapping curve to match the Blender AgX curve while
228: 	// providing stability across all variable dyanimc range (SDR, HDR, EDR).
229: 	color = allenwp_curve(color);
230: 
231: 	// Clipping to output_max_value is required to address a cyan colour that occurs
232: 	// with very bright inputs.
233: 	color = min(vec3(output_max_value), color);
234: 
235: 	// Apply outset to make the result more chroma-laden and then go back to Rec. 709.
236: 	color = agx_outset_rec2020_to_rec709_matrix * color;
237: 
238: 	// Blender's lusRGB.compensate_low_side is too complex for this shader, so
239: 	// simply return the color, even if it has negative components. These negative
240: 	// components may be useful for subsequent color adjustments.
241: 	return color;
242: }
243: 
244: #define TONEMAPPER_LINEAR 0
245: #define TONEMAPPER_REINHARD 1
246: #define TONEMAPPER_FILMIC 2
247: #define TONEMAPPER_ACES 3
248: #define TONEMAPPER_AGX 4
249: 
250: vec3 apply_tonemapping(vec3 color) { // inputs are LINEAR
251: 	if (tonemapper == TONEMAPPER_LINEAR) {
252: 		return color;
253: 	}
254: 
255: 	// Ensure color values passed to tonemappers are positive.
256: 	// They can be negative in the case of negative lights, which leads to undesired behavior.
257: 	color = max(vec3(0.0), color);
258: 
259: 	if (tonemapper == TONEMAPPER_REINHARD) {
260: 		return tonemap_reinhard(color);
261: 	} else if (tonemapper == TONEMAPPER_FILMIC) {
262: 		return tonemap_filmic(color);
263: 	} else if (tonemapper == TONEMAPPER_ACES) {
264: 		return tonemap_aces(color);
265: 	} else { // TONEMAPPER_AGX
266: 		return tonemap_agx(color);
267: 	}
268: }
269: 
270: #endif // APPLY_TONEMAPPING
271: #endif
272: // Compatibility renames. These are exposed with the "godot_" prefix
273: // to work around two distinct Adreno bugs:
274: // 1. Some Adreno devices expose ES310 functions in ES300 shaders.
275: //    Internally, we must use the "godot_" prefix, but user shaders
276: //    will be mapped automatically.
277: // 2. Adreno 3XX devices have poor implementations of the other packing
278: //    functions, so we just use our own there to keep it simple.
279: 
280: #ifdef USE_HALF2FLOAT
281: // Floating point pack/unpack functions are part of the GLSL ES 300 specification used by web and mobile.
282: // It appears to be safe to expose these on mobile, but when running through ANGLE this appears to break.
283: uint float2half(uint f) {
284: 	uint e = f & uint(0x7f800000);
285: 	if (e <= uint(0x38000000)) {
286: 		return uint(0);
287: 	} else {
288: 		return ((f >> uint(16)) & uint(0x8000)) |
289: 				(((e - uint(0x38000000)) >> uint(13)) & uint(0x7c00)) |
290: 				((f >> uint(13)) & uint(0x03ff));
291: 	}
292: }
293: 
294: uint half2float(uint h) {
295: 	uint h_e = h & uint(0x7c00);
296: 	return ((h & uint(0x8000)) << uint(16)) | uint((h_e >> uint(10)) != uint(0)) * (((h_e + uint(0x1c000)) << uint(13)) | ((h & uint(0x03ff)) << uint(13)));
297: }
298: 
299: uint godot_packHalf2x16(vec2 v) {
300: 	return float2half(floatBitsToUint(v.x)) | float2half(floatBitsToUint(v.y)) << uint(16);
301: }
302: 
303: vec2 godot_unpackHalf2x16(uint v) {
304: 	return vec2(uintBitsToFloat(half2float(v & uint(0xffff))),
305: 			uintBitsToFloat(half2float(v >> uint(16))));
306: }
307: 
308: uint godot_packUnorm2x16(vec2 v) {
309: 	uvec2 uv = uvec2(round(clamp(v, vec2(0.0), vec2(1.0)) * 65535.0));
310: 	return uv.x | uv.y << uint(16);
311: }
312: 
313: vec2 godot_unpackUnorm2x16(uint p) {
314: 	return vec2(float(p & uint(0xffff)), float(p >> uint(16))) * 0.000015259021; // 1.0 / 65535.0 optimization
315: }
316: 
317: uint godot_packSnorm2x16(vec2 v) {
318: 	uvec2 uv = uvec2(round(clamp(v, vec2(-1.0), vec2(1.0)) * 32767.0) + 32767.0);
319: 	return uv.x | uv.y << uint(16);
320: }
321: 
322: vec2 godot_unpackSnorm2x16(uint p) {
323: 	vec2 v = vec2(float(p & uint(0xffff)), float(p >> uint(16)));
324: 	return clamp((v - 32767.0) * vec2(0.00003051851), vec2(-1.0), vec2(1.0));
325: }
326: 
327: #define packHalf2x16 godot_packHalf2x16
328: #define unpackHalf2x16 godot_unpackHalf2x16
329: #define packUnorm2x16 godot_packUnorm2x16
330: #define unpackUnorm2x16 godot_unpackUnorm2x16
331: #define packSnorm2x16 godot_packSnorm2x16
332: #define unpackSnorm2x16 godot_unpackSnorm2x16
333: 
334: #endif // USE_HALF2FLOAT
335: 
336: // Always expose these as they are ES310 functions and not available in ES300 or GLSL 330.
337: 
338: uint godot_packUnorm4x8(vec4 v) {
339: 	uvec4 uv = uvec4(round(clamp(v, vec4(0.0), vec4(1.0)) * 255.0));
340: 	return uv.x | (uv.y << uint(8)) | (uv.z << uint(16)) | (uv.w << uint(24));
341: }
342: 
343: vec4 godot_unpackUnorm4x8(uint p) {
344: 	return vec4(float(p & uint(0xff)), float((p >> uint(8)) & uint(0xff)), float((p >> uint(16)) & uint(0xff)), float(p >> uint(24))) * 0.00392156862; // 1.0 / 255.0
345: }
346: 
347: uint godot_packSnorm4x8(vec4 v) {
348: 	uvec4 uv = uvec4(round(clamp(v, vec4(-1.0), vec4(1.0)) * 127.0) + 127.0);
349: 	return uv.x | uv.y << uint(8) | uv.z << uint(16) | uv.w << uint(24);
350: }
351: 
352: vec4 godot_unpackSnorm4x8(uint p) {
353: 	vec4 v = vec4(float(p & uint(0xff)), float((p >> uint(8)) & uint(0xff)), float((p >> uint(16)) & uint(0xff)), float(p >> uint(24)));
354: 	return clamp((v - vec4(127.0)) * vec4(0.00787401574), vec4(-1.0), vec4(1.0));
355: }
356: 
357: #define packUnorm4x8 godot_packUnorm4x8
358: #define unpackUnorm4x8 godot_unpackUnorm4x8
359: #define packSnorm4x8 godot_packSnorm4x8
360: #define unpackSnorm4x8 godot_unpackSnorm4x8
