1159: 		diffuse_brdf_NL = cNdotL * (1.0 / M_PI);
1160: #endif
1161: 
1162: 		diffuse_light += light_color * diffuse_brdf_NL * attenuation * cc_attenuation;
1163: 
1164: #if defined(LIGHT_BACKLIGHT_USED)
1165: 		diffuse_light += light_color * (vec3(1.0 / M_PI) - diffuse_brdf_NL) * backlight * attenuation * cc_attenuation;
1166: #endif
1167: 
1168: #if defined(LIGHT_RIM_USED)
1169: 		// Epsilon min to prevent pow(0, 0) singularity which results in undefined behavior.
1170: 		float rim_light = pow(max(1e-4, 1.0 - cNdotV), max(0.0, (1.0 - roughness) * 16.0));
