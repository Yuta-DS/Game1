128: // Adapted from https://github.com/TheRealMJP/BakingLab/blob/master/BakingLab/ACES.hlsl
129: // (MIT License).
130: vec3 tonemap_aces(vec3 color) {
131: 	// These constants must match the those in the C++ code that calculates the parameters.
132: 	const float exposure_bias = 1.8f;
133: 	const float A = 0.0245786f;
134: 	const float B = 0.000090537f;
135: 	const float C = 0.983729f;
136: 	const float D = 0.432951f;
137: 	const float E = 0.238081f;
138: 
139: 	// Exposure bias baked into transform to save shader instructions. Equivalent to `color *= exposure_bias`
140: 	const mat3 rgb_to_rrt = mat3(
141: 			vec3(0.59719f * exposure_bias, 0.35458f * exposure_bias, 0.04823f * exposure_bias),
142: 			vec3(0.07600f * exposure_bias, 0.90834f * exposure_bias, 0.01566f * exposure_bias),
143: 			vec3(0.02840f * exposure_bias, 0.13383f * exposure_bias, 0.83777f * exposure_bias));
144: 
145: 	const mat3 odt_to_rgb = mat3(
146: 			vec3(1.60475f, -0.53108f, -0.07367f),
147: 			vec3(-0.10208f, 1.10813f, -0.00605f),
148: 			vec3(-0.00327f, -0.07276f, 1.07602f));
149: 
150: 	color *= rgb_to_rrt;
151: 	vec3 color_tonemapped = (color * (color + A) - B) / (color * (C * color + D) + E);
152: 	color_tonemapped *= odt_to_rgb;
153: 
154: 	return color_tonemapped / tonemapper_params.x;
155: }
