105: vec3 tonemap_filmic(vec3 color) {
106: 	// These constants must match the those in the C++ code that calculates the parameters.
107: 	// exposure_bias: Input scale (color *= bias, env->white *= bias) to make the brightness consistent with other tonemappers.
108: 	// Also useful to scale the input to the range that the tonemapper is designed for (some require very high input values).
109: 	// Has no effect on the curve's general shape or visual properties.
110: 	const float exposure_bias = 2.0f;
111: 	const float A = 0.22f * exposure_bias * exposure_bias; // bias baked into constants for performance
112: 	const float B = 0.30f * exposure_bias;
113: 	const float C = 0.10f;
114: 	const float D = 0.20f;
115: 	const float E = 0.01f;
116: 	const float F = 0.30f;
117: 
118: 	vec3 color_tonemapped = ((color * (A * color + C * B) + D * E) / (color * (A * color + B) + D * F)) - E / F;
119: 
120: 	return color_tonemapped / tonemapper_params.x;
121: }
122: 
123: // Adapted from https://github.com/TheRealMJP/BakingLab/blob/master/BakingLab/ACES.hlsl
124: // (MIT License).
125: vec3 tonemap_aces(vec3 color) {
126: 	// These constants must match the those in the C++ code that calculates the parameters.
127: 	const float exposure_bias = 1.8f;
128: 	const float A = 0.0245786f;
129: 	const float B = 0.000090537f;
130: 	const float C = 0.983729f;
131: 	const float D = 0.432951f;
132: 	const float E = 0.238081f;
133: 
134: 	// Exposure bias baked into transform to save shader instructions. Equivalent to `color *= exposure_bias`
135: 	const mat3 rgb_to_rrt = mat3(
136: 			vec3(0.59719f * exposure_bias, 0.35458f * exposure_bias, 0.04823f * exposure_bias),
137: 			vec3(0.07600f * exposure_bias, 0.90834f * exposure_bias, 0.01566f * exposure_bias),
138: 			vec3(0.02840f * exposure_bias, 0.13383f * exposure_bias, 0.83777f * exposure_bias));
139: 
140: 	const mat3 odt_to_rgb = mat3(
141: 			vec3(1.60475f, -0.53108f, -0.07367f),
142: 			vec3(-0.10208f, 1.10813f, -0.00605f),
143: 			vec3(-0.00327f, -0.07276f, 1.07602f));
144: 
145: 	color *= rgb_to_rrt;
146: 	vec3 color_tonemapped = (color * (color + A) - B) / (color * (C * color + D) + E);
147: 	color_tonemapped *= odt_to_rgb;
148: 
149: 	return color_tonemapped / tonemapper_params.x;
150: }
151: 
152: // allenwp tonemapping curve; developed for use in the Godot game engine.
153: // Source and details: https://allenwp.com/blog/2025/05/29/allenwp-tonemapping-curve/
154: // Input must be a non-negative linear scene value.
155: vec3 allenwp_curve(vec3 x) {
156: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
157: 
158: 	// These constants must match the those in the C++ code that calculates the parameters.
159: 	// 18% "middle gray" is perceptually 50% of the brightness of reference white.
160: 	const float awp_crossover_point = 0.18;
161: 	// When output_max_value and/or awp_crossover_point are no longer constant,
162: 	// awp_shoulder_max can be calculated on the CPU and passed in as tonemap_e.
163: 	const float awp_shoulder_max = output_max_value - awp_crossover_point;
164: 
165: 	float awp_contrast = tonemapper_params.x;
166: 	float awp_toe_a = tonemapper_params.y;
167: 	float awp_slope = tonemapper_params.z;
168: 	float awp_w = tonemapper_params.w;
169: 
170: 	// Reinhard-like shoulder:
171: 	vec3 s = x - awp_crossover_point;
172: 	vec3 slope_s = awp_slope * s;
173: 	s = slope_s * (1.0 + s / awp_w) / (1.0 + (slope_s / awp_shoulder_max));
174: 	s += awp_crossover_point;
175: 
176: 	// Sigmoid power function toe:
177: 	vec3 t = pow(x, vec3(awp_contrast));
178: 	t = t / (t + awp_toe_a);
179: 
180: 	return mix(s, t, lessThan(x, vec3(awp_crossover_point)));
181: }
182: 
183: // This is an approximation and simplification of EaryChow's AgX implementation that is used by Blender.
184: // This code is based off of the script that generates the AgX_Base_sRGB.cube LUT that Blender uses.
185: // Source: https://github.com/EaryChow/AgX_LUT_Gen/blob/main/AgXBasesRGB.py
186: // Colorspace transformation source: https://www.colour-science.org:8010/apps/rgb_colourspace_transformation_matrix
187: vec3 tonemap_agx(vec3 color) {
188: 	// Input color should be non-negative!
189: 	// Large negative values in one channel and large positive values in other
190: 	// channels can result in a colour that appears darker and more saturated than
191: 	// desired after passing it through the inset matrix. For this reason, it is
192: 	// best to prevent negative input values.
193: 	// This is done before the Rec. 2020 transform to allow the Rec. 2020
194: 	// transform to be combined with the AgX inset matrix. This results in a loss
195: 	// of color information that could be correctly interpreted within the
196: 	// Rec. 2020 color space as positive RGB values, but is often not worth
197: 	// the performance cost of an additional matrix multiplication.
198: 	//
199: 	// Additionally, this AgX configuration was created subjectively based on
200: 	// output appearance in the Rec. 709 color gamut, so it is possible that these
201: 	// matrices will not perform well with non-Rec. 709 output (more testing with
202: 	// future wide-gamut displays is be needed).
203: 	// See this comment from the author on the decisions made to create the matrices:
204: 	// https://github.com/godotengine/godot-proposals/issues/12317#issuecomment-2835824250
205: 
206: 	// Combined Rec. 709 to Rec. 2020 and Blender AgX inset matrices:
207: 	const mat3 rec709_to_rec2020_agx_inset_matrix = mat3(
208: 			0.544814746488245, 0.140416948464053, 0.0888104196149096,
209: 			0.373787398372697, 0.754137554567394, 0.178871756420858,
210: 			0.0813978551390581, 0.105445496968552, 0.732317823964232);
211: 
212: 	// Combined inverse AgX outset matrix and Rec. 2020 to Rec. 709 matrices.
213: 	const mat3 agx_outset_rec2020_to_rec709_matrix = mat3(
214: 			1.96488741169489, -0.299313364904742, -0.164352742528393,
215: 			-0.855988495690215, 1.32639796461980, -0.238183969428088,
216: 			-0.108898916004672, -0.0270845997150571, 1.40253671195648);
217: 
218: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
219: 
220: 	// Apply inset matrix.
221: 	color = rec709_to_rec2020_agx_inset_matrix * color;
222: 
223: 	// Use the allenwp tonemapping curve to match the Blender AgX curve while
224: 	// providing stability across all variable dyanimc range (SDR, HDR, EDR).
225: 	color = allenwp_curve(color);
226: 
227: 	// Clipping to output_max_value is required to address a cyan colour that occurs
228: 	// with very bright inputs.
229: 	color = min(vec3(output_max_value), color);
230: 
231: 	// Apply outset to make the result more chroma-laden and then go back to Rec. 709.
232: 	color = agx_outset_rec2020_to_rec709_matrix * color;
233: 
234: 	// Blender's lusRGB.compensate_low_side is too complex for this shader, so
235: 	// simply return the color, even if it has negative components. These negative
236: 	// components may be useful for subsequent color adjustments.
237: 	return color;
238: }
239: 
240: #define TONEMAPPER_LINEAR 0
241: #define TONEMAPPER_REINHARD 1
242: #define TONEMAPPER_FILMIC 2
243: #define TONEMAPPER_ACES 3
244: #define TONEMAPPER_AGX 4
245: 
246: vec3 apply_tonemapping(vec3 color) { // inputs are LINEAR
247: 	if (tonemapper == TONEMAPPER_LINEAR) {
248: 		return color;
249: 	}
250: 
251: 	// Ensure color values passed to tonemappers are positive.
252: 	// They can be negative in the case of negative lights, which leads to undesired behavior.
253: 	color = max(vec3(0.0), color);
254: 
255: 	if (tonemapper == TONEMAPPER_REINHARD) {
256: 		return tonemap_reinhard(color);
257: 	} else if (tonemapper == TONEMAPPER_FILMIC) {
258: 		return tonemap_filmic(color);
259: 	} else if (tonemapper == TONEMAPPER_ACES) {
260: 		return tonemap_aces(color);
261: 	} else { // TONEMAPPER_AGX
262: 		return tonemap_agx(color);
263: 	}
264: }
265: 
266: #endif // APPLY_TONEMAPPING
267: #endif
268: // Compatibility renames. These are exposed with the "godot_" prefix
269: // to work around two distinct Adreno bugs:
270: // 1. Some Adreno devices expose ES310 functions in ES300 shaders.
271: //    Internally, we must use the "godot_" prefix, but user shaders
272: //    will be mapped automatically.
273: // 2. Adreno 3XX devices have poor implementations of the other packing
274: //    functions, so we just use our own there to keep it simple.
275: 
276: #ifdef USE_HALF2FLOAT
277: // Floating point pack/unpack functions are part of the GLSL ES 300 specification used by web and mobile.
278: // It appears to be safe to expose these on mobile, but when running through ANGLE this appears to break.
279: uint float2half(uint f) {
280: 	uint e = f & uint(0x7f800000);
281: 	if (e <= uint(0x38000000)) {
282: 		return uint(0);
283: 	} else {
284: 		return ((f >> uint(16)) & uint(0x8000)) |
285: 				(((e - uint(0x38000000)) >> uint(13)) & uint(0x7c00)) |
286: 				((f >> uint(13)) & uint(0x03ff));
287: 	}
288: }
289: 
290: uint half2float(uint h) {
291: 	uint h_e = h & uint(0x7c00);
292: 	return ((h & uint(0x8000)) << uint(16)) | uint((h_e >> uint(10)) != uint(0)) * (((h_e + uint(0x1c000)) << uint(13)) | ((h & uint(0x03ff)) << uint(13)));
293: }
294: 
295: uint godot_packHalf2x16(vec2 v) {
296: 	return float2half(floatBitsToUint(v.x)) | float2half(floatBitsToUint(v.y)) << uint(16);
297: }
298: 
299: vec2 godot_unpackHalf2x16(uint v) {
300: 	return vec2(uintBitsToFloat(half2float(v & uint(0xffff))),
301: 			uintBitsToFloat(half2float(v >> uint(16))));
302: }
303: 
304: uint godot_packUnorm2x16(vec2 v) {
305: 	uvec2 uv = uvec2(round(clamp(v, vec2(0.0), vec2(1.0)) * 65535.0));
306: 	return uv.x | uv.y << uint(16);
307: }
308: 
309: vec2 godot_unpackUnorm2x16(uint p) {
310: 	return vec2(float(p & uint(0xffff)), float(p >> uint(16))) * 0.000015259021; // 1.0 / 65535.0 optimization
311: }
312: 
313: uint godot_packSnorm2x16(vec2 v) {
314: 	uvec2 uv = uvec2(round(clamp(v, vec2(-1.0), vec2(1.0)) * 32767.0) + 32767.0);
315: 	return uv.x | uv.y << uint(16);
316: }
317: 
318: vec2 godot_unpackSnorm2x16(uint p) {
319: 	vec2 v = vec2(float(p & uint(0xffff)), float(p >> uint(16)));
320: 	return clamp((v - 32767.0) * vec2(0.00003051851), vec2(-1.0), vec2(1.0));
321: }
322: 
323: #define packHalf2x16 godot_packHalf2x16
324: #define unpackHalf2x16 godot_unpackHalf2x16
325: #define packUnorm2x16 godot_packUnorm2x16
326: #define unpackUnorm2x16 godot_unpackUnorm2x16
327: #define packSnorm2x16 godot_packSnorm2x16
328: #define unpackSnorm2x16 godot_unpackSnorm2x16
329: 
330: #endif // USE_HALF2FLOAT
331: 
332: // Always expose these as they are ES310 functions and not available in ES300 or GLSL 330.
333: 
334: uint godot_packUnorm4x8(vec4 v) {
335: 	uvec4 uv = uvec4(round(clamp(v, vec4(0.0), vec4(1.0)) * 255.0));
336: 	return uv.x | (uv.y << uint(8)) | (uv.z << uint(16)) | (uv.w << uint(24));
337: }
338: 
339: vec4 godot_unpackUnorm4x8(uint p) {
340: 	return vec4(float(p & uint(0xff)), float((p >> uint(8)) & uint(0xff)), float((p >> uint(16)) & uint(0xff)), float(p >> uint(24))) * 0.00392156862; // 1.0 / 255.0
341: }
342: 
343: uint godot_packSnorm4x8(vec4 v) {
344: 	uvec4 uv = uvec4(round(clamp(v, vec4(-1.0), vec4(1.0)) * 127.0) + 127.0);
345: 	return uv.x | uv.y << uint(8) | uv.z << uint(16) | uv.w << uint(24);
346: }
347: 
348: vec4 godot_unpackSnorm4x8(uint p) {
349: 	vec4 v = vec4(float(p & uint(0xff)), float((p >> uint(8)) & uint(0xff)), float((p >> uint(16)) & uint(0xff)), float(p >> uint(24)));
350: 	return clamp((v - vec4(127.0)) * vec4(0.00787401574), vec4(-1.0), vec4(1.0));
351: }
352: 
353: #define packUnorm4x8 godot_packUnorm4x8
354: #define unpackUnorm4x8 godot_unpackUnorm4x8
355: #define packSnorm4x8 godot_packSnorm4x8
356: #define unpackSnorm4x8 godot_unpackSnorm4x8
357: 
