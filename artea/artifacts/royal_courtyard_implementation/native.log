1022: vec3 F0(float metallic, float specular, vec3 albedo) {
1023: 	float dielectric = 0.16 * specular * specular;
1024: 	// use albedo * metallic as colored specular reflectance at 0 angle for metallic materials;
1025: 	// see https://google.github.io/filament/Filament.md.html
1026: 	return mix(vec3(dielectric), albedo, vec3(metallic));
1027: }
