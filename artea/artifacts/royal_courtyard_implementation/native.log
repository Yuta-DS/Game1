1731: vec4 fog_process(vec3 vertex) {
1732: 	vec3 fog_color = scene_data_block.data.fog_light_color;
1733: 
1734: #ifdef USE_RADIANCE_MAP
1735: /*
1736: 		if (scene_data_block.data.fog_aerial_perspective > 0.0) {
1737: 		vec3 sky_fog_color = vec3(0.0);
1738: 		vec3 cube_view = scene_data_block.data.radiance_inverse_xform * vertex;
1739: 		// mip_level always reads from the second mipmap and higher so the fog is always slightly blurred
1740: 		float mip_level = mix(1.0 / MAX_ROUGHNESS_LOD, 1.0, 1.0 - (abs(vertex.z) - scene_data_block.data.z_near) / (scene_data_block.data.z_far - scene_data_block.data.z_near));
1741: 
1742: 		sky_fog_color = textureLod(radiance_map, cube_view, mip_level * RADIANCE_MAX_LOD).rgb;
1743: 
1744: 		fog_color = mix(fog_color, sky_fog_color, scene_data_block.data.fog_aerial_perspective);
1745: 	}
1746: 	*/
1747: #endif
1748: 
1749: #ifdef USE_SUN_SCATTER
1750: 	vec4 sun_scatter = vec4(0.0);
1751: 	float sun_total = 0.0;
1752: 	vec3 view = normalize(vertex);
1753: 	for (uint i = uint(0); i < scene_data_block.data.directional_light_count; i++) {
1754: 		vec3 light_color = directional_lights[i].color * directional_lights[i].energy;
1755: 		float light_amount = pow(max(dot(view, directional_lights[i].direction), 0.0), 8.0);
1756: 		fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
1757: 	}
1758: 	for (uint i = uint(MAX_DIRECTIONAL_LIGHT_DATA_STRUCTS) - uint(scene_data_block.data.directional_shadow_count); i < uint(MAX_DIRECTIONAL_LIGHT_DATA_STRUCTS); i++) {
1759: 		vec3 light_color = directional_lights[i].color * directional_lights[i].energy;
1760: 		float light_amount = pow(max(dot(view, directional_lights[i].direction), 0.0), 8.0);
1761: 		fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
1762: 	}
1763: #endif // USE_SUN_SCATTER
1764: 
1765: 	float fog_amount = 0.0;
1766: 
1767: #ifdef USE_DEPTH_FOG
1768: 	float fog_z = smoothstep(scene_data_block.data.fog_depth_begin, scene_data_block.data.fog_depth_end, length(vertex));
1769: 	fog_amount = pow(fog_z, scene_data_block.data.fog_depth_curve) * scene_data_block.data.fog_density;
1770: #else
1771: 	fog_amount = 1.0 - exp(min(0.0, -length(vertex) * scene_data_block.data.fog_density));
1772: #endif // USE_DEPTH_FOG
1773: 
1774: 	if (abs(scene_data_block.data.fog_height_density) >= 0.0001) {
1775: 		float y = (scene_data_block.data.inv_view_matrix * vec4(vertex, 1.0)).y;
1776: 
1777: 		float y_dist = y - scene_data_block.data.fog_height;
1778: 
1779: 		float vfog_amount = 1.0 - exp(min(0.0, y_dist * scene_data_block.data.fog_height_density));
1780: 
1781: 		fog_amount = max(vfog_amount, fog_amount);
1782: 	}
1783: 
1784: 	return vec4(fog_color, fog_amount);
1785: }
