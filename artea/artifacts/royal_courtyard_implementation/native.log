1823: 		vec3 rbminmax = mix(rbmin, rbmax, vec3(greaterThan(nrdir, vec3(0.0, 0.0, 0.0))));
1824: 
1825: 		float fa = min(min(rbminmax.x, rbminmax.y), rbminmax.z);
1826: 		vec3 posonbox = local_pos + nrdir * fa;
1827: 		ref_normal = posonbox - box_offset.xyz;
