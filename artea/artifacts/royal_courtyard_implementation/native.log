1097: 	float area_specular = 1.0;
1098: 	vec3 area_diffuse_tex_color = vec3(1.0);
1099: 	vec3 area_specular_tex_color = vec3(1.0);
1100: 
1101: 	/* clang-format off */
1102: 
1103: 
1104: 	/* clang-format on */
1105: 
1106: #else
1107: 	float NdotL = min(A + dot(N, L), 1.0);
1108: 	float cNdotL = max(NdotL, 0.0); // clamped NdotL
1109: 	float NdotV = dot(N, V);
1110: 	float cNdotV = max(NdotV, 1e-4);
1111: 
1112: 	float cc_attenuation = 1.0;
1113: 
1114: #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1115: 	vec3 H = normalize(V + L);
1116: #endif
1117: 
1118: #if defined(SPECULAR_SCHLICK_GGX)
1119: 	float cNdotH = clamp(A + dot(N, H), 0.0, 1.0);
1120: #endif
1121: 
1122: #if defined(DIFFUSE_BURLEY) || defined(SPECULAR_SCHLICK_GGX) || defined(LIGHT_CLEARCOAT_USED)
1123: 	float cLdotH = clamp(A + dot(L, H), 0.0, 1.0);
1124: #endif
1125: 
1126: #if defined(LIGHT_CLEARCOAT_USED)
1127: 	// Clearcoat ignores normal_map, use vertex normal instead
1128: 	float ccNdotL = clamp(A + dot(vertex_normal, L), 0.0, 1.0);
1129: 	float ccNdotH = clamp(A + dot(vertex_normal, H), 0.0, 1.0);
1130: 	float cLdotH5 = SchlickFresnel(cLdotH);
1131: 
1132: 	float Dr = D_GGX(ccNdotH, mix(0.001, 0.1, clearcoat_roughness));
1133: 	float Gr = V_Kelemen(cLdotH);
1134: 	float Fr = mix(0.04, 1.0, cLdotH5) * clearcoat;
1135: 	cc_attenuation = 1.0 - Fr;
1136: 	float clearcoat_specular_brdf_NL = Dr * Gr * Fr * ccNdotL;
1137: 
1138: 	specular_light += clearcoat_specular_brdf_NL * light_color * attenuation * specular_amount;
1139: #endif // LIGHT_CLEARCOAT_USED
1140: 
1141: 	if (metallic < 1.0) {
1142: 		float diffuse_brdf_NL; // BRDF times N.L for calculating diffuse radiance
1143: 
1144: #if defined(DIFFUSE_LAMBERT_WRAP)
1145: 		// Energy conserving lambert wrap shader.
1146: 		// https://web.archive.org/web/20210228210901/http://blog.stevemcauley.com/2011/12/03/energy-conserving-wrapped-diffuse/
1147: 		diffuse_brdf_NL = max(0.0, (NdotL + roughness) / ((1.0 + roughness) * (1.0 + roughness))) * (1.0 / M_PI);
1148: #elif defined(DIFFUSE_TOON)
1149: 		diffuse_brdf_NL = smoothstep(-roughness, max(roughness, 0.01), NdotL) * (1.0 / M_PI);
1150: #elif defined(DIFFUSE_BURLEY)
1151: 		{
1152: 			float FD90_minus_1 = 2.0 * cLdotH * cLdotH * roughness - 0.5;
1153: 			float FdV = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotV);
1154: 			float FdL = 1.0 + FD90_minus_1 * SchlickFresnel(cNdotL);
1155: 			diffuse_brdf_NL = (1.0 / M_PI) * FdV * FdL * cNdotL;
1156: 		}
1157: #else
1158: 		// Lambert
1159: 		diffuse_brdf_NL = cNdotL * (1.0 / M_PI);
1160: #endif
1161: 
1162: 		diffuse_light += light_color * diffuse_brdf_NL * attenuation * cc_attenuation;
1163: 
1164: #if defined(LIGHT_BACKLIGHT_USED)
1165: 		diffuse_light += light_color * (vec3(1.0 / M_PI) - diffuse_brdf_NL) * backlight * attenuation * cc_attenuation;
1166: #endif
1167: 
1168: #if defined(LIGHT_RIM_USED)
1169: 		// Epsilon min to prevent pow(0, 0) singularity which results in undefined behavior.
1170: 		float rim_light = pow(max(1e-4, 1.0 - cNdotV), max(0.0, (1.0 - roughness) * 16.0));
1171: 		diffuse_light += rim_light * rim * mix(vec3(1.0), albedo, rim_tint) * light_color;
1172: #endif
1173: 	}
1174: 
1175: 	if (roughness > 0.0) { // FIXME: roughness == 0 should not disable specular light entirely
1176: 
1177: 		// D
1178: 
1179: #if defined(SPECULAR_TOON)
1180: 
1181: 		vec3 R = normalize(-reflect(L, N));
1182: 		float RdotV = dot(R, V);
1183: 		float mid = 1.0 - roughness;
1184: 		mid *= mid;
1185: 		float intensity = smoothstep(mid - roughness * 0.5, mid + roughness * 0.5, RdotV) * mid;
1186: 		diffuse_light += light_color * intensity * attenuation * specular_amount; // write to diffuse_light, as in toon shading you generally want no reflection
1187: 
1188: #elif defined(SPECULAR_DISABLED)
1189: 		// none..
1190: 
1191: #elif defined(SPECULAR_SCHLICK_GGX)
1192: 		// shlick+ggx as default
1193: 		float alpha_ggx = roughness * roughness;
1194: #if defined(LIGHT_ANISOTROPY_USED)
1195: 		float aspect = sqrt(1.0 - anisotropy * 0.9);
1196: 		float ax = alpha_ggx / aspect;
1197: 		float ay = alpha_ggx * aspect;
1198: 		float XdotH = dot(T, H);
1199: 		float YdotH = dot(B, H);
1200: 		float D = D_GGX_anisotropic(cNdotH, ax, ay, XdotH, YdotH);
1201: 		float G = V_GGX_anisotropic(ax, ay, dot(T, V), dot(T, L), dot(B, V), dot(B, L), cNdotV, cNdotL);
1202: #else
1203: 		float D = D_GGX(cNdotH, alpha_ggx);
1204: 		float G = V_GGX(cNdotL, cNdotV, alpha_ggx);
1205: #endif // LIGHT_ANISOTROPY_USED
1206: 	   // F
1207: #if !defined(LIGHT_CLEARCOAT_USED)
1208: 		float cLdotH5 = SchlickFresnel(cLdotH);
1209: #endif
1210: 		// Calculate Fresnel using cheap approximate specular occlusion term from Filament:
1211: 		// https://google.github.io/filament/Filament.html#lighting/occlusion/specularocclusion
1212: 		float f90 = clamp(50.0 * f0.g, 0.0, 1.0);
1213: 		vec3 F = f0 + (f90 - f0) * cLdotH5;
1214: 
1215: 		vec3 specular_brdf_NL = cNdotL * D * F * G;
1216: 
1217: 		specular_light += specular_brdf_NL * light_color * attenuation * cc_attenuation * specular_amount;
1218: #endif
1219: 	}
1220: 
1221: #ifdef USE_SHADOW_TO_OPACITY
1222: 	alpha = min(alpha, clamp(1.0 - attenuation, 0.0, 1.0));
1223: #endif
1224: 
1225: #endif // LIGHT_CODE_USED
1226: }
1227: 
1228: float get_omni_spot_attenuation(float distance, float inv_range, float decay) {
1229: 	float nd = distance * inv_range;
1230: 	nd *= nd;
1231: 	nd *= nd; // nd^4
1232: 	nd = max(1.0 - nd, 0.0);
1233: 	nd *= nd; // nd^2
1234: 	return nd * pow(max(distance, 0.0001), -decay);
1235: }
