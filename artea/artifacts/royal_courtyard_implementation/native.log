1787: #define REFLECTION_AMBIENT_COLOR 2
1788: 
1789: void reflection_process(samplerCube reflection_map,
1790: 		vec3 normal, vec3 vertex,
1791: 		mat4 local_matrix,
1792: 		bool use_box_project, vec3 box_extents, vec3 box_offset,
1793: 		bool exterior, float intensity, float blend_distance, int ref_ambient_mode, vec4 ref_ambient_color,
1794: 		float roughness, vec3 ambient, vec3 skybox,
1795: 		inout highp vec4 reflection_accum, inout highp vec4 ambient_accum) {
1796: 	vec4 reflection;
1797: 
1798: 	vec3 local_pos = (local_matrix * vec4(vertex, 1.0)).xyz;
1799: 
1800: 	if (any(greaterThan(abs(local_pos), box_extents))) { //out of the reflection box
1801: 		return;
1802: 	}
1803: 
1804: 	float blend = 1.0;
1805: 	if (blend_distance != 0.0) {
1806: 		vec3 axis_blend_distance = min(vec3(blend_distance), box_extents);
1807: 		vec3 blend_axes = abs(local_pos) - box_extents + axis_blend_distance;
1808: 		blend_axes /= axis_blend_distance;
1809: 		blend_axes = clamp(1.0 - blend_axes, vec3(0.0), vec3(1.0));
1810: 
1811: 		blend = pow(blend_axes.x * blend_axes.y * blend_axes.z, 2.0);
1812: 	}
1813: 
1814: 	//reflect and make local
1815: 	vec3 ref_normal = normalize(reflect(vertex, normal));
1816: 	ref_normal = (local_matrix * vec4(ref_normal, 0.0)).xyz;
1817: 
1818: 	if (use_box_project) { //box project
1819: 
1820: 		vec3 nrdir = normalize(ref_normal);
1821: 		vec3 rbmax = (box_extents - local_pos) / nrdir;
1822: 		vec3 rbmin = (-box_extents - local_pos) / nrdir;
1823: 
1824: 		vec3 rbminmax = mix(rbmin, rbmax, vec3(greaterThan(nrdir, vec3(0.0, 0.0, 0.0))));
1825: 
1826: 		float fa = min(min(rbminmax.x, rbminmax.y), rbminmax.z);
1827: 		vec3 posonbox = local_pos + nrdir * fa;
1828: 		ref_normal = posonbox - box_offset.xyz;
1829: 	}
1830: 
1831: 	reflection.rgb = srgb_to_linear(textureLod(reflection_map, ref_normal, roughness * MAX_ROUGHNESS_LOD).rgb);
1832: 
1833: 	if (exterior) {
1834: 		reflection.rgb = mix(skybox, reflection.rgb, blend);
1835: 	}
1836: 	reflection.rgb *= intensity;
1837: 	reflection.a = blend;
1838: 	reflection.rgb *= blend;
1839: 
1840: 	reflection_accum += reflection;
1841: 
1842: #ifndef USE_LIGHTMAP
1843: 	if (ref_ambient_mode == REFLECTION_AMBIENT_ENVIRONMENT) {
1844: 		vec4 ambient_out;
1845: 		vec3 amb_normal = (local_matrix * vec4(normal, 0.0)).xyz;
1846: 
1847: 		ambient_out.rgb = srgb_to_linear(textureLod(reflection_map, amb_normal, MAX_ROUGHNESS_LOD).rgb);
1848: 		if (exterior) {
1849: 			ambient_out.rgb = mix(ambient, ambient_out.rgb, blend);
1850: 		}
1851: 
1852: 		ambient_out.a = blend;
1853: 		ambient_out.rgb *= blend;
1854: 		ambient_accum += ambient_out;
1855: 	} else if (ref_ambient_mode == REFLECTION_AMBIENT_COLOR) {
1856: 		vec4 ambient_out;
1857: 		ambient_out.rgb = ref_ambient_color.rgb;
1858: 		if (exterior) {
1859: 			ambient_out.rgb = mix(ambient, ambient_out.rgb, blend);
1860: 		}
1861: 
1862: 		ambient_out.a = blend;
1863: 		ambient_out.rgb *= blend;
1864: 		ambient_accum += ambient_out;
1865: 	}
1866: #endif // USE_LIGHTMAP
1867: }
1868: 
1869: #endif // DISABLE_REFLECTION_PROBE
