124: // Adapted from https://github.com/TheRealMJP/BakingLab/blob/master/BakingLab/ACES.hlsl
125: // (MIT License).
126: vec3 tonemap_aces(vec3 color) {
127: 	// These constants must match the those in the C++ code that calculates the parameters.
128: 	const float exposure_bias = 1.8f;
129: 	const float A = 0.0245786f;
130: 	const float B = 0.000090537f;
131: 	const float C = 0.983729f;
132: 	const float D = 0.432951f;
133: 	const float E = 0.238081f;
134: 
135: 	// Exposure bias baked into transform to save shader instructions. Equivalent to `color *= exposure_bias`
136: 	const mat3 rgb_to_rrt = mat3(
137: 			vec3(0.59719f * exposure_bias, 0.35458f * exposure_bias, 0.04823f * exposure_bias),
138: 			vec3(0.07600f * exposure_bias, 0.90834f * exposure_bias, 0.01566f * exposure_bias),
139: 			vec3(0.02840f * exposure_bias, 0.13383f * exposure_bias, 0.83777f * exposure_bias));
140: 
141: 	const mat3 odt_to_rgb = mat3(
142: 			vec3(1.60475f, -0.53108f, -0.07367f),
143: 			vec3(-0.10208f, 1.10813f, -0.00605f),
144: 			vec3(-0.00327f, -0.07276f, 1.07602f));
145: 
146: 	color *= rgb_to_rrt;
147: 	vec3 color_tonemapped = (color * (color + A) - B) / (color * (C * color + D) + E);
148: 	color_tonemapped *= odt_to_rgb;
149: 
150: 	return color_tonemapped / tonemapper_params.x;
151: }
