1531: // implementation of area lights with Linearly Transformed Cosines (LTC): https://eheitzresearch.wordpress.com/415-2/
1532: void light_process_area(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 f0, float roughness, float metallic, float shadow, vec3 albedo, inout float alpha, vec2 screen_uv,
1533: #ifdef LIGHT_BACKLIGHT_USED
1534: 		vec3 backlight,
1535: #endif
1536: #ifdef LIGHT_RIM_USED
1537: 		float rim, float rim_tint,
1538: #endif
1539: #ifdef LIGHT_CLEARCOAT_USED
1540: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1541: #endif
1542: #ifdef LIGHT_ANISOTROPY_USED
1543: 		vec3 binormal, vec3 tangent, float anisotropy,
1544: #endif
1545: 		inout vec3 diffuse_light, inout vec3 specular_light) {
1546: 	float EPSILON = 1e-7f;
1547: 	vec3 area_width = area_lights[idx].area_width.xyz;
1548: 	vec3 area_height = area_lights[idx].area_height.xyz;
1549: 	vec3 area_direction = area_lights[idx].direction;
1550: 
1551: 	if (dot(area_width, area_width) < EPSILON || dot(area_height, area_height) < EPSILON) { // area is 0
1552: 		return;
1553: 	}
1554: 	if (dot(area_direction, vertex - area_lights[idx].position) <= 0.0) {
1555: 		return; // vertex is behind light
1556: 	}
1557: 
1558: 	float a_len = length(area_width);
1559: 	float b_len = length(area_height);
1560: 	float a_half_len = a_len / 2.0;
1561: 	float b_half_len = b_len / 2.0;
1562: 	vec3 light_center = area_lights[idx].position;
1563: 	vec3 light_to_vert = vertex - light_center;
1564: 	vec3 pos_local_to_light = vec3(dot(light_to_vert, normalize(area_width)), dot(light_to_vert, normalize(area_height)), dot(light_to_vert, -area_direction));
1565: 
1566: 	vec3 closest_point_local_to_light = vec3(clamp(pos_local_to_light.x, -a_half_len, a_half_len), clamp(pos_local_to_light.y, -b_half_len, b_half_len), 0);
1567: 	float dist = length(closest_point_local_to_light - pos_local_to_light);
1568: 
1569: 	vec3 points[4];
1570: 	vec3 h_area_width = area_width / 2.0;
1571: 	vec3 h_area_height = area_height / 2.0;
1572: 	points[0] = area_lights[idx].position - h_area_width - h_area_height - vertex;
1573: 	points[1] = area_lights[idx].position + h_area_width - h_area_height - vertex;
1574: 	points[2] = area_lights[idx].position + h_area_width + h_area_height - vertex;
1575: 	points[3] = area_lights[idx].position - h_area_width + h_area_height - vertex;
1576: 
1577: 	float ltc_diffuse = 0.0;
1578: 	float ltc_specular = 0.0;
1579: 	vec2 ltc_fresnel = vec2(0.0);
1580: 	ltc_evaluate(normal, eye_vec, mat3(1), points, ltc_diffuse);
1581: 	ltc_evaluate_specular(normal, eye_vec, roughness, points, ltc_lut1, ltc_lut2, ltc_specular, ltc_fresnel);
1582: 
1583: 	float f90 = clamp(dot(f0, vec3(50.0 * 0.33)), metallic, 1.0);
1584: 	vec3 fresnel_color = f0 * max(ltc_fresnel.x, 0.0) + (f90 - f0) * max(ltc_fresnel.y, 0.0);
1585: 
1586: 	float light_length = max(0.0, dist);
1587: 	float light_attenuation_raw = get_omni_spot_attenuation(light_length, area_lights[idx].inv_radius, area_lights[idx].attenuation);
1588: 	float light_attenuation_ltc = light_attenuation_raw * light_length * light_length; // solid angle already decreases by inverse square, so attenuation power is 2.0 by default -> subtract 2.0
1589: 
1590: 	vec3 light_color = area_lights[idx].color;
1591: 	light_attenuation_ltc = light_attenuation_ltc * shadow;
1592: 	float light_attenuation = light_attenuation_raw * shadow;
1593: 	float specular_amount = area_lights[idx].specular_amount;
1594: 
1595: #if defined(LIGHT_CODE_USED) && defined(AREA_LIGHT_CODE_USED)
1596: 	// light is written by the light shader
1597: 
1598: 	highp mat4 model_matrix = world_transform;
1599: 	mat4 projection_matrix = scene_data_block.data.projection_matrix;
1600: 	mat4 inv_projection_matrix = scene_data_block.data.inv_projection_matrix;
1601: 
1602: 	vec3 light = (light_center - vertex) / light_length;
1603: 	vec3 view = eye_vec;
1604: 
1605: 	bool is_area = true;
1606: 	vec3 area_diffuse = vec3(ltc_diffuse);
1607: 	vec3 area_specular = ltc_specular * fresnel_color;
1608: 	float attenuation = light_attenuation_ltc;
1609: 
1610: 	/* clang-format off */
1611: 
1612: 
1613: 	/* clang-format on */
1614: 
1615: #else
1616: 	float area = a_len * b_len;
1617: 	float cc_attenuation = 1.0;
1618: 
1619: #if defined(LIGHT_BACKLIGHT_USED) || defined(LIGHT_RIM_USED) || defined(DIFFUSE_TOON) || defined(SPECULAR_TOON)
1620: 	float solid_angle = quad_solid_angle(points);
1621: #endif
1622: 
1623: #if defined(LIGHT_CLEARCOAT_USED)
1624: 	float cc_specular_ltc = 0.0;
1625: 	vec2 cc_fresnel = vec2(0.0);
1626: 	ltc_evaluate_specular(vertex_normal, eye_vec, sqrt(mix(0.001, 0.1, float(clearcoat_roughness))), points, ltc_lut1, ltc_lut2, cc_specular_ltc, cc_fresnel);
1627: 	float Fr = (0.04 * max(cc_fresnel.x, 0.0) + (1.0 - 0.04) * max(cc_fresnel.y, 0.0)) * clearcoat;
1628: 	cc_attenuation = 1.0 - Fr;
1629: 	specular_light += cc_specular_ltc * Fr * light_color * light_attenuation_ltc * specular_amount;
1630: #endif // LIGHT_CLEARCOAT_USED
1631: 
1632: 	if (metallic < 1.0) {
1633: #if defined(DIFFUSE_TOON)
1634: 		float backface_ltc_diffuse = 0.0;
1635: 		ltc_evaluate(vec3(-normal), vec3(eye_vec), mat3(1), points, backface_ltc_diffuse);
1636: 		float NdotL = (ltc_diffuse - backface_ltc_diffuse) / (max(solid_angle, 0.001) / M_PI);
1637: 		float diffuse_brdf_NL = smoothstep(-roughness, max(roughness, 0.01), NdotL) * (1.0 / M_PI);
1638: 		diffuse_light += diffuse_brdf_NL * light_color * area * light_attenuation * cc_attenuation;
1639: #else
1640: 		diffuse_light += ltc_diffuse * light_color * light_attenuation_ltc * cc_attenuation;
1641: #endif // DIFFUSE_TOON
1642: 
1643: #if defined(LIGHT_BACKLIGHT_USED)
1644: 		diffuse_light += light_color * max((solid_angle / M_PI) - ltc_diffuse, 0.0) * backlight * light_attenuation_ltc;
1645: #endif
1646: 	}
1647: 
1648: #if defined(LIGHT_RIM_USED) // same as for point lights
1649: 	float cNdotV = max(dot(normal, eye_vec), 1e-4);
1650: 	float rim_light = pow(max(1e-4, 1.0 - cNdotV), max(0.0, (1.0 - roughness) * 16.0));
1651: 	diffuse_light += rim_light * rim * mix(vec3(1.0), albedo, rim_tint) * light_color * solid_angle * light_attenuation_ltc;
1652: #endif
1653: 
1654: #if defined(SPECULAR_TOON)
1655: 	// If ltc_specular turns out to be not similar enough to RdotV, since its based on GGX, toon shading would need its own lookup-table.
1656: 	float mid = 1.0 - roughness;
1657: 	mid *= mid;
1658: 
1659: 	float RdotV = ltc_specular / (max(solid_angle, 0.001) / (M_PI));
1660: 	float intensity = smoothstep(mid - roughness * 0.5, mid + roughness * 0.5, RdotV) * mid; // should we use specular tex color here?? or diffuse? or white?
1661: 	diffuse_light += intensity * light_color * area * light_attenuation * specular_amount; // write to diffuse_light, as in toon shading you generally want no reflection
1662: #elif defined(SPECULAR_DISABLED)
1663: 	// do nothing
1664: #else
1665: 	vec3 spec = ltc_specular * light_color * fresnel_color;
1666: 	specular_light += spec * specular_amount * light_attenuation_ltc * cc_attenuation;
1667: #endif // SPECULAR_TOON
1668: #endif // LIGHT_CODE_USED
1669: }
1670: #endif // !DISABLE_LIGHT_AREA
1671: 
1672: #if !defined(DISABLE_LIGHT_SPOT) || defined(ADDITIVE_SPOT)
1673: void light_process_spot(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 f0, float roughness, float metallic, float shadow, vec3 albedo, inout float alpha, vec2 screen_uv,
1674: #ifdef LIGHT_BACKLIGHT_USED
1675: 		vec3 backlight,
1676: #endif
1677: #ifdef LIGHT_RIM_USED
1678: 		float rim, float rim_tint,
1679: #endif
1680: #ifdef LIGHT_CLEARCOAT_USED
1681: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1682: #endif
1683: #ifdef LIGHT_ANISOTROPY_USED
1684: 		vec3 binormal, vec3 tangent, float anisotropy,
1685: #endif
1686: 		inout vec3 diffuse_light,
1687: 		inout vec3 specular_light) {
1688: 
1689: 	vec3 light_rel_vec = spot_lights[idx].position - vertex;
1690: 	float light_length = length(light_rel_vec);
1691: 	float spot_attenuation = get_omni_spot_attenuation(light_length, spot_lights[idx].inv_radius, spot_lights[idx].attenuation);
1692: 	vec3 spot_dir = spot_lights[idx].direction;
1693: 	float scos = max(dot(-normalize(light_rel_vec), spot_dir), spot_lights[idx].cone_angle);
1694: 	float spot_rim = max(0.0001, (1.0 - scos) / (1.0 - spot_lights[idx].cone_angle));
1695: 
1696: 	mediump float cone_attenuation = spot_lights[idx].cone_attenuation;
1697: 	spot_attenuation *= 1.0 - pow(spot_rim, cone_attenuation);
1698: 
1699: 	vec3 color = spot_lights[idx].color;
1700: 
1701: 	float size_A = 0.0;
1702: 
1703: 	if (spot_lights[idx].size > 0.0) {
1704: 		float t = spot_lights[idx].size / max(0.001, light_length);
1705: 		size_A = max(0.0, 1.0 - 1.0 / sqrt(1.0 + t * t));
1706: 	}
1707: 
1708: 	spot_attenuation *= shadow;
1709: 
1710: 	light_compute(normal, normalize(light_rel_vec), eye_vec, size_A, color, false, spot_attenuation, f0, roughness, metallic, spot_lights[idx].specular_amount, albedo, alpha, screen_uv,
1711: #ifdef LIGHT_BACKLIGHT_USED
1712: 			backlight,
1713: #endif
1714: #ifdef LIGHT_RIM_USED
1715: 			rim * spot_attenuation, rim_tint,
1716: #endif
1717: #ifdef LIGHT_CLEARCOAT_USED
1718: 			clearcoat, clearcoat_roughness, vertex_normal,
1719: #endif
1720: #ifdef LIGHT_ANISOTROPY_USED
1721: 			binormal, tangent, anisotropy,
1722: #endif
1723: 			diffuse_light, specular_light);
1724: }
1725: #endif // !defined(DISABLE_LIGHT_SPOT) || defined(ADDITIVE_SPOT)
1726: 
1727: #endif // !defined(DISABLE_LIGHT_DIRECTIONAL) || !defined(DISABLE_LIGHT_OMNI) || !defined(DISABLE_LIGHT_SPOT)
1728: #endif // !USE_VERTEX_LIGHTING
