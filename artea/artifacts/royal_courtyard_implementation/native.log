1727: vec4 fog_process(vec3 vertex) {
1728: 	vec3 fog_color = scene_data_block.data.fog_light_color;
1729: 
1730: #ifdef USE_RADIANCE_MAP
1731: /*
1732: 		if (scene_data_block.data.fog_aerial_perspective > 0.0) {
1733: 		vec3 sky_fog_color = vec3(0.0);
1734: 		vec3 cube_view = scene_data_block.data.radiance_inverse_xform * vertex;
1735: 		// mip_level always reads from the second mipmap and higher so the fog is always slightly blurred
1736: 		float mip_level = mix(1.0 / MAX_ROUGHNESS_LOD, 1.0, 1.0 - (abs(vertex.z) - scene_data_block.data.z_near) / (scene_data_block.data.z_far - scene_data_block.data.z_near));
1737: 
1738: 		sky_fog_color = textureLod(radiance_map, cube_view, mip_level * RADIANCE_MAX_LOD).rgb;
1739: 
1740: 		fog_color = mix(fog_color, sky_fog_color, scene_data_block.data.fog_aerial_perspective);
1741: 	}
1742: 	*/
1743: #endif
1744: 
1745: #ifdef USE_SUN_SCATTER
1746: 	vec4 sun_scatter = vec4(0.0);
1747: 	float sun_total = 0.0;
1748: 	vec3 view = normalize(vertex);
1749: 	for (uint i = uint(0); i < scene_data_block.data.directional_light_count; i++) {
1750: 		vec3 light_color = directional_lights[i].color * directional_lights[i].energy;
1751: 		float light_amount = pow(max(dot(view, directional_lights[i].direction), 0.0), 8.0);
1752: 		fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
1753: 	}
1754: 	for (uint i = uint(MAX_DIRECTIONAL_LIGHT_DATA_STRUCTS) - uint(scene_data_block.data.directional_shadow_count); i < uint(MAX_DIRECTIONAL_LIGHT_DATA_STRUCTS); i++) {
1755: 		vec3 light_color = directional_lights[i].color * directional_lights[i].energy;
1756: 		float light_amount = pow(max(dot(view, directional_lights[i].direction), 0.0), 8.0);
1757: 		fog_color += light_color * light_amount * scene_data_block.data.fog_sun_scatter;
1758: 	}
1759: #endif // USE_SUN_SCATTER
1760: 
1761: 	float fog_amount = 0.0;
1762: 
1763: #ifdef USE_DEPTH_FOG
1764: 	float fog_z = smoothstep(scene_data_block.data.fog_depth_begin, scene_data_block.data.fog_depth_end, length(vertex));
1765: 	fog_amount = pow(fog_z, scene_data_block.data.fog_depth_curve) * scene_data_block.data.fog_density;
1766: #else
1767: 	fog_amount = 1.0 - exp(min(0.0, -length(vertex) * scene_data_block.data.fog_density));
1768: #endif // USE_DEPTH_FOG
1769: 
1770: 	if (abs(scene_data_block.data.fog_height_density) >= 0.0001) {
1771: 		float y = (scene_data_block.data.inv_view_matrix * vec4(vertex, 1.0)).y;
1772: 
1773: 		float y_dist = y - scene_data_block.data.fog_height;
1774: 
1775: 		float vfog_amount = 1.0 - exp(min(0.0, y_dist * scene_data_block.data.fog_height_density));
1776: 
1777: 		fog_amount = max(vfog_amount, fog_amount);
1778: 	}
1779: 
1780: 	return vec4(fog_color, fog_amount);
1781: }
