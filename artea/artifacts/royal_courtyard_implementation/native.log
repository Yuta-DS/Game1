1735: 		// mip_level always reads from the second mipmap and higher so the fog is always slightly blurred
1736: 		float mip_level = mix(1.0 / MAX_ROUGHNESS_LOD, 1.0, 1.0 - (abs(vertex.z) - scene_data_block.data.z_near) / (scene_data_block.data.z_far - scene_data_block.data.z_near));
1737: 
1738: 		sky_fog_color = textureLod(radiance_map, cube_view, mip_level * RADIANCE_MAX_LOD).rgb;
1739: 
1740: 		fog_color = mix(fog_color, sky_fog_color, scene_data_block.data.fog_aerial_perspective);
