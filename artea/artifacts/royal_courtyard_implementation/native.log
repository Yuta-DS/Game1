1076: 		vec3 backlight,
1077: #endif
1078: #ifdef LIGHT_RIM_USED
1079: 		float rim, float rim_tint,
1080: #endif
1081: #ifdef LIGHT_CLEARCOAT_USED
1082: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1083: #endif
