1242: void light_process_omni(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 f0, float roughness, float metallic, float shadow, vec3 albedo, inout float alpha, vec2 screen_uv,
1243: #ifdef LIGHT_BACKLIGHT_USED
1244: 		vec3 backlight,
1245: #endif
1246: #ifdef LIGHT_RIM_USED
1247: 		float rim, float rim_tint,
1248: #endif
1249: #ifdef LIGHT_CLEARCOAT_USED
1250: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1251: #endif
1252: #ifdef LIGHT_ANISOTROPY_USED
1253: 		vec3 binormal, vec3 tangent, float anisotropy,
1254: #endif
1255: 		inout vec3 diffuse_light, inout vec3 specular_light) {
1256: 	vec3 light_rel_vec = omni_lights[idx].position - vertex;
1257: 	float light_length = length(light_rel_vec);
1258: 	float omni_attenuation = get_omni_spot_attenuation(light_length, omni_lights[idx].inv_radius, omni_lights[idx].attenuation);
1259: 	vec3 color = omni_lights[idx].color;
1260: 	float size_A = 0.0;
1261: 
1262: 	if (omni_lights[idx].size > 0.0) {
1263: 		float t = omni_lights[idx].size / max(0.001, light_length);
1264: 		size_A = max(0.0, 1.0 - 1.0 / sqrt(1.0 + t * t));
1265: 	}
1266: 
1267: 	omni_attenuation *= shadow;
1268: 
1269: 	light_compute(normal, normalize(light_rel_vec), eye_vec, size_A, color, false, omni_attenuation, f0, roughness, metallic, omni_lights[idx].specular_amount, albedo, alpha, screen_uv,
1270: #ifdef LIGHT_BACKLIGHT_USED
1271: 			backlight,
1272: #endif
1273: #ifdef LIGHT_RIM_USED
1274: 			rim * omni_attenuation, rim_tint,
1275: #endif
1276: #ifdef LIGHT_CLEARCOAT_USED
1277: 			clearcoat, clearcoat_roughness, vertex_normal,
1278: #endif
1279: #ifdef LIGHT_ANISOTROPY_USED
1280: 			binormal, tangent, anisotropy,
1281: #endif
1282: 			diffuse_light,
1283: 			specular_light);
1284: }
1285: #endif // !DISABLE_LIGHT_OMNI
