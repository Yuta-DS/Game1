106: vec3 tonemap_filmic(vec3 color) {
107: 	// These constants must match the those in the C++ code that calculates the parameters.
108: 	// exposure_bias: Input scale (color *= bias, env->white *= bias) to make the brightness consistent with other tonemappers.
109: 	// Also useful to scale the input to the range that the tonemapper is designed for (some require very high input values).
110: 	// Has no effect on the curve's general shape or visual properties.
111: 	const float exposure_bias = 2.0f;
112: 	const float A = 0.22f * exposure_bias * exposure_bias; // bias baked into constants for performance
113: 	const float B = 0.30f * exposure_bias;
114: 	const float C = 0.10f;
115: 	const float D = 0.20f;
116: 	const float E = 0.01f;
117: 	const float F = 0.30f;
118: 
119: 	vec3 color_tonemapped = ((color * (A * color + C * B) + D * E) / (color * (A * color + B) + D * F)) - E / F;
120: 
121: 	return color_tonemapped / tonemapper_params.x;
122: }
