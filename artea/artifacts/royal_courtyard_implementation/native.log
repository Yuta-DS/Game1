1284: // COPIED FROM servers\rendering\renderer_rd\shaders\area_lights_inc.glsl
1285: // Partially modified
1286: // Functions related to area lights
1287: #define M_PI 3.14159265359
1288: #define M_TAU 6.28318530718
1289: 
1290: float acos_approx(float p_x) {
1291: 	float x = abs(p_x);
1292: 	float res = -0.156583f * x + (M_PI / 2.0);
1293: 	res *= sqrt(1.0f - x);
1294: 	return (p_x >= 0.0) ? res : M_PI - res;
1295: }
1296: 
1297: vec3 integrate_edge_hill(vec3 p0, vec3 p1) {
1298: 	// Approximation suggested by Hill and Heitz, calculating the integral of the spherical cosine distribution over the line between p0 and p1.
1299: 	// Runs faster than the exact formula of Baum et al. (1989).
1300: 	float cosTheta = dot(p0, p1);
1301: 
1302: 	float x = cosTheta;
1303: 	float y = abs(x);
1304: 	float a = 5.42031 + (3.12829 + 0.0902326 * y) * y;
1305: 	float b = 3.45068 + (4.18814 + y) * y;
1306: 	float theta_sintheta = a / b;
1307: 
1308: 	if (x < 0.0) {
1309: 		theta_sintheta = M_PI * inversesqrt(1.0 - x * x) - theta_sintheta; // original paper: 0.5*inversesqrt(max(1.0 - x*x, 1e-7)) - theta_sintheta
1310: 	}
1311: 	return theta_sintheta * cross(p0, p1);
1312: }
1313: 
1314: float integrate_edge(vec3 p_proj0, vec3 p_proj1, vec3 p0, vec3 p1) {
1315: 	float epsilon = 0.00001;
1316: 	bool opposite_sides = dot(p_proj0, p_proj1) < -1.0 + epsilon;
1317: 	if (opposite_sides) {
1318: 		// calculate the point on the line p0 to p1 that is closest to the vertex (origin)
1319: 		vec3 half_point_t = p0 + normalize(p1 - p0) * dot(p0, normalize(p0 - p1));
1320: 		vec3 half_point = normalize(half_point_t);
1321: 		return integrate_edge_hill(p_proj0, half_point).y + integrate_edge_hill(half_point, p_proj1).y;
1322: 	}
1323: 	return integrate_edge_hill(p_proj0, p_proj1).y;
1324: }
1325: 
1326: // Form factor function for area light, taken from Urena, Fajardo, et.al. (2013): An Area-Preserving Parametrization for Spherical Rectangles
1327: float quad_solid_angle(vec3 L[4]) {
1328: 	// The solid angle of a spherical rectangle is the difference of the sum of its angles
1329: 	// and the sum of the angles of a plane rectangle (2*PI)
1330: 	vec3 c1 = cross(L[0], L[1]);
1331: 	vec3 c2 = cross(L[1], L[2]);
1332: 	vec3 c3 = cross(L[2], L[3]);
1333: 	vec3 c4 = cross(L[3], L[0]);
1334: 	vec3 n0 = normalize(c1);
1335: 	vec3 n1 = normalize(c2);
1336: 	vec3 n2 = normalize(c3);
1337: 	vec3 n3 = normalize(c4);
1338: 	float g0 = acos(clamp(dot(-n0, n1), -1.0, 1.0));
1339: 	float g1 = acos(clamp(dot(-n1, n2), -1.0, 1.0));
1340: 	float g2 = acos(clamp(dot(-n2, n3), -1.0, 1.0));
1341: 	float g3 = acos(clamp(dot(-n3, n0), -1.0, 1.0));
1342: 
1343: 	float angle_sum = g0 + g1 + g2 + g3;
1344: 
1345: 	return clamp(angle_sum - M_TAU, 0.0, M_TAU);
1346: }
1347: 
1348: void clip_quad_to_horizon(inout vec3 L[5], out int vertex_count) {
1349: 	// detect clipping config
1350: 	int config = 0;
1351: 	if (L[0].y > 0.0) {
1352: 		config += 1;
1353: 	}
1354: 	if (L[1].y > 0.0) {
1355: 		config += 2;
1356: 	}
1357: 	if (L[2].y > 0.0) {
1358: 		config += 4;
1359: 	}
1360: 	if (L[3].y > 0.0) {
1361: 		config += 8;
1362: 	}
1363: 
1364: 	// clip
1365: 	vertex_count = 0;
1366: 
1367: 	if (config == 0) {
1368: 		// clip all
1369: 	} else if (config == 1) { // V1 clip V2 V3 V4
1370: 		vertex_count = 3;
1371: 		L[1] = -L[1].y * L[0] + L[0].y * L[1];
1372: 		L[2] = -L[3].y * L[0] + L[0].y * L[3];
1373: 	} else if (config == 2) { // V2 clip V1 V3 V4
1374: 		vertex_count = 3;
1375: 		L[0] = -L[0].y * L[1] + L[1].y * L[0];
1376: 		L[2] = -L[2].y * L[1] + L[1].y * L[2];
1377: 	} else if (config == 3) { // V1 V2 clip V3 V4
1378: 		vertex_count = 4;
1379: 		L[2] = -L[2].y * L[1] + L[1].y * L[2];
1380: 		L[3] = -L[3].y * L[0] + L[0].y * L[3];
1381: 	} else if (config == 4) { // V3 clip V1 V2 V4
1382: 		vertex_count = 3;
1383: 		L[0] = -L[3].y * L[2] + L[2].y * L[3];
1384: 		L[1] = -L[1].y * L[2] + L[2].y * L[1];
1385: 	} else if (config == 5) { // V1 V3 clip V2 V4) impossible
1386: 		vertex_count = 0;
1387: 	} else if (config == 6) { // V2 V3 clip V1 V4
1388: 		vertex_count = 4;
1389: 		L[0] = -L[0].y * L[1] + L[1].y * L[0];
1390: 		L[3] = -L[3].y * L[2] + L[2].y * L[3];
1391: 	} else if (config == 7) { // V1 V2 V3 clip V4
1392: 		vertex_count = 5;
1393: 		L[4] = -L[3].y * L[0] + L[0].y * L[3];
1394: 		L[3] = -L[3].y * L[2] + L[2].y * L[3];
1395: 	} else if (config == 8) { // V4 clip V1 V2 V3
1396: 		vertex_count = 3;
1397: 		L[0] = -L[0].y * L[3] + L[3].y * L[0];
1398: 		L[1] = -L[2].y * L[3] + L[3].y * L[2];
1399: 		L[2] = L[3];
1400: 	} else if (config == 9) { // V1 V4 clip V2 V3
1401: 		vertex_count = 4;
1402: 		L[1] = -L[1].y * L[0] + L[0].y * L[1];
1403: 		L[2] = -L[2].y * L[3] + L[3].y * L[2];
1404: 	} else if (config == 10) { // V2 V4 clip V1 V3) impossible
1405: 		vertex_count = 0;
1406: 	} else if (config == 11) { // V1 V2 V4 clip V3
1407: 		vertex_count = 5;
1408: 		L[4] = L[3];
1409: 		L[3] = -L[2].y * L[3] + L[3].y * L[2];
1410: 		L[2] = -L[2].y * L[1] + L[1].y * L[2];
1411: 	} else if (config == 12) { // V3 V4 clip V1 V2
1412: 		vertex_count = 4;
1413: 		L[1] = -L[1].y * L[2] + L[2].y * L[1];
1414: 		L[0] = -L[0].y * L[3] + L[3].y * L[0];
1415: 	} else if (config == 13) { // V1 V3 V4 clip V2
1416: 		vertex_count = 5;
1417: 		L[4] = L[3];
1418: 		L[3] = L[2];
1419: 		L[2] = -L[1].y * L[2] + L[2].y * L[1];
1420: 		L[1] = -L[1].y * L[0] + L[0].y * L[1];
1421: 	} else if (config == 14) { // V2 V3 V4 clip V1
1422: 		vertex_count = 5;
1423: 		L[4] = -L[0].y * L[3] + L[3].y * L[0];
1424: 		L[0] = -L[0].y * L[1] + L[1].y * L[0];
1425: 	} else if (config == 15) { // V1 V2 V3 V4
1426: 		vertex_count = 4;
1427: 	}
1428: 
1429: 	if (vertex_count == 3) {
1430: 		L[3] = L[0];
1431: 	}
1432: 	if (vertex_count == 4) {
1433: 		L[4] = L[0];
1434: 	}
1435: }
1436: 
1437: float ltc_integrate_clipped_quad(vec3 L[5], vec3 L_proj[5], int vertices_above_horizon) {
1438: 	float I;
1439: 	I = integrate_edge(L_proj[0], L_proj[1], L[0], L[1]);
1440: 	I += integrate_edge(L_proj[1], L_proj[2], L[1], L[2]);
1441: 	I += integrate_edge(L_proj[2], L_proj[3], L[2], L[3]);
1442: 	if (vertices_above_horizon >= 4) {
1443: 		I += integrate_edge(L_proj[3], L_proj[4], L[3], L[4]);
1444: 	}
1445: 	if (vertices_above_horizon == 5) {
1446: 		I += integrate_edge(L_proj[4], L_proj[0], L[4], L[0]);
1447: 	}
1448: 	return abs(I);
1449: }
1450: 
1451: void ltc_evaluate(vec3 normal, vec3 eye_vec, mat3 M_inv, vec3 points[4], out float integral) {
1452: 	// construct the orthonormal basis around the normal vector
1453: 	vec3 x, z;
1454: 	z = -normalize(eye_vec - normal * dot(eye_vec, normal)); // expanding the angle between view and normal vector to 90 degrees, this gives a normal vector
1455: 	x = cross(normal, z);
1456: 
1457: 	// rotate area light in (T1, normal, T2) basis
1458: 	M_inv = M_inv * transpose(mat3(x, normal, z));
1459: 
1460: 	vec3 L[5];
1461: 	L[0] = M_inv * points[0];
1462: 	L[1] = M_inv * points[1];
1463: 	L[2] = M_inv * points[2];
1464: 	L[3] = M_inv * points[3];
1465: 
1466: 	vec3 L_unclipped[4];
1467: 	L_unclipped[0] = L[0];
1468: 	L_unclipped[1] = L[1];
1469: 	L_unclipped[2] = L[2];
1470: 	L_unclipped[3] = L[3];
1471: 
1472: 	int n;
1473: 	clip_quad_to_horizon(L, n);
1474: 	if (n == 0) {
1475: 		integral = 0.0;
1476: 		return;
1477: 	}
1478: 
1479: 	// project onto unit sphere
1480: 	vec3 L_proj[5];
1481: 	L_proj[0] = normalize(L[0]);
1482: 	L_proj[1] = normalize(L[1]);
1483: 	L_proj[2] = normalize(L[2]);
1484: 	L_proj[3] = normalize(L[3]);
1485: 	L_proj[4] = normalize(L[4]);
1486: 
1487: 	// Prevent abnormal values when the light goes through (or close to) the fragment
1488: 	vec3 pnorm = normalize(cross(L_proj[0] - L_proj[1], L_proj[2] - L_proj[1]));
1489: 	if (abs(dot(pnorm, L_proj[0])) < 1e-10) {
1490: 		// we could just return black, but that would lead to some black pixels in front of the light.
1491: 		// Better, we check if the fragment is on the light, and return white if so.
1492: 		vec3 r10 = points[0] - points[1];
1493: 		vec3 r12 = points[2] - points[1];
1494: 		float alpha = -dot(points[1], r10) / dot(r10, r10);
1495: 		float beta = -dot(points[1], r12) / dot(r12, r12);
1496: 		if (0.0 < alpha && alpha < 1.0 && 0.0 < beta && beta < 1.0) { // fragment is on light {
1497: 			integral = 1.0;
1498: 			return;
1499: 		} else {
1500: 			integral = 0.0;
1501: 			return;
1502: 		}
1503: 	}
1504: 
1505: 	float I = ltc_integrate_clipped_quad(L, L_proj, n);
1506: 	integral = I / (2.0 * M_PI);
1507: }
1508: 
1509: void ltc_evaluate_specular(vec3 normal, vec3 eye_vec, float roughness, vec3 points[4], sampler2D ltc_lut1, sampler2D ltc_lut2, out float ltc_specular, out vec2 fresnel) {
1510: 	float theta = acos_approx(dot(normal, eye_vec));
1511: 	const float LTC_LUT_SIZE = float(64.0);
1512: 	vec2 lut_pos = vec2(max(roughness, float(0.02)), theta / float(0.5 * M_PI));
1513: 	vec2 lut_uv = vec2(lut_pos * (float(63.0) / LTC_LUT_SIZE) + vec2(float(0.5) / LTC_LUT_SIZE)); // offset by 1 pixel
1514: 	vec4 M_brdf_abcd = texture(ltc_lut1, lut_uv);
1515: 	vec3 M_brdf_e_mag_fres = texture(ltc_lut2, lut_uv).xyz;
1516: 	float scale = 1.0 / (M_brdf_abcd.x * M_brdf_e_mag_fres.x - M_brdf_abcd.y * M_brdf_abcd.w);
1517: 
1518: 	mat3 M_inv = mat3(
1519: 			vec3(0, 0, 1.0 / M_brdf_abcd.z),
1520: 			vec3(-M_brdf_abcd.w * scale, M_brdf_abcd.x * scale, 0),
1521: 			vec3(-M_brdf_e_mag_fres.x * scale, M_brdf_abcd.y * scale, 0));
1522: 
1523: 	ltc_evaluate(normal, eye_vec, M_inv, points, ltc_specular);
1524: 	fresnel = vec2(M_brdf_e_mag_fres.yz);
1525: }
1526: 
1527: // implementation of area lights with Linearly Transformed Cosines (LTC): https://eheitzresearch.wordpress.com/415-2/
1528: void light_process_area(uint idx, vec3 vertex, vec3 eye_vec, vec3 normal, vec3 f0, float roughness, float metallic, float shadow, vec3 albedo, inout float alpha, vec2 screen_uv,
1529: #ifdef LIGHT_BACKLIGHT_USED
1530: 		vec3 backlight,
1531: #endif
1532: #ifdef LIGHT_RIM_USED
1533: 		float rim, float rim_tint,
1534: #endif
1535: #ifdef LIGHT_CLEARCOAT_USED
1536: 		float clearcoat, float clearcoat_roughness, vec3 vertex_normal,
1537: #endif
1538: #ifdef LIGHT_ANISOTROPY_USED
1539: 		vec3 binormal, vec3 tangent, float anisotropy,
1540: #endif
1541: 		inout vec3 diffuse_light, inout vec3 specular_light) {
1542: 	float EPSILON = 1e-7f;
1543: 	vec3 area_width = area_lights[idx].area_width.xyz;
1544: 	vec3 area_height = area_lights[idx].area_height.xyz;
1545: 	vec3 area_direction = area_lights[idx].direction;
1546: 
1547: 	if (dot(area_width, area_width) < EPSILON || dot(area_height, area_height) < EPSILON) { // area is 0
1548: 		return;
1549: 	}
1550: 	if (dot(area_direction, vertex - area_lights[idx].position) <= 0.0) {
1551: 		return; // vertex is behind light
1552: 	}
1553: 
1554: 	float a_len = length(area_width);
1555: 	float b_len = length(area_height);
1556: 	float a_half_len = a_len / 2.0;
1557: 	float b_half_len = b_len / 2.0;
1558: 	vec3 light_center = area_lights[idx].position;
1559: 	vec3 light_to_vert = vertex - light_center;
1560: 	vec3 pos_local_to_light = vec3(dot(light_to_vert, normalize(area_width)), dot(light_to_vert, normalize(area_height)), dot(light_to_vert, -area_direction));
1561: 
1562: 	vec3 closest_point_local_to_light = vec3(clamp(pos_local_to_light.x, -a_half_len, a_half_len), clamp(pos_local_to_light.y, -b_half_len, b_half_len), 0);
1563: 	float dist = length(closest_point_local_to_light - pos_local_to_light);
1564: 
1565: 	vec3 points[4];
1566: 	vec3 h_area_width = area_width / 2.0;
1567: 	vec3 h_area_height = area_height / 2.0;
1568: 	points[0] = area_lights[idx].position - h_area_width - h_area_height - vertex;
1569: 	points[1] = area_lights[idx].position + h_area_width - h_area_height - vertex;
1570: 	points[2] = area_lights[idx].position + h_area_width + h_area_height - vertex;
1571: 	points[3] = area_lights[idx].position - h_area_width + h_area_height - vertex;
1572: 
1573: 	float ltc_diffuse = 0.0;
1574: 	float ltc_specular = 0.0;
1575: 	vec2 ltc_fresnel = vec2(0.0);
1576: 	ltc_evaluate(normal, eye_vec, mat3(1), points, ltc_diffuse);
1577: 	ltc_evaluate_specular(normal, eye_vec, roughness, points, ltc_lut1, ltc_lut2, ltc_specular, ltc_fresnel);
1578: 
1579: 	float f90 = clamp(dot(f0, vec3(50.0 * 0.33)), metallic, 1.0);
1580: 	vec3 fresnel_color = f0 * max(ltc_fresnel.x, 0.0) + (f90 - f0) * max(ltc_fresnel.y, 0.0);
1581: 
1582: 	float light_length = max(0.0, dist);
1583: 	float light_attenuation_raw = get_omni_spot_attenuation(light_length, area_lights[idx].inv_radius, area_lights[idx].attenuation);
1584: 	float light_attenuation_ltc = light_attenuation_raw * light_length * light_length; // solid angle already decreases by inverse square, so attenuation power is 2.0 by default -> subtract 2.0
1585: 
1586: 	vec3 light_color = area_lights[idx].color;
1587: 	light_attenuation_ltc = light_attenuation_ltc * shadow;
1588: 	float light_attenuation = light_attenuation_raw * shadow;
1589: 	float specular_amount = area_lights[idx].specular_amount;
1590: 
1591: #if defined(LIGHT_CODE_USED) && defined(AREA_LIGHT_CODE_USED)
1592: 	// light is written by the light shader
1593: 
1594: 	highp mat4 model_matrix = world_transform;
1595: 	mat4 projection_matrix = scene_data_block.data.projection_matrix;
1596: 	mat4 inv_projection_matrix = scene_data_block.data.inv_projection_matrix;
1597: 
1598: 	vec3 light = (light_center - vertex) / light_length;
1599: 	vec3 view = eye_vec;
1600: 
1601: 	bool is_area = true;
1602: 	vec3 area_diffuse = vec3(ltc_diffuse);
1603: 	vec3 area_specular = ltc_specular * fresnel_color;
1604: 	float attenuation = light_attenuation_ltc;
1605: 
1606: 	/* clang-format off */
1607: 
1608: 
1609: 	/* clang-format on */
1610: 
1611: #else
1612: 	float area = a_len * b_len;
1613: 	float cc_attenuation = 1.0;
1614: 
1615: #if defined(LIGHT_BACKLIGHT_USED) || defined(LIGHT_RIM_USED) || defined(DIFFUSE_TOON) || defined(SPECULAR_TOON)
1616: 	float solid_angle = quad_solid_angle(points);
1617: #endif
1618: 
1619: #if defined(LIGHT_CLEARCOAT_USED)
1620: 	float cc_specular_ltc = 0.0;
1621: 	vec2 cc_fresnel = vec2(0.0);
1622: 	ltc_evaluate_specular(vertex_normal, eye_vec, sqrt(mix(0.001, 0.1, float(clearcoat_roughness))), points, ltc_lut1, ltc_lut2, cc_specular_ltc, cc_fresnel);
1623: 	float Fr = (0.04 * max(cc_fresnel.x, 0.0) + (1.0 - 0.04) * max(cc_fresnel.y, 0.0)) * clearcoat;
1624: 	cc_attenuation = 1.0 - Fr;
1625: 	specular_light += cc_specular_ltc * Fr * light_color * light_attenuation_ltc * specular_amount;
1626: #endif // LIGHT_CLEARCOAT_USED
1627: 
1628: 	if (metallic < 1.0) {
1629: #if defined(DIFFUSE_TOON)
1630: 		float backface_ltc_diffuse = 0.0;
1631: 		ltc_evaluate(vec3(-normal), vec3(eye_vec), mat3(1), points, backface_ltc_diffuse);
1632: 		float NdotL = (ltc_diffuse - backface_ltc_diffuse) / (max(solid_angle, 0.001) / M_PI);
1633: 		float diffuse_brdf_NL = smoothstep(-roughness, max(roughness, 0.01), NdotL) * (1.0 / M_PI);
1634: 		diffuse_light += diffuse_brdf_NL * light_color * area * light_attenuation * cc_attenuation;
1635: #else
1636: 		diffuse_light += ltc_diffuse * light_color * light_attenuation_ltc * cc_attenuation;
1637: #endif // DIFFUSE_TOON
1638: 
1639: #if defined(LIGHT_BACKLIGHT_USED)
1640: 		diffuse_light += light_color * max((solid_angle / M_PI) - ltc_diffuse, 0.0) * backlight * light_attenuation_ltc;
1641: #endif
1642: 	}
1643: 
1644: #if defined(LIGHT_RIM_USED) // same as for point lights
1645: 	float cNdotV = max(dot(normal, eye_vec), 1e-4);
1646: 	float rim_light = pow(max(1e-4, 1.0 - cNdotV), max(0.0, (1.0 - roughness) * 16.0));
1647: 	diffuse_light += rim_light * rim * mix(vec3(1.0), albedo, rim_tint) * light_color * solid_angle * light_attenuation_ltc;
1648: #endif
1649: 
1650: #if defined(SPECULAR_TOON)
1651: 	// If ltc_specular turns out to be not similar enough to RdotV, since its based on GGX, toon shading would need its own lookup-table.
1652: 	float mid = 1.0 - roughness;
1653: 	mid *= mid;
1654: 
1655: 	float RdotV = ltc_specular / (max(solid_angle, 0.001) / (M_PI));
1656: 	float intensity = smoothstep(mid - roughness * 0.5, mid + roughness * 0.5, RdotV) * mid; // should we use specular tex color here?? or diffuse? or white?
1657: 	diffuse_light += intensity * light_color * area * light_attenuation * specular_amount; // write to diffuse_light, as in toon shading you generally want no reflection
1658: #elif defined(SPECULAR_DISABLED)
1659: 	// do nothing
1660: #else
1661: 	vec3 spec = ltc_specular * light_color * fresnel_color;
1662: 	specular_light += spec * specular_amount * light_attenuation_ltc * cc_attenuation;
1663: #endif // SPECULAR_TOON
1664: #endif // LIGHT_CODE_USED
1665: }
1666: #endif // !DISABLE_LIGHT_AREA
