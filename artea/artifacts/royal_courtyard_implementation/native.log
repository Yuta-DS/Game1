1069: float V_Kelemen(float LdotH) {
1070: 	// Kelemen 2001, "A Microfacet Based Coupled Specular-Matte BRDF Model with Importance Sampling"
1071: 	return 0.25 / (LdotH * LdotH + 1e-4);
1072: }
