752: #if !defined(ADDITIVE_OMNI)
753: float sample_shadow(highp sampler2DShadow shadow, float shadow_pixel_size, vec4 pos) {
754: 	// Use textureProjLod with LOD set to 0.0 over textureProj, as textureProj not working correctly on ANGLE with Metal backend.
755: 	// https://github.com/godotengine/godot/issues/93537
756: 	float avg = textureProjLod(shadow, pos, 0.0);
757: #ifdef SHADOW_MODE_PCF_13
758: 	pos /= pos.w;
759: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size * 2.0, 0.0), pos.zw), 0.0);
760: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size * 2.0, 0.0), pos.zw), 0.0);
761: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, shadow_pixel_size * 2.0), pos.zw), 0.0);
762: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, -shadow_pixel_size * 2.0), pos.zw), 0.0);
763: 
764: 	// Early bail if distant samples are fully shaded (or none are shaded) to improve performance.
765: 	if (avg <= 0.000001) {
766: 		// None shaded at all.
767: 		return 0.0;
768: 	} else if (avg >= 4.999999) {
769: 		// All fully shaded.
770: 		return 1.0;
771: 	}
772: 
773: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, 0.0), pos.zw), 0.0);
774: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, 0.0), pos.zw), 0.0);
775: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, shadow_pixel_size), pos.zw), 0.0);
776: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, -shadow_pixel_size), pos.zw), 0.0);
777: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, shadow_pixel_size), pos.zw), 0.0);
778: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, shadow_pixel_size), pos.zw), 0.0);
779: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, -shadow_pixel_size), pos.zw), 0.0);
780: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, -shadow_pixel_size), pos.zw), 0.0);
781: 	return avg * (1.0 / 13.0);
782: #endif
783: 
784: #ifdef SHADOW_MODE_PCF_5
785: 	pos /= pos.w;
786: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(shadow_pixel_size, 0.0), pos.zw), 0.0);
787: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(-shadow_pixel_size, 0.0), pos.zw), 0.0);
788: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, shadow_pixel_size), pos.zw), 0.0);
789: 	avg += textureProjLod(shadow, vec4(pos.xy + vec2(0.0, -shadow_pixel_size), pos.zw), 0.0);
790: 	return avg * (1.0 / 5.0);
791: 
792: #endif
793: 
794: 	return avg;
795: }
