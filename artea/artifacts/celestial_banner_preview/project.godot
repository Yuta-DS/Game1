config_version=5

[application]
config/name="Crown Line — Celestial Banner Preview"
run/main_scene="res://web_preview.tscn"

[display]
window/size/viewport_width=1710
window/size/viewport_height=1112
window/size/window_width_override=1280
window/size/window_height_override=880
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05, 0.09, 0.16, 1)
