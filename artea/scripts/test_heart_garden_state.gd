extends SceneTree

const State := preload("res://scripts/heart_melody/heart_garden_state.gd")

func _init() -> void:
	var path := "user://test_heart_%d.json" % Time.get_ticks_usec()
	var s := State.new(path)
	assert(not s.confirm_phrase().accepted)
	assert(not s.record_defeat("garden.moth.1").accepted)
	for i in 3:
		assert(s.plant(i, "sound").accepted)
	assert(s.planted_count() == 3 and s.xp() == 0)
	assert(s.enter_note("leaf").accepted)
	assert(s.enter_note("droplet").accepted)
	assert(s.enter_note("sun").accepted)
	assert(not s.confirm_phrase().accepted)
	assert(s.data.phrase.size() == 3, "mismatch preserves the player's work")
	assert(s.revise().accepted)
	assert(s.revise().accepted)
	assert(s.enter_note("sun").accepted)
	var loaded := State.new(path)
	assert(loaded.load_progress() and loaded.data.phrase == ["leaf", "sun"])
	assert(loaded.enter_note("droplet").accepted)
	assert(loaded.confirm_phrase().accepted)
	assert(not loaded.finish_wave(["garden.moth.1"]).accepted)
	assert(loaded.record_defeat("garden.moth.1").accepted)
	assert(loaded.record_defeat("garden.moth.1").accepted and loaded.xp() == 12)
	assert(loaded.finish_wave(["garden.moth.1"]).accepted)
	assert(loaded.record_defeat("garden.moth.2").accepted)
	assert(loaded.record_defeat("garden.slime.1").accepted)
	assert(loaded.finish_wave(["garden.moth.2", "garden.slime.1"]).accepted)
	assert(loaded.complete() and loaded.xp() == 119)
	assert(not loaded.finish_wave([]).accepted and loaded.xp() == 119)
	assert(loaded.plant(0, "hope").accepted and loaded.complete())
	assert(State.valid(loaded.data))
	var invalid := loaded.data.duplicate(true)
	invalid.rhythm_solved = false
	assert(not State.valid(invalid))
	var restored := State.new(path)
	assert(restored.load_progress() and restored.complete() and restored.xp() == 119)
	var broken := FileAccess.open(path, FileAccess.WRITE)
	broken.store_string("broken")
	broken.close()
	assert(restored.load_progress() and restored.complete(), "valid backup recovers corruption")
	var failing := State.new("user://missing_heart_directory/sub/save.json")
	assert(not failing.plant(0, "hope").accepted and failing.planted_count() == 0)
	for suffix in ["", ".bak", ".tmp"]:
		if FileAccess.file_exists(path + suffix): DirAccess.remove_absolute(path + suffix)
	print("HEART_GARDEN_STATE: PASS — revision, partial reload, receipts, completion, backup and write failure")
	quit()
