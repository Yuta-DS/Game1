[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogue/HubworldDialogue.dialogue", "res://assets/dialogue/main.dialogue", "res://dialogue/main.dialogue")

[layer_names]

3d_physics/layer_2="Grass"
3d_physics/layer_3="Sand"
3d_physics/layer_4="Cuttable"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/screen_space_aa=1

[shader_globals]

wind_direction={
"type": "vec3",
"value": Vector3(3, 3, 0)
}
player_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
wind_intensity={
"type": "float",
"value": 0.0
}
diffuse_curve={
"type": "sampler2D",
"value": ""
}
specular_smoothness={
"type": "float",
"value": 0.05
}
fresnel_smoothness={
"type": "float",
"value": 0.05
}
outline_width={
"type": "float",
"value": 4.0
}
outline_color={
"type": "color",
"value": Color(0, 0, 0, 1)
}
