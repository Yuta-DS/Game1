; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[importer_defaults]

texture={
"compress/mode": 2,
"compress/high_quality": false,
"compress/lossy_quality": 0.7,
"compress/hdr_compression": 1,
"compress/normal_map": 0,
"compress/channel_pack": 0,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"roughness/mode": 0,
"process/fix_alpha_border": true,
"process/premult_alpha": false,
"process/normal_map_invert_y": false,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/size_limit": 0,
"detect_3d/compress_to": 1
}

[application]

config/name="Artea"
run/main_scene="res://scenes/start_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
run/main_scene.crown_story="res://scenes/viewfinder/crown_of_life_story.tscn"

[artea]

debug/show_island_state_panel=false

[audio]

general/text_to_speech=true
general/2d_panning_strength=1.0
general/3d_panning_strength=1.0

[autoload]

Firebase="*res://addons/godot-firebase/firebase/firebase.tscn"
MusicManager="*res://scenes/music_manager.tscn"
Global="*res://scripts/Global.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GameManager="*res://scripts/GameManager.gd"
JourneyState="*res://scripts/JourneyState.gd"
JourneyCampaign="*res://scripts/journey_campaign.gd"
MiloCompanionManager="*res://scripts/MiloCompanionManager.gd"
PlayerIdentityTracker="*res://scripts/player_identity_tracker.gd"
WorldOneProgression="*res://scripts/world_one_progression.gd"
Auth="*res://addons/godot-firebase/auth/auth.gd"
APIManager="*res://scripts/API_Manager.gd"
CreationWorldState="*res://scripts/creation_world/creation_world_state.gd"
WorldSpatialAudio="*res://scripts/world_spatial_audio.gd"

[dialogue_manager]

runtime/balloon_path="res://dialogue/HubworldBalloon.tscn"

[display]

window/size/viewport_width=1710
window/size/viewport_height=1112
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/godot-firebase/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/design_supervisor/plugin.cfg")

[filesystem]

import/blender/enabled=false

