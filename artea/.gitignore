# Godot 4+ specific ignores
.godot/
/android/
.vercel

# Generated per-environment public Firebase identifiers (not private credentials).
/data/firebase_client_config.json

# Godot leaves these behind when an import is interrupted
*.png.import-*

# Blender autosave backups
*.blend1

# Scene saves that were interrupted leave these behind
*.tscn[0-9]*.tmp
