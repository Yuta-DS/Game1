[gd_scene load_steps=2 format=3 uid="uid://sv4s22ki8dww"]

[sub_resource type="GDScript" id="GDScript_1wjt0"]
resource_name = "chatbot"
script/source = "extends VBoxContainer

@onready var chat_history = $ChatHistory
@onready var user_input = $HBoxContainer/UserInput
@onready var send_button = $HBoxContainer/SendButton
@onready var http_request = $HTTPRequestChatGPT

var openai_api_key = \"YOUR_API_KEY_HERE\" # Replace with your real API key

func _ready():
	send_button.connect(\"pressed\", self, \"_on_send_button_pressed\")
	user_input.connect(\"text_submitted\", self, \"_on_send_button_pressed\")
	http_request.connect(\"request_completed\", self, \"_on_http_request_completed\")

func _on_send_button_pressed():
	var message = user_input.text.strip_edges()
	if message != \"\":
		append_to_chat(\"You: \" + message)
		send_message_to_chatgpt(message)
		user_input.text = \"\"

func append_to_chat(text: String):
	chat_history.text += text + \"\\n\\n\"
	chat_history.scroll_vertical = chat_history.get_line_count()

func send_message_to_chatgpt(user_message: String) -> void:
	var url = \"https://api.openai.com/v1/chat/completions\"
	
	var headers = [
		\"Content-Type: application/json\",
		\"Authorization: Bearer \" + openai_api_key
	]
	
	var body = {
		\"model\": \"gpt-3.5-turbo\",
		\"messages\": [
			{\"role\": \"system\", \"content\": \"You are a helpful and friendly chatbot.\"},
			{\"role\": \"user\", \"content\": user_message}
		]
	}
	
	var body_json = JSON.stringify(body)
	
	var error = http_request.request(
		url,
		headers,
		HTTPClient.METHOD_POST,
		body_json
	)
	
	if error != OK:
		append_to_chat(\"Error sending message!\")

func _on_http_request_completed(result, response_code, headers, body):
	if response_code == 200:
		var response = JSON.parse_string(body.get_string_from_utf8())
		if response:
			var reply_text = response[\"choices\"][0][\"message\"][\"content\"]
			append_to_chat(\"ChatGPT: \" + reply_text.strip_edges())
	else:
		append_to_chat(\"Error: Server returned code \" + str(response_code))
"

