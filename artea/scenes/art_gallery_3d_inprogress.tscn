[node name="Player3D" parent="." unique_id=1983107366 groups=["Player"] instance=ExtResource("2_3gi0n")]
; The player spawned rotated 180 degrees (-1 on X and Z), facing +z. The galaxy
; world is built at z=-480, directly behind that, and the camera follows the
; player's back - so the gallery opened looking away from the world and it
; appeared to be missing entirely. Facing -z puts the world in front on spawn.
;
; Spawn is also moved back from z=12 to z=26: the follow camera sits 7 m behind
; the player, which at z=12 put it inside the gallery's rear wall.
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.2, 26)
camera_path = NodePath("../Camera3D")

